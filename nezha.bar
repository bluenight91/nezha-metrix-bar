<bar protocol-version="0"
     min-app-version="0.3.0"
     widget="true"
     notch="true"
     keep-alive="true"
     category="monitoring"
     version="2.1.1"
     icon="data:image/svg+xml;base64,"
     description="Monitor Nezha servers, service probes, cycle traffic, and live alerts from your menu bar, notch, and desktop widgets."
     license="AGPL-3.0-only"
     homepage="https://nezha.wiki/"
     id="nezha"
     title="Nezha"
     refresh="5s"
     material="solid"
     window-style="standard">

  <locale lang="zh-Hans"
          title="哪吒监控"
          description="在菜单栏、刘海屏和桌面小组件实时监控哪吒 V2 服务器、服务探测、周期流量与告警流。" />
  <locale lang="zh-Hant"
          title="哪吒監控"
          description="在選單列、瀏海屏與桌面小工具即時監控哪吒 V2 伺服器、服務探測、週期流量與告警流。" />

  <permissions>
    <network origin="{{ inputs.baseURL }}" from-url="true" />
    <inbox access="manage" />
  </permissions>

  <inputs>
    <input name="baseURL" type="string" label="Nezha Dashboard URL" placeholder="https://nezha.example.com" required="true"
           help="URL of your Nezha Dashboard (e.g. https://mon.example.com). Paths or trailing slashes are normalized automatically.">
      <locale lang="zh-Hans" label="哪吒 Dashboard 地址" help="你的哪吒监控 Dashboard 地址，例如 https://mon.example.com。末尾斜杠或子路径会自动规范化。" />
      <locale lang="zh-Hant" label="哪吒 Dashboard 位址" help="你的哪吒監控 Dashboard 位址，例如 https://mon.example.com。結尾斜線或子路徑會自動正規化。" />
    </input>
    <input name="apiToken" type="secret" label="API Token (PAT)"
           help="Optional. Personal Access Token (nzp_…). Recommended scopes: nezha:inventory:read, nezha:server:read, nezha:service:read, and optionally nezha:alertrule:read. Required when force_auth is enabled.">
      <locale lang="zh-Hans" label="API Token（PAT）" help="可选。个人访问令牌（nzp_…）。建议权限：nezha:inventory:read、nezha:server:read、nezha:service:read，可选 nezha:alertrule:read。站点启用 force_auth 时必填。" />
      <locale lang="zh-Hant" label="API Token（PAT）" help="選填。個人存取權杖（nzp_…）。建議權限：nezha:inventory:read、nezha:server:read、nezha:service:read，選填 nezha:alertrule:read。站點啟用 force_auth 時必填。" />
    </input>
    <input name="refreshInterval" type="select" label="Refresh Interval" default="5">
      <locale lang="zh-Hans" label="刷新间隔" />
      <locale lang="zh-Hant" label="重新整理間隔" />
      <option value="2" label="2s"><locale lang="zh-Hans" label="2 秒" /><locale lang="zh-Hant" label="2 秒" /></option>
      <option value="5" label="5s"><locale lang="zh-Hans" label="5 秒" /><locale lang="zh-Hant" label="5 秒" /></option>
      <option value="10" label="10s"><locale lang="zh-Hans" label="10 秒" /><locale lang="zh-Hant" label="10 秒" /></option>
      <option value="30" label="30s"><locale lang="zh-Hans" label="30 秒" /><locale lang="zh-Hant" label="30 秒" /></option>
      <option value="60" label="60s"><locale lang="zh-Hans" label="60 秒" /><locale lang="zh-Hant" label="60 秒" /></option>
    </input>
    <input name="liveUpdates" type="bool" label="Live WebSocket (Guest Mode)" default="true"
           help="Use WebSocket for guest-accessible sites, with a REST reconciliation every 30s. Disable for REST-only polling. PAT mode always uses REST.">
      <locale lang="zh-Hans" label="实时 WebSocket（游客模式）" help="游客可访问的站点使用 WebSocket，并每 30 秒通过 REST 对账。关闭后仅使用 REST 轮询；PAT 模式始终使用 REST。" />
      <locale lang="zh-Hant" label="即時 WebSocket（訪客模式）" help="訪客可存取的站點使用 WebSocket，並每 30 秒透過 REST 對帳。關閉後僅使用 REST 輪詢；PAT 模式始終使用 REST。" />
    </input>
    <input name="trayFormat" type="select" label="Tray Display" default="online_total">
      <locale lang="zh-Hans" label="菜单栏显示格式" />
      <locale lang="zh-Hant" label="選單列顯示格式" />
      <option value="online_total" label="8/10 · 1.1M/s" />
      <option value="total" label="1.1M/s" />
      <option value="online_both" label="8/10 · ↑Up ↓Down"><locale lang="zh-Hans" label="8/10 · ↑上行 ↓下行" /><locale lang="zh-Hant" label="8/10 · ↑上行 ↓下行" /></option>
      <option value="online" label="8/10" />
      <option value="stacked_rate" label="Stacked ↑↓ Rate (macOS)"><locale lang="zh-Hans" label="双行紧凑速率（macOS）" /><locale lang="zh-Hant" label="雙行精簡速率（macOS）" /></option>
      <option value="rate_spark" label="Rate + Sparkline (macOS)"><locale lang="zh-Hans" label="双行速率 + 迷你流量图（macOS）" /><locale lang="zh-Hant" label="雙行速率 + 迷你流量圖（macOS）" /></option>
      <option value="cpu_spark" label="CPU + Sparkline (macOS)"><locale lang="zh-Hans" label="集群 CPU + 迷你趋势图（macOS）" /><locale lang="zh-Hant" label="叢集 CPU + 迷你趨勢圖（macOS）" /></option>
    </input>
    <input name="showTrayIcon" type="bool" label="Show Menu Bar Logo" default="true"
           help="Show or hide the Nezha logo in the menu bar. Applies to both text and rich macOS tray styles.">
      <locale lang="zh-Hans" label="菜单栏显示 Logo" help="在菜单栏中显示或隐藏哪吒图标，同时适用于普通文本和 macOS 富渲染模式。" />
      <locale lang="zh-Hant" label="選單列顯示 Logo" help="在選單列中顯示或隱藏哪吒圖示，同時適用於純文字與 macOS 富渲染模式。" />
    </input>
    <input name="notchMetric" type="select" label="Notch Compact Metric" default="rate"
           help="Metric shown on the right wing of the notch (Metrix.Bar Plus on macOS / Windows).">
      <locale lang="zh-Hans" label="刘海屏紧凑指标" help="刘海屏右侧翼显示的紧凑数值（需 Metrix.Bar Plus，支持 macOS / Windows）。" />
      <locale lang="zh-Hant" label="瀏海屏精簡指標" help="瀏海屏右側翼顯示的精簡數值（需 Metrix.Bar Plus，支援 macOS / Windows）。" />
      <option value="rate" label="Aggregate Rate (340K)"><locale lang="zh-Hans" label="聚合网速（如 340K）" /><locale lang="zh-Hant" label="彙總網速（如 340K）" /></option>
      <option value="stacked_rate" label="Stacked ↑↓ Rate"><locale lang="zh-Hans" label="双行上下行速率（↑上行 / ↓下行）" /><locale lang="zh-Hant" label="雙行上下行速率（↑上行 / ↓下行）" /></option>
      <option value="down" label="Download Rate (↓188K)"><locale lang="zh-Hans" label="下行速率（如 ↓188K）" /><locale lang="zh-Hant" label="下行速率（如 ↓188K）" /></option>
      <option value="up" label="Upload Rate (↑170K)"><locale lang="zh-Hans" label="上行速率（如 ↑170K）" /><locale lang="zh-Hant" label="上行速率（如 ↑170K）" /></option>
      <option value="cpu" label="Average CPU (18%)"><locale lang="zh-Hans" label="平均 CPU（如 18%）" /><locale lang="zh-Hant" label="平均 CPU（如 18%）" /></option>
      <option value="online" label="Online Count (21/21)"><locale lang="zh-Hans" label="在线数（如 21/21）" /><locale lang="zh-Hant" label="在線數（如 21/21）" /></option>
    </input>
    <input name="notchActivity" type="bool" label="Notch Alert Island" default="true"
           help="Temporarily bring Nezha into the notch island when a server goes offline, a probe fails, cycle traffic crosses a threshold, or an Inbox alert arrives. Enable 'Allow automatic notch expansion' in Display Settings to briefly auto-expand on critical alerts.">
      <locale lang="zh-Hans" label="刘海屏告警动态岛" help="节点离线、探针异常、周期流量超限或收到 Inbox Webhook/邮件告警时，在刘海屏限时高亮提醒；在显示设置中开启「允许自动展开刘海屏」后，严重告警还会自动短时展开详情。" />
      <locale lang="zh-Hant" label="瀏海屏告警動態島" help="節點離線、探針異常、週期流量超限或收到 Inbox Webhook/郵件告警時，在瀏海屏限時高亮提醒；在顯示設定中開啟「允許自動展開瀏海屏」後，嚴重告警還會自動短時展開詳情。" />
    </input>
    <input name="serverView" type="select" label="Server List Layout" default="auto"
           help="Choose cards, compact sortable table, or automatic (cards in compact flyout, sortable table with side-by-side detail in wide windows / standalone app).">
      <locale lang="zh-Hans" label="服务器列表布局" help="选择卡片网格、紧凑可排序表格或自动切换（弹窗使用卡片，宽窗口或独立 App 自动切为表格 + 右侧详情双栏）。" />
      <locale lang="zh-Hant" label="伺服器列表佈局" help="選擇卡片網格、精簡可排序表格或自動切換（彈窗使用卡片，寬視窗或獨立 App 自動切換為表格 + 右側詳情雙欄）。" />
      <option value="auto" label="Auto (Cards / Wide Table)"><locale lang="zh-Hans" label="自动（弹窗卡片 / 宽窗表格）" /><locale lang="zh-Hant" label="自動（彈窗卡片 / 寬窗表格）" /></option>
      <option value="cards" label="Cards Grid"><locale lang="zh-Hans" label="精炼卡片网格" /><locale lang="zh-Hant" label="精煉卡片網格" /></option>
      <option value="table" label="Sortable Table"><locale lang="zh-Hans" label="紧凑可排序表格" /><locale lang="zh-Hant" label="精簡可排序表格" /></option>
    </input>
    <input name="panelWidth" type="select" label="Flyout Panel Width" default="medium"
           help="Unified width for the menu bar flyout panel across all tabs. Wide windows and standalone app automatically expand.">
      <locale lang="zh-Hans" label="菜单栏面板宽度" help="设置菜单栏弹窗在各标签页下的统一宽度（小 400px / 中 460px / 大 520px）；宽窗口和独立 App 会自动展开。" />
      <locale lang="zh-Hant" label="選單列面板寬度" help="設定選單列彈窗在各分頁下的統一寬度（小 400px / 中 460px / 大 520px）；寬視窗與獨立 App 會自動展開。" />
      <option value="small" label="Small (400px)"><locale lang="zh-Hans" label="小（400px · 紧凑）" /><locale lang="zh-Hant" label="小（400px · 緊湊）" /></option>
      <option value="medium" label="Medium (460px)"><locale lang="zh-Hans" label="中（460px · 均衡）" /><locale lang="zh-Hant" label="中（460px · 均衡）" /></option>
      <option value="large" label="Large (520px)"><locale lang="zh-Hans" label="大（520px · 宽松）" /><locale lang="zh-Hant" label="大（520px · 寬鬆）" /></option>
    </input>
    <input name="widgetMode" type="select" label="Desktop Widget" default="overview"
           help="Content shown by desktop widgets from this instance. Install multiple Nezha instances in Metrix.Bar 0.3+ if you want different widget modes side by side.">
      <locale lang="zh-Hans" label="桌面小组件内容" help="选择此实例桌面小组件展示的内容。Metrix.Bar 0.3+ 支持安装多个 Nezha 实例，分别绑定不同小组件模式或不同哪吒面板。" />
      <locale lang="zh-Hant" label="桌面小工具內容" help="選擇此實例桌面小工具展示的內容。Metrix.Bar 0.3+ 支援安裝多個 Nezha 實例，分別綁定不同小工具模式或不同哪吒面板。" />
      <option value="overview" label="Fleet Overview"><locale lang="zh-Hans" label="全部服务器总览" /><locale lang="zh-Hant" label="全部伺服器總覽" /></option>
      <option value="server" label="Single Server"><locale lang="zh-Hans" label="单台服务器" /><locale lang="zh-Hant" label="單台伺服器" /></option>
      <option value="traffic" label="Cycle Traffic"><locale lang="zh-Hans" label="周期流量" /><locale lang="zh-Hant" label="週期流量" /></option>
      <option value="attention" label="Attention Items"><locale lang="zh-Hans" label="关注事项" /><locale lang="zh-Hant" label="關注事項" /></option>
    </input>
    <input name="widgetServer" type="string" label="Widget Server ID or Unique Name"
           help="Single Server mode only. Leave empty to follow the server selected in the panel, or enter an ID / case-insensitive unique full name. Ambiguous names require an ID.">
      <locale lang="zh-Hans" label="小组件服务器（ID 或唯一名称）" help="仅在“单台服务器”模式下生效。留空则跟随面板当前选中的服务器，或填写服务器 ID / 不区分大小写的唯一完整名称；重名时请填写 ID。" />
      <locale lang="zh-Hant" label="小工具伺服器（ID 或唯一名稱）" help="僅在「單台伺服器」模式下生效。留空則跟隨面板目前選中的伺服器，或填寫伺服器 ID / 不區分大小寫的唯一完整名稱；重名時請填寫 ID。" />
    </input>
    <input name="offlineNotify" type="bool" label="Notify on Server Offline" default="true">
      <locale lang="zh-Hans" label="服务器离线通知" />
      <locale lang="zh-Hant" label="伺服器離線通知" />
    </input>
    <input name="probeNotify" type="bool" label="Notify on Probe Failure" default="true">
      <locale lang="zh-Hans" label="服务探测失败通知" />
      <locale lang="zh-Hant" label="服務探測失敗通知" />
    </input>
    <input name="trafficNotify" type="bool" label="Notify on Cycle Traffic Warning" default="true"
           help="Notify when a cycle traffic quota crosses 80% / 95%, or when the current burn rate is projected to exhaust the quota before reset.">
      <locale lang="zh-Hans" label="周期流量预警通知" help="周期流量使用率首次达到 80% / 95%，或按当前消耗速率预计在周期结束前耗尽时发送提醒。" />
      <locale lang="zh-Hant" label="週期流量預警通知" help="週期流量使用率首次達到 80% / 95%，或依目前消耗速率預計在週期結束前耗盡時發送提醒。" />
    </input>
    <input name="maskServiceTargets" type="bool" label="Mask Service URLs &amp; IPs" default="false"
           help="Mask URLs, hostnames, and IP addresses shown in the Services tab for privacy or screenshots.">
      <locale lang="zh-Hans" label="服务目标 URL / IP 打码" help="在“服务”标签页中对探测目标的 URL、域名和 IP 地址进行脱敏打码，适合隐私保护或截图分享。" />
      <locale lang="zh-Hant" label="服務目標 URL / IP 打碼" help="在「服務」分頁中對探測目標的 URL、網域與 IP 位址進行脫敏打碼，適合隱私保護或截圖分享。" />
    </input>
  </inputs>

  <docs>
    <![CDATA[Connect to your Nezha Monitoring V2 dashboard via guest mode or a read-only Personal Access Token (PAT). This dashboard is strictly read-only and never runs terminal, file, or MCP write actions.

Quick Setup
1. Enter your Nezha Dashboard URL (for example https://mon.example.com). Trailing slashes and subpaths are normalized automatically.
2. If your site enables force_auth or you want hidden servers and alert rules, create a read-only PAT (nzp_…) in Nezha Admin → Settings → API Tokens with nezha:inventory:read, nezha:server:read, nezha:service:read (and optionally nezha:alertrule:read), then paste it into API Token (PAT). Tokens are stored in your system credential store.

Highlights
- Menu Bar Rich Rendering (macOS): Choose stacked ↑↓ rates, rate + traffic sparkline, or cluster CPU + trend sparkline, and toggle the Nezha logo freely.
- Unified Panel Width & Adaptive Layout: Pick Small (400px), Medium (460px), or Large (520px) flyout width; wide windows and standalone apps automatically switch to a sortable table + live detail split view.
- Notch & Auto-Expand Alerts (Plus): Compact status on the wings, hover/click for cluster overview, timed alert highlights, and brief auto-expansion on critical alerts when "Allow automatic notch expansion" is enabled in Display Settings.
- Background Monitoring & Grouped Alerts: Stays active in the background while enabled on Metrix.Bar 0.3.4+ (≥1m interval when no visible surface is active) so offline, probe, traffic pace, and Plus Inbox alerts keep arriving with subtitles, macOS grouping, batch coalescing, and quiet low-priority delivery.
- Native Webhook / Email Alert Feed (Plus Inbox): Bind a Metrix.Bar Inbox to this dashboard and point Nezha's notification channel at it to receive every rule alert (even while your Mac sleeps).
- Multi-Size Desktop Widgets: Small, Medium, and Large widgets supporting Fleet Overview, Single Server, Cycle Traffic, and Attention modes.]]>
    <locale lang="zh-Hans"><![CDATA[连接哪吒监控 V2（Nezha Monitoring）面板，支持游客模式或 PAT 认证。本看板只读，不执行终端、文件管理或 MCP 写操作。

快速配置
1. 在「哪吒 Dashboard 地址」填写面板地址（如 https://mon.example.com），末尾斜杠或子路径会自动规范化。
2. 如站点启用了 force_auth，或需要读取隐藏节点与告警规则，请在哪吒管理端「设置 → API Tokens」创建只读 PAT（nzp_…），勾选 nezha:inventory:read、nezha:server:read、nezha:service:read（可选 nezha:alertrule:read），填入「API Token（PAT）」。令牌仅保存在系统凭据库中。

主要特性
- 菜单栏富渲染（macOS）：在「菜单栏显示格式」中选择双行紧凑速率、双行速率 + 迷你流量图，或集群 CPU + 迷你趋势图；可通过「菜单栏显示 Logo」自由开关图标显示。
- 统一面板宽度与自适应布局：提供「菜单栏面板宽度」小（400px）/ 中（460px）/ 大（520px）三档调节，搭配全宽等分标签栏与自适应分组胶囊栏；在宽窗口或独立 App（宽度 ≥ 860）下自动展开左侧可排序表格 + 右侧实时详情双栏视图。
- 刘海屏与告警自动展开（Plus）：左右侧翼显示紧凑状态，悬停/点击展开集群概览；发生离线、探针异常、流量预警或高优 Inbox 告警时限时高亮提醒，在显示设置中开启「允许自动展开刘海屏」后还可自动短时展开告警卡片。
- 后台保活与分组静音通知：在 Metrix.Bar 0.3.4+ 中启用期间即使未固定任何可见入口也会按 ≥1 分钟间隔后台保活，持续推送离线、探针、流量消耗速率预警与分组/合并/低优静音通知。
- 原生 Webhook / 邮件告警流（Plus 收件箱）：在 Metrix.Bar 创建收件箱并绑定到此实例，将哪吒通知渠道指向该地址，即可在「关注」页接收完整规则告警（含休眠期间）。
- 多尺寸桌面小组件：支持小、中、大三种尺寸与总览 / 单机 / 周期流量 / 关注四种模式；支持安装多个实例分别绑定不同模式或集群。]]></locale>
    <locale lang="zh-Hant"><![CDATA[連接哪吒監控 V2（Nezha Monitoring）面板，支援訪客模式或 PAT 驗證。本看板嚴格唯讀，不執行終端機、檔案管理或 MCP 寫入操作。

快速設定
1. 在「哪吒 Dashboard 位址」填寫面板位址（如 https://mon.example.com），結尾斜線或子路徑會自動正規化。
2. 若站點啟用了 force_auth，或需要讀取隱藏節點與告警規則，請在哪吒管理端「設定 → API Tokens」建立唯讀 PAT（nzp_…），勾選 nezha:inventory:read、nezha:server:read、nezha:service:read（選填 nezha:alertrule:read），填入「API Token（PAT）」。權杖僅儲存在系統憑證庫中。

主要特色
- 選單列富渲染（macOS）：在「選單列顯示格式」中選擇雙行精簡速率、雙行速率 + 迷你流量圖，或叢集 CPU + 迷你趨勢圖；可透過「選單列顯示 Logo」自由開關圖示顯示。
- 統一面板寬度與自適應佈局：提供「選單列面板寬度」小（400px）/ 中（460px）/ 大（520px）三檔調整，搭配全寬等分分頁列與自適應分組膠囊列；在寬視窗或獨立 App（寬度 ≥ 860）下自動展開左側可排序表格 + 右側即時詳情雙欄檢視。
- 瀏海屏與告警自動展開（Plus）：左右側翼顯示精簡狀態，懸停/點擊展開叢集概覽；發生離線、探針異常、流量預警或高優 Inbox 告警時限時高亮提醒，在顯示設定中開啟「允許自動展開瀏海屏」後還可自動短時展開告警卡片。
- 背景保活與分組靜音通知：在 Metrix.Bar 0.3.4+ 中啟用期間即使未釘選任何可見入口，也會依 ≥1 分鐘間隔在背景持續監控，穩定推送離線、探針、流量消耗速率預警與分組/合併/低優靜音通知。
- 原生 Webhook / 郵件告警流（Plus 收件匣）：在 Metrix.Bar 建立收件匣並綁定至此實例，將哪吒通知管道指向該位址，即可在「關注」頁接收完整規則告警（含休眠期間）。
- 多尺寸桌面小工具：支援小、中、大三種尺寸與總覽 / 單機 / 週期流量 / 關注四種模式；支援安裝多個實例分別綁定不同模式或叢集。]]></locale>
  </docs>

  <script apis="app localStorage notification shell websocket clipboard match-media"><![CDATA[
const h = (type, props, ...children) => ({
  type,
  props: props || {},
  children: children.flat().filter(c => c !== null && c !== undefined && c !== false),
});

const TX = (text, props) => h("Text", { text: String(text), ...(props || {}) });
const K = { up: "[#10b981]", down: "[#ef4444]", warn: "[#f59e0b]", accent: "[#0a94f2]", muted: "textMuted" };
const PAL = {
  brand: "#0a94f2",
  blue: "#3b82f6",
  sky: "#0ea5e9",
  emerald: "#10b981",
  indigo: "#6366f1",
  amber: "#f59e0b",
  red: "#ef4444",
  slate: "#64748b",
};
const LATENCY_PAL = [
  "#3b82f6",
  "#10b981",
  "#f59e0b",
  "#8b5cf6",
  "#ef4444",
  "#06b6d4",
  "#ec4899",
  "#84cc16",
  "#f97316",
  "#14b8a6",
];

function isDarkTheme() {
  try {
    return !!(globalThis.matchMedia && globalThis.matchMedia("(prefers-color-scheme: dark)").matches);
  } catch {
    return false;
  }
}

function cardBorder() {
  return isDarkTheme() ? "[#ffffff14]" : "[#00000010]";
}

function Line() {
  return h("Box", { tw: `w-full h-px bg-${cardBorder()} shrink-0` });
}

function barHex(value, normalHex = PAL.blue) {
  const n = Number(value) || 0;
  if (n >= 90) return PAL.red;
  if (n >= 80) return PAL.amber;
  return normalHex;
}

function metricValueTw(value, online = true) {
  if (!online) return "text-textMuted";
  const n = Number(value) || 0;
  if (n >= 90) return "text-[#ef4444]";
  if (n >= 80) return "text-[#f59e0b]";
  return "text-text";
}

function normalizeBaseURL(raw) {
  let u = String(raw || "").trim();
  if (!u) return "";
  if (!/^https?:\/\//i.test(u)) u = "https://" + u;
  try {
    const url = new URL(u);
    if (!url.hostname) return "";
    return url.origin;
  } catch {
    return "";
  }
}

function unwrapNezha(body) {
  if (!body || typeof body !== "object") throw new Error("Invalid response");
  if (body.error || body.success === false) {
    throw new Error(String(body.error || "Request failed"));
  }
  return body.data;
}

function isServerOnline(server, nowMs = Date.now(), windowMs = 30000) {
  if (!server) return false;
  if (typeof server.online === "boolean") return server.online;
  const la = server.last_active;
  if (!la) return false;
  const t = Date.parse(la);
  if (!Number.isFinite(t)) return false;
  return nowMs - t < windowMs;
}

function mergeServerFrame(prevMap, frame) {
  const next = new Map(prevMap);
  const list = Array.isArray(frame?.servers) ? frame.servers : [];
  const onlineArr = Array.isArray(frame?.online) ? new Set(frame.online) : null;
  for (const s of list) {
    if (!s || s.id == null) continue;
    const id = String(s.id);
    const prev = next.get(id) || {};
    const merged = { ...prev, ...s };
    if (s.public_note === undefined && prev.public_note !== undefined) {
      merged.public_note = prev.public_note;
    }
    if (onlineArr) merged.online = onlineArr.has(s.id) || onlineArr.has(Number(s.id)) || onlineArr.has(id);
    next.set(id, merged);
  }
  return next;
}

function mergeServerList(prevMap, list) {
  const next = new Map();
  for (const s of Array.isArray(list) ? list : []) {
    if (!s || s.id == null) continue;
    const id = String(s.id);
    const prev = prevMap.get(id) || {};
    const merged = { ...prev, ...s };
    if (s.public_note === undefined && prev.public_note !== undefined) {
      merged.public_note = prev.public_note;
    }
    if (s.online === undefined) delete merged.online;
    next.set(id, merged);
  }
  return next;
}

function buildGroupIndex(groupPayload) {
  const byServer = new Map();
  const groups = [];
  const arr = Array.isArray(groupPayload) ? groupPayload : [];
  for (const item of arr) {
    const g = item?.group || item;
    if (!g || g.id == null) continue;
    const id = String(g.id);
    const name = g.name || id;
    const servers = Array.isArray(item.servers) ? item.servers.map(String) : [];
    groups.push({ id, name, servers });
    for (const sid of servers) {
      const key = String(sid);
      const memberships = byServer.get(key) || [];
      if (!memberships.some(group => group.id === id)) memberships.push({ id, name });
      byServer.set(key, memberships);
    }
  }
  groups.sort((a, b) => a.name.localeCompare(b.name));
  return { groups, byServer };
}

function resolveGroupSelection(selectedGroup, groups) {
  if (!selectedGroup || selectedGroup === "all") return "all";
  const list = Array.isArray(groups) ? groups : [];
  return list.some(g => String(g.id) === String(selectedGroup)) ? String(selectedGroup) : "all";
}

function scopedServers({
  servers,
  groupId = "all",
  watchMode = "all",
  watchlist = new Set(),
  byServerGroup = new Map(),
}) {
  let list = Array.from(servers.values());
  if (groupId && groupId !== "all") {
    list = list.filter(s => {
      const memberships = byServerGroup.get(String(s.id)) || [];
      return memberships.some(g => String(g.id) === String(groupId));
    });
  }
  if (watchMode === "starred" && watchlist && watchlist.size > 0) {
    list = list.filter(s => watchlist.has(String(s.id)));
  }
  return list;
}

function summarizeScoped(list, nowMs = Date.now()) {
  let online = 0;
  let netDown = 0;
  let netUp = 0;
  let transferDown = 0;
  let transferUp = 0;
  let cpuSum = 0;
  let cpuN = 0;
  for (const s of list) {
    const on = isServerOnline(s, nowMs);
    const st = s.state || {};
    if (on) {
      online += 1;
      netDown += Number(st.net_in_speed) || 0;
      netUp += Number(st.net_out_speed) || 0;
    }
    transferDown += Number(st.net_in_transfer) || 0;
    transferUp += Number(st.net_out_transfer) || 0;
    if (on && Number.isFinite(Number(st.cpu))) {
      cpuSum += Number(st.cpu);
      cpuN += 1;
    }
  }
  return {
    online,
    total: list.length,
    offline: Math.max(0, list.length - online),
    netDown,
    netUp,
    transferDown,
    transferUp,
    avgCpu: cpuN ? cpuSum / cpuN : 0,
  };
}

function formatRate(bytesPerSec, compact = false) {
  const n = Number(bytesPerSec) || 0;
  const abs = Math.abs(n);
  const units = ["B/s", "K/s", "M/s", "G/s", "T/s"];
  let v = abs;
  let i = 0;
  while (v >= 1024 && i < units.length - 1) {
    v /= 1024;
    i += 1;
  }
  const digits = compact ? (v >= 100 ? 0 : v >= 10 ? 1 : 2) : v >= 100 ? 0 : 1;
  return `${v.toFixed(digits)}${units[i]}`;
}

function pickRateScale(maxBytesPerSec) {
  const peak = Math.max(0, Number(maxBytesPerSec) || 0);
  if (peak >= 1024 ** 3) return { divisor: 1024 ** 3, unit: "GB/s" };
  if (peak >= 1024 ** 2) return { divisor: 1024 ** 2, unit: "MB/s" };
  if (peak >= 1024) return { divisor: 1024, unit: "KB/s" };
  return { divisor: 1, unit: "B/s" };
}

function formatBytes(bytes, digits = 1, compact = false) {
  const n = Number(bytes) || 0;
  const abs = Math.abs(n);
  const units = compact ? ["B", "K", "M", "G", "T"] : ["B", "KB", "MB", "GB", "TB"];
  let v = abs;
  let i = 0;
  while (v >= 1024 && i < units.length - 1) {
    v /= 1024;
    i += 1;
  }
  const d = compact ? (v >= 100 ? 0 : v >= 10 ? 1 : 2) : digits;
  let text = v.toFixed(d);
  if (compact && d > 0) text = text.replace(/\.?0+$/, "");
  return compact ? `${text}${units[i]}` : `${text} ${units[i]}`;
}

function pct(used, total) {
  const t = Number(total) || 0;
  if (t <= 0) return 0;
  return Math.max(0, Math.min(100, ((Number(used) || 0) / t) * 100));
}

function serviceTypeLabel(type) {
  const t = Number(type);
  if (t === 1) return "HTTP";
  if (t === 2) return "Ping";
  if (t === 3) return "TCP";
  return "Other";
}

function mergeServiceRows(listPayload, overviewPayload) {
  const list = Array.isArray(listPayload) ? listPayload : [];
  const overview =
    overviewPayload && typeof overviewPayload === "object"
      ? overviewPayload.services || overviewPayload
      : {};
  return list
    .map(item => {
      const ov = overview[String(item.id)] || overview[item.id] || {};
      const up = Number(ov.current_up) || 0;
      const down = Number(ov.current_down) || 0;
      const total = up + down;
      const delayArr = Array.isArray(ov.delay) ? ov.delay : [];
      const lastDelay = delayArr.length ? Number(delayArr[delayArr.length - 1]) : NaN;
      const upPercent = total > 0 ? (up / total) * 100 : 100;
      return {
        id: item.id,
        name: item.name || ov.service_name || String(item.id),
        display_index: item.display_index,
        type: item.type,
        typeLabel: serviceTypeLabel(item.type),
        target: item.target || "",
        currentUp: up,
        currentDown: down,
        upPercent,
        delay: Number.isFinite(lastDelay) ? lastDelay : null,
        failing: down > 0 && up === 0,
      };
    })
    .sort((a, b) => Number(a.display_index || 0) - Number(b.display_index || 0) || String(a.name).localeCompare(String(b.name)));
}

function maskHostLabel(label) {
  if (!label) return "";
  return label.length <= 1 ? "*" : `${label[0]}***`;
}

function maskHost(host) {
  const s = String(host || "").trim();
  if (!s) return "";
  if (/^\d{1,3}(?:\.\d{1,3}){3}$/.test(s)) {
    const parts = s.split(".");
    if (parts.every(p => Number(p) <= 255)) {
      return `${parts[0]}.*.*.${parts[3]}`;
    }
  }
  const bracketed = s.startsWith("[") && s.endsWith("]");
  const bare = bracketed ? s.slice(1, -1) : s;
  if (bare.includes(":")) {
    const segs = bare.split(":").filter(Boolean);
    let masked;
    if (segs.length >= 2) masked = `${segs[0]}:****:${segs[segs.length - 1]}`;
    else if (bare.startsWith("::")) masked = "::****";
    else masked = `${segs[0] || ""}:****`;
    return bracketed ? `[${masked}]` : masked;
  }
  if (s.includes(".")) {
    const labels = s.split(".");
    const last = labels[labels.length - 1];
    return `${labels.slice(0, -1).map(maskHostLabel).join(".")}.${last}`;
  }
  return maskHostLabel(s);
}

function maskServiceTarget(raw) {
  const s = String(raw || "").trim();
  if (!s) return "";
  if (/^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//.test(s)) {
    try {
      const u = new URL(s);
      const auth = (u.username || u.password) ? "***@" : "";
      let host = maskHost(u.hostname);
      if (host.includes(":") && !host.startsWith("[")) host = `[${host}]`;
      const port = u.port ? `:${u.port}` : "";
      const hasPathOrQuery = (u.pathname && u.pathname !== "/") || Boolean(u.search) || Boolean(u.hash);
      return `${u.protocol}//${auth}${host}${port}${hasPathOrQuery ? "/***" : ""}`;
    } catch {}
  }
  const ipv6Port = s.match(/^(\[[^\]]+\])(?::(\d+))?$/);
  if (ipv6Port) {
    return `${maskHost(ipv6Port[1])}${ipv6Port[2] ? `:${ipv6Port[2]}` : ""}`;
  }
  if (/^[0-9a-fA-F:]+$/.test(s) && (s.match(/:/g) || []).length >= 2) {
    return maskHost(s);
  }
  const hostPort = s.match(/^([^\s/:]+)(?::(\d+))?$/);
  if (hostPort) {
    return `${maskHost(hostPort[1])}${hostPort[2] ? `:${hostPort[2]}` : ""}`;
  }
  return s.length <= 2 ? "***" : `${s[0]}***`;
}

function buildAttention({ servers = [], services = [], alertRules = [], cycleTransfers = [], nowMs = Date.now() }) {
  const items = [];
  for (const s of servers) {
    if (!isServerOnline(s, nowMs)) {
      items.push({ kind: "offline", id: `srv-${s.id}`, serverId: String(s.id), title: s.name || String(s.id), meta: s.last_active || "" });
    }
  }
  for (const svc of services) {
    if (svc.failing || (svc.currentDown > 0 && svc.currentUp === 0)) {
      items.push({
        kind: "probe",
        id: `svc-${svc.id}`,
        serviceId: String(svc.id),
        title: svc.name,
        meta: `${svc.typeLabel} · down`,
      });
    }
  }
  for (const c of cycleTransfers) {
    if (c.pct < 80) continue;
    items.push({
      kind: "traffic",
      id: `traffic-${c.id}`,
      serverId: String(c.serverId),
      title: c.serverName,
      meta: `${c.cycle} · ${c.pct.toFixed(1)}% · ${formatBytes(c.remaining, 1, true)} left`,
      severity: c.pct >= 95 ? "critical" : "warning",
    });
  }
  const rules = Array.isArray(alertRules) ? alertRules : [];
  return { items, rules };
}

function detectTrafficThresholds(previousLevels, cycleTransfers) {
  const nextLevels = new Map();
  const crossed = [];
  for (const c of Array.isArray(cycleTransfers) ? cycleTransfers : []) {
    const level = c.pct >= 95 ? 2 : c.pct >= 80 ? 1 : 0;
    const previous = Number(previousLevels.get(c.id)) || 0;
    nextLevels.set(c.id, level);
    if (level > previous) crossed.push({ ...c, level });
  }
  return { nextLevels, crossed };
}

function computeCyclePace(cycle, nowMs = Date.now()) {
  if (!cycle || typeof cycle !== "object") return null;
  const timeInfo = computeCycleTimeProgress(cycle.from, cycle.to, nowMs);
  if (!timeInfo || timeInfo.ended) return null;
  const pct = Number(cycle.pct) || 0;
  const timePct = timeInfo.timePct;
  if (timePct < 10 || timePct >= 98 || pct <= 0) return null;
  const projectedPct = (pct / timePct) * 100;
  const aheadPct = pct - timePct;
  const warning = pct >= 25 && pct < 100 && aheadPct >= 15 && projectedPct >= 110;
  const used = Number(cycle.used) || 0;
  const remaining = Number(cycle.remaining) || Math.max(0, (Number(cycle.max) || 0) - used);
  let estExhaustMs = null;
  if (pct < 100 && timeInfo.elapsedMs > 0 && used > 0 && remaining > 0) {
    const ratePerMs = used / timeInfo.elapsedMs;
    if (ratePerMs > 0) estExhaustMs = remaining / ratePerMs;
  }
  return {
    warning,
    projectedPct,
    aheadPct,
    timePct,
    remainingMs: timeInfo.remainingMs,
    estExhaustMs,
  };
}

function detectTrafficPaceAlerts(previousWarned, cycleTransfers, nowMs = Date.now()) {
  const prevSet = previousWarned instanceof Set ? previousWarned : new Set(Array.isArray(previousWarned) ? previousWarned : []);
  const nextWarned = new Set();
  const triggered = [];
  for (const c of Array.isArray(cycleTransfers) ? cycleTransfers : []) {
    const pace = computeCyclePace(c, nowMs);
    if (pace && pace.warning) {
      nextWarned.add(c.id);
      if (!prevSet.has(c.id) && (Number(c.pct) || 0) < 80) {
        triggered.push({ ...c, pace });
      }
    }
  }
  return { nextWarned, triggered };
}

function buildBatchNotificationSummary(names, locale = "zh", maxItems = 3) {
  const list = (Array.isArray(names) ? names : [])
    .map(n => String(n || "").trim())
    .filter(Boolean);
  if (!list.length) return "";
  const limit = Math.max(1, Number(maxItems) || 3);
  const isZh = locale !== "en";
  const sep = isZh ? "、" : ", ";
  if (list.length <= limit) return list.join(sep);
  const shown = list.slice(0, limit).join(sep);
  return isZh ? `${shown} 等 ${list.length} 项` : `${shown} +${list.length - limit} more`;
}

function filterServers(list, query) {
  const q = String(query || "").trim().toLowerCase();
  if (!q) return list;
  return list.filter(s => `${s.name || s.id || ""}\n${s.public_note || ""}`.toLowerCase().includes(q));
}

function trayTitle(format, summary) {
  const on = `${summary.online}/${summary.total}`;
  const total = formatRate(summary.netDown + summary.netUp, true);
  const down = formatRate(summary.netDown, true);
  const up = formatRate(summary.netUp, true);
  switch (format) {
    case "total":
      return total;
    case "online":
      return on;
    case "online_both":
    case "stacked_rate":
    case "rate_spark":
      return `${on} · ↑${up} ↓${down}`;
    case "cpu_spark":
      return `${on} · ${Math.round(Number(summary.avgCpu) || 0)}%`;
    case "online_total":
    default:
      return `${on} · ${total}`;
  }
}

function buildCycleTransfers(payload) {
  const stats = (payload && payload.cycle_transfer_stats) || {};
  const out = [];
  for (const [cycleId, item] of Object.entries(stats)) {
    if (!item || typeof item !== "object") continue;
    const max = Number(item.max) || 0;
    if (max <= 0) continue;
    const names = item.server_name || {};
    const transfer = item.transfer || {};
    const nextUpdate = item.next_update || {};
    for (const serverId of Object.keys(names)) {
      const used = Number(transfer[serverId]) || 0;
      out.push({
        id: `${cycleId}:${serverId}`,
        cycle: String(item.name || cycleId),
        serverId: String(serverId),
        serverName: String(names[serverId] || serverId),
        from: String(item.from || ""),
        to: String(item.to || ""),
        nextUpdate: String(nextUpdate[serverId] || ""),
        max,
        used,
        remaining: Math.max(0, max - used),
        pct: Math.max(0, Math.min(100, (used / max) * 100)),
      });
    }
  }
  out.sort((a, b) => b.pct - a.pct || a.serverName.localeCompare(b.serverName));
  return out;
}

function formatMonthDay(iso) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear()}`;
}

function formatMonthDayTime(iso) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  const pad = n => String(n).padStart(2, "0");
  return `${d.getMonth() + 1}/${d.getDate()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function formatCycleRange(fromIso, toIso) {
  const from = new Date(fromIso);
  const to = new Date(toIso);
  const hasFrom = !Number.isNaN(from.getTime());
  const hasTo = !Number.isNaN(to.getTime());
  if (!hasFrom && !hasTo) return "";
  if (!hasFrom) return `${to.getMonth() + 1}/${to.getDate()}`;
  if (!hasTo) return `${from.getMonth() + 1}/${from.getDate()}`;
  if (from.getFullYear() === to.getFullYear()) {
    return `${from.getMonth() + 1}/${from.getDate()} – ${to.getMonth() + 1}/${to.getDate()}`;
  }
  const fy = String(from.getFullYear()).slice(-2);
  const ty = String(to.getFullYear()).slice(-2);
  return `${fy}/${from.getMonth() + 1}/${from.getDate()} – ${ty}/${to.getMonth() + 1}/${to.getDate()}`;
}

function computeCycleTimeProgress(fromIso, toIso, nowMs = Date.now()) {
  const fromMs = Date.parse(fromIso);
  const toMs = Date.parse(toIso);
  if (!Number.isFinite(fromMs) || !Number.isFinite(toMs) || toMs <= fromMs) return null;
  const totalMs = toMs - fromMs;
  const elapsedMs = Math.max(0, Math.min(totalMs, nowMs - fromMs));
  const remainingMs = Math.max(0, toMs - nowMs);
  const timePct = Math.max(0, Math.min(100, (elapsedMs / totalMs) * 100));
  return { timePct, remainingMs, totalMs, elapsedMs, ended: nowMs >= toMs };
}

function formatCycleRemaining(remainingMs, lang = "zh") {
  if (!Number.isFinite(remainingMs)) return "";
  const isZh = lang !== "en";
  if (remainingMs <= 0) return isZh ? "已结束" : "Ended";
  if (remainingMs < 3_600_000) {
    const mins = Math.max(1, Math.ceil(remainingMs / 60_000));
    return isZh ? `剩 ${mins} 分钟` : `${mins}m left`;
  }
  if (remainingMs < 23.5 * 3_600_000) {
    const hours = Math.max(1, Math.round(remainingMs / 3_600_000));
    return isZh ? `剩 ${hours} 小时` : `${hours}h left`;
  }
  const days = Math.max(1, Math.round(remainingMs / 86_400_000));
  return isZh ? `剩 ${days} 天` : `${days}d left`;
}

function formatClockTime(ts) {
  const d = new Date(ts);
  if (Number.isNaN(d.getTime())) return "";
  const pad = n => String(n).padStart(2, "0");
  return `${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function formatDuration(seconds) {
  const s = Math.max(0, Math.round(Number(seconds) || 0));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  if (h >= 24) {
    const d = Math.floor(h / 24);
    return `${d}d ${h % 24}h`;
  }
  return `${h}h ${m}m`;
}

function downsamplePoints(points, maxPoints = 120) {
  if (!Array.isArray(points)) return [];
  if (points.length <= maxPoints || maxPoints < 2) return points.slice();
  const out = [];
  const step = (points.length - 1) / (maxPoints - 1);
  for (let i = 0; i < maxPoints; i++) {
    out.push(points[Math.round(i * step)]);
  }
  return out;
}

function alignMonitorSeries(seriesPointsList, maxPoints = 120) {
  const list = Array.isArray(seriesPointsList) ? seriesPointsList : [];
  let minTs = Infinity;
  let maxTs = -Infinity;
  let maxLen = 0;
  for (const pts of list) {
    if (!Array.isArray(pts) || !pts.length) continue;
    if (pts.length > maxLen) maxLen = pts.length;
    for (const p of pts) {
      const t = Number(p.ts);
      if (!Number.isFinite(t)) continue;
      if (t < minTs) minTs = t;
      if (t > maxTs) maxTs = t;
    }
  }
  if (!Number.isFinite(minTs) || !Number.isFinite(maxTs)) return list.map(() => []);
  if (minTs === maxTs) {
    return list.map(pts => (Array.isArray(pts) && pts.length ? [{ ts: minTs, value: pts[0].value }] : []));
  }
  const count = Math.min(Math.max(2, maxPoints), Math.max(2, maxLen));
  const step = (maxTs - minTs) / (count - 1);
  const snapMin = step >= 60_000;
  const grid = [];
  for (let i = 0; i < count; i++) {
    const raw = minTs + i * step;
    let t = snapMin ? Math.round(raw / 60_000) * 60_000 : Math.round(raw);
    if (grid.length && t <= grid[grid.length - 1]) t = grid[grid.length - 1] + 1000;
    grid.push(t);
  }
  const tol = Math.max(step * 0.75, 90_000);
  return list.map(pts => {
    if (!Array.isArray(pts) || !pts.length) return [];
    let j = 0;
    const out = [];
    for (let i = 0; i < grid.length; i++) {
      const target = grid[i];
      while (j + 1 < pts.length && Math.abs(pts[j + 1].ts - target) <= Math.abs(pts[j].ts - target)) {
        j += 1;
      }
      if (Math.abs(pts[j].ts - target) <= tol) {
        out.push({ ts: target, value: pts[j].value });
      }
    }
    return out;
  });
}

function resolveDetailPeriod(period, hasToken) {
  const p = String(period || "1d");
  if (!hasToken) return "1d";
  return p === "7d" || p === "30d" ? p : "1d";
}

function periodDays(period) {
  return period === "30d" ? 30 : period === "7d" ? 7 : 1;
}

function toggleMonitorSelection(selected, id, totalCount = 0) {
  const next = new Set(selected);
  const key = String(id);
  if (next.has(key)) next.delete(key);
  else next.add(key);
  if (totalCount > 0 && next.size >= totalCount) next.clear();
  return next;
}

function buildMonitorRows(monitors) {
  const list = Array.isArray(monitors) ? monitors : [];
  const out = [];
  for (const m of list) {
    if (!m || typeof m !== "object") continue;
    const ts = Array.isArray(m.created_at) ? m.created_at : [];
    const delays = Array.isArray(m.avg_delay) ? m.avg_delay : [];
    const total = delays.length;
    let up = 0;
    let sumDelay = 0;
    let minDelay = Infinity;
    let maxDelay = -Infinity;
    let lastDelay = null;
    const points = [];
    for (let i = 0; i < delays.length; i++) {
      const v = delays[i];
      const num = Number(v);
      if (v == null || !Number.isFinite(num) || num <= 0) continue;
      up += 1;
      sumDelay += num;
      if (num < minDelay) minDelay = num;
      if (num > maxDelay) maxDelay = num;
      lastDelay = num;
      if (i < ts.length) points.push({ ts: Number(ts[i]), value: num });
    }
    const down = Math.max(0, total - up);
    out.push({
      id: String(m.monitor_id ?? m.service_id ?? m.id ?? m.monitor_name ?? ""),
      name: String(m.monitor_name || m.service_name || m.monitor_id || "?"),
      displayIndex: Number(m.display_index) || 0,
      total,
      up,
      down,
      lossPct: total > 0 ? (down / total) * 100 : 0,
      delay: lastDelay,
      avgDelay: up > 0 ? sumDelay / up : null,
      minDelay: up > 0 ? minDelay : null,
      maxDelay: up > 0 ? maxDelay : null,
      points,
    });
  }
  out.sort((a, b) => {
    if (b.displayIndex !== a.displayIndex) return b.displayIndex - a.displayIndex;
    const na = Number(a.id);
    const nb = Number(b.id);
    if (Number.isFinite(na) && Number.isFinite(nb) && na !== nb) return na - nb;
    return a.name.localeCompare(b.name);
  });
  return out;
}

function buildOnlineSummary(online, windowSeconds) {
  const o = online && typeof online === "object" ? online : {};
  const onlineSeconds = Number(o.total_online_seconds) || 0;
  const win = Number(windowSeconds) > 0 ? Number(windowSeconds) : Math.max(1, onlineSeconds);
  const rate = Number(o.online_rate);
  return {
    currentlyOnline: !!o.currently_online,
    lastActive: String(o.last_active || ""),
    windowStart: String(o.window_start || ""),
    windowEnd: String(o.window_end || ""),
    onlineSeconds,
    offlineSeconds: Math.max(0, win - onlineSeconds),
    ratePct: Number.isFinite(rate) ? rate : (onlineSeconds / win) * 100,
    daily: Array.isArray(o.daily)
      ? o.daily.map(d => ({ date: String(d.date || ""), onlineSeconds: Number(d.online_seconds) || 0 }))
      : [],
  };
}

function buildDailyOnlineRows(daily, nowMs = Date.now(), window = null) {
  const list = Array.isArray(daily) ? daily : [];
  const now = new Date(nowMs);
  const pad = n => String(n).padStart(2, "0");
  const todayKey = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  const winStart = window && window.start ? new Date(window.start).getTime() : NaN;
  const winEnd = window && window.end ? new Date(window.end).getTime() : NaN;
  return list.map(d => {
    const onlineSeconds = Math.max(0, Number(d.onlineSeconds ?? d.online_seconds) || 0);
    const parts = String(d.date || "").split("-").map(Number);
    let expected = 86400;
    if (parts.length === 3 && parts.every(Number.isFinite)) {
      const dayStart = new Date(parts[0], parts[1] - 1, parts[2]).getTime();
      const dayEnd = dayStart + 86400 * 1000;
      const from = Number.isFinite(winStart) ? Math.max(dayStart, winStart) : dayStart;
      const to = Math.min(Number.isFinite(winEnd) ? winEnd : dayEnd, dayEnd, nowMs);
      expected = Math.max(1, Math.round((to - from) / 1000));
    }
    const pctVal = Math.max(0, Math.min(100, (onlineSeconds / expected) * 100));
    const color = pctVal >= 99 ? "success" : pctVal >= 95 ? "warning" : "danger";
    return { date: String(d.date || ""), onlineSeconds, expected, pct: pctVal, color, isToday: d.date === todayKey };
  });
}

function formatDailyDuration(seconds) {
  const s = Math.max(0, Math.round(Number(seconds) || 0));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  return `${h}h ${m}m`;
}

function detectTransitions(prevOnlineIds, nextOnlineIds) {
  const wentOffline = [];
  for (const id of prevOnlineIds) {
    if (!nextOnlineIds.has(id)) wentOffline.push(id);
  }
  return { wentOffline };
}

function resourceColor(value) {
  const n = Number(value) || 0;
  if (n >= 90) return "danger";
  if (n >= 80) return "warning";
  return "accent";
}

function formatRelativeTime(iso, nowMs = Date.now(), loc = "zh") {
  if (!iso) return "";
  const time = typeof iso === "number" ? iso : Date.parse(iso);
  if (!Number.isFinite(time)) return "";
  const seconds = Math.max(0, Math.floor((nowMs - time) / 1000));
  const zh = loc === "zh";
  if (seconds < 60) return zh ? "刚刚" : "now";
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return zh ? `${minutes} 分钟前` : `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return zh ? `${hours} 小时前` : `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return zh ? `${days} 天前` : `${days}d ago`;
}

function resolveWidgetServer(serversMap, selector) {
  const list = Array.from((serversMap && typeof serversMap.values === "function" ? serversMap.values() : serversMap) || []);
  const query = String(selector || "").trim();
  if (!query) return { status: "empty" };
  const byId = list.find(server => String(server && server.id) === query);
  if (byId) return { status: "ok", server: byId };
  const normalized = query.toLowerCase();
  const matches = list.filter(server => String(server && server.name || "").toLowerCase() === normalized);
  if (matches.length === 1) return { status: "ok", server: matches[0] };
  return { status: matches.length > 1 ? "ambiguous" : "missing" };
}

function pushFleetSample(history, summary, ts = Date.now(), maxLen = 60) {
  const prev = Array.isArray(history) ? history : [];
  const down = Number.isFinite(Number(summary?.netDown)) ? Math.max(0, Number(summary.netDown)) : 0;
  const up = Number.isFinite(Number(summary?.netUp)) ? Math.max(0, Number(summary.netUp)) : 0;
  const cpu = Number.isFinite(Number(summary?.avgCpu)) ? Math.max(0, Math.min(100, Number(summary.avgCpu))) : 0;
  const sample = {
    ts: Number.isFinite(Number(ts)) ? Number(ts) : Date.now(),
    cpu,
    down,
    up,
    totalRate: down + up,
    online: Number(summary?.online) || 0,
    total: Number(summary?.total) || 0,
  };
  const next = prev.length >= maxLen ? prev.slice(prev.length - maxLen + 1) : prev.slice();
  next.push(sample);
  return next;
}

function buildSparkPoints(history, key, maxPoints = 36) {
  const list = Array.isArray(history) ? history.slice(-maxPoints) : [];
  const out = [];
  for (let i = 0; i < list.length; i += 1) {
    const val = Number(list[i]?.[key]);
    if (!Number.isFinite(val)) continue;
    out.push({ x: i, y: val });
  }
  return out;
}

function formatShortRate(bytesPerSec) {
  const abs = Math.abs(Number(bytesPerSec) || 0);
  const units = ["B", "K", "M", "G", "T"];
  let v = abs;
  let i = 0;
  while (v >= 1024 && i < units.length - 1) {
    v /= 1024;
    i += 1;
  }
  const digits = v >= 10 ? 0 : i === 0 ? 0 : 1;
  return `${v.toFixed(digits)}${units[i]}`;
}

function formatCompactNotchValue(metric, summary) {
  if (!summary || !summary.total) return "—";
  if (metric === "cpu") return `${Math.round(Number(summary.avgCpu) || 0)}%`;
  if (metric === "online") return `${summary.online}/${summary.total}`;
  if (metric === "down") return `↓${formatShortRate(summary.netDown)}`;
  if (metric === "up") return `↑${formatShortRate(summary.netUp)}`;
  return formatShortRate((Number(summary.netDown) || 0) + (Number(summary.netUp) || 0));
}

function estimateTrayTextWidth(text, fontSize = 9.5) {
  let units = 0;
  for (const ch of String(text || "")) {
    if (ch === ".") units += 0.32;
    else if (ch === "↑" || ch === "↓") units += 0.62;
    else if (ch === "%") units += 0.85;
    else if (/[0-9]/.test(ch)) units += 0.64;
    else units += 0.68;
  }
  return Math.ceil(units * fontSize) + 3;
}

function resolvePanelWidth(size) {
  if (size === "small") return 400;
  if (size === "large") return 520;
  return 460;
}

function estimateGroupPillWidth(label) {
  let units = 0;
  for (const ch of Array.from(String(label || ""))) {
    const cp = ch.codePointAt(0) || 0;
    if (cp >= 0x1f1e6 && cp <= 0x1f1ff) units += 0.9;
    else if (cp > 0x2e80) units += 1.05;
    else if (ch === " ") units += 0.35;
    else units += 0.62;
  }
  return Math.ceil(units * 11) + 16;
}

function chooseGroupNavMode(groupItems, availableWidth = 380) {
  const list = Array.isArray(groupItems) ? groupItems : [];
  if (list.length <= 1) return "none";
  if (list.length > 8) return "select";
  const totalWidth = list.reduce((sum, item) => sum + estimateGroupPillWidth(item?.label), 0)
    + Math.max(0, list.length - 1) * 2
    + 6;
  return totalWidth <= availableWidth ? "bar" : "scroll";
}

function shouldUseFullDetailHeight({
  tab = "overview",
  loading = false,
  hasResourceChart = false,
  hasNetworkChart = false,
  monitorCount = 0,
  dailyCount = 0,
} = {}) {
  if (loading) return true;
  if (tab === "network") return monitorCount >= 3;
  if (tab === "online") return dailyCount > 5;
  return Boolean(hasResourceChart || hasNetworkChart || monitorCount > 0);
}

function buildTrayContent({ format, summary, history = [], canIcon = false, showIcon = true, brandSvg = "" }) {
  if (!["stacked_rate", "rate_spark", "cpu_spark"].includes(format)) return null;
  const gap = 3;
  const iconNode = canIcon && showIcon && brandSvg
    ? { type: "Icon", props: { svg: brandSvg, width: 14, height: 14, fontSize: 14 }, children: [] }
    : null;
  if (format === "cpu_spark") {
    const pts = buildSparkPoints(history, "cpu", 32);
    const chart = pts.length > 1
      ? { type: "Chart", props: { type: "area", width: 38, height: 18, strokeWidth: 1.2, series: [{ name: "cpu", points: pts }] }, children: [] }
      : null;
    const label = `${Math.round(Number(summary?.avgCpu) || 0)}%`;
    const labelWidth = Math.max(24, Math.min(40, estimateTrayTextWidth(label, 12)));
    const parts = [iconNode ? 14 : 0, labelWidth, chart ? 38 : 0].filter(Boolean);
    const width = parts.reduce((a, b) => a + b, 0) + Math.max(0, parts.length - 1) * gap + 2;
    return {
      type: "Row",
      props: { width: Math.max(16, Math.min(240, width)), height: 22, gap, alignItems: "center" },
      children: [iconNode, { type: "Text", props: { text: label, fontSize: 12, fontWeight: 600 }, children: [] }, chart].filter(Boolean),
    };
  }
  const upText = `↑${formatShortRate(summary?.netUp)}`;
  const downText = `↓${formatShortRate(summary?.netDown)}`;
  const colWidth = Math.max(28, Math.min(46, Math.max(estimateTrayTextWidth(upText, 9.5), estimateTrayTextWidth(downText, 9.5))));
  const stacked = {
    type: "Column",
    props: { width: colWidth, height: 22, justify: "space-between", alignItems: "end" },
    children: [
      { type: "Text", props: { text: upText, fontSize: 9.5, fontWeight: 500 }, children: [] },
      { type: "Text", props: { text: downText, fontSize: 9.5, fontWeight: 500 }, children: [] },
    ],
  };
  const pts = format === "rate_spark" ? buildSparkPoints(history, "totalRate", 32) : [];
  const chart = pts.length > 1
    ? { type: "Chart", props: { type: "area", width: 36, height: 18, strokeWidth: 1.2, series: [{ name: "net", points: pts }] }, children: [] }
    : null;
  const parts = [iconNode ? 14 : 0, colWidth, chart ? 36 : 0].filter(Boolean);
  const width = parts.reduce((a, b) => a + b, 0) + Math.max(0, parts.length - 1) * gap + 2;
  return {
    type: "Row",
    props: { width: Math.max(16, Math.min(240, width)), height: 22, gap, alignItems: "center" },
    children: [iconNode, stacked, chart].filter(Boolean),
  };
}

function sortServerList(list, sortKey = "cpu", sortDir = "desc", nowMs = Date.now()) {
  const dir = sortDir === "asc" ? 1 : -1;
  const arr = (Array.isArray(list) ? list : []).slice();
  const metric = s => {
    const st = s?.state || {};
    const host = s?.host || {};
    switch (sortKey) {
      case "name": return String(s?.name || s?.id || "");
      case "mem": return pct(st.mem_used, host.mem_total);
      case "disk": return pct(st.disk_used, host.disk_total);
      case "down": return Number(st.net_in_speed) || 0;
      case "up": return Number(st.net_out_speed) || 0;
      case "net": return (Number(st.net_in_speed) || 0) + (Number(st.net_out_speed) || 0);
      case "load": return Number(st.load_1) || 0;
      case "cpu":
      default: return Number(st.cpu) || 0;
    }
  };
  arr.sort((a, b) => {
    const onlineDiff = Number(isServerOnline(b, nowMs)) - Number(isServerOnline(a, nowMs));
    if (onlineDiff !== 0) return onlineDiff;
    if (sortKey === "name") {
      return dir * metric(a).localeCompare(metric(b));
    }
    const diff = metric(a) - metric(b);
    if (diff !== 0) return dir * diff;
    return String(a?.name || a?.id || "").localeCompare(String(b?.name || b?.id || ""));
  });
  return arr;
}

function resolveOutputDemand(raw) {
  if (!raw || typeof raw !== "object") {
    return {
      known: false,
      tray: true,
      panel: true,
      notch: null,
      widgetKnown: false,
      widgetFamilies: ["small", "medium", "large"],
    };
  }
  const w = raw.widget && typeof raw.widget === "object" ? raw.widget : {};
  const widgetKnown = Boolean(w.known);
  const validFamilies = ["small", "medium", "large"];
  const families = widgetKnown && Array.isArray(w.families)
    ? validFamilies.filter(f => w.families.includes(f))
    : validFamilies;
  return {
    known: true,
    tray: raw.tray !== false,
    panel: Boolean(raw.panel),
    notch: typeof raw.notch === "string" ? raw.notch : null,
    widgetKnown,
    widgetFamilies: families,
  };
}

function parseNotificationTarget(tag) {
  const s = String(tag || "");
  if (s === "nezha-off-batch") return { tab: "alerts" };
  if (s === "nezha-probe-batch") return { tab: "services" };
  if (s === "nezha-traffic-batch") return { tab: "traffic" };
  if (s === "nezha-inbox-batch") return { tab: "alerts" };
  if (s.startsWith("nezha-off-")) return { tab: "servers", serverId: s.slice(10) };
  if (s.startsWith("nezha-probe-")) return { tab: "services", serviceId: s.slice(12) };
  if (s.startsWith("nezha-traffic-")) {
    const rest = s.slice(14);
    const serverId = rest.split(":")[0] || "";
    return { tab: serverId ? "servers" : "traffic", serverId: serverId || null };
  }
  if (s.startsWith("nezha-inbox-")) return { tab: "alerts", inboxKey: s.slice(12) };
  return { tab: "alerts" };
}

function inferAlertSeverity(text) {
  const s = String(text || "").toLowerCase();
  if (/(恢复|已恢复|online|recovered|resolved|ok\b)/.test(s)) return "info";
  if (/(离线|宕机|故障|失败|严重|offline|down|critical|error|fatal|unreachable|alert)/.test(s)) return "critical";
  if (/(警告|预警|过高|超限|阈值|warn|high|exceed|limit|80%|90%|95%)/.test(s)) return "warning";
  return "warning";
}

function parseInboxAlert(entry, payload = null) {
  const src = String(entry?.source || "webhook");
  const baseTitle = String(entry?.subject || "").trim();
  const sender = String(entry?.sender || "").trim();
  let title = baseTitle;
  let body = "";
  let serverName = "";

  if (payload && typeof payload === "object" && !Array.isArray(payload)) {
    if (typeof payload.text === "string" && payload.subject !== undefined) {
      title = String(payload.subject || baseTitle || "(No subject)").trim();
      body = payload.text.trim();
    } else {
      title = String(payload.title || payload.rule || payload.event || payload.alert || baseTitle || "Webhook Alert").trim();
      serverName = String(payload.server?.name || payload.server_name || payload.host || payload.node || "").trim();
      body = String(payload.content || payload.message || payload.text || payload.description || payload.detail || "").trim();
      if (!body) {
        const parts = Object.entries(payload)
          .filter(([, v]) => v !== null && v !== undefined && typeof v !== "object")
          .slice(0, 6)
          .map(([k, v]) => `${k}: ${v}`);
        body = parts.join(" · ");
      }
    }
  } else if (typeof payload === "string" && payload.trim()) {
    const raw = payload.trim();
    if (src === "webhook" && raw.startsWith("{")) {
      try {
        const parsed = JSON.parse(raw);
        if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
          return parseInboxAlert(entry, parsed);
        }
      } catch {}
    }
    const lines = raw.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
    if (!title && lines.length) title = lines[0].slice(0, 120);
    body = lines.join("\n");
  }

  if (!title) title = src === "webhook" ? "Webhook Alert" : "(No subject)";
  const combined = `${title}\n${body}`;
  return {
    key: `${entry?.inbox_id || ""}:${entry?.seq ?? 0}`,
    inboxId: String(entry?.inbox_id || ""),
    seq: Number(entry?.seq) || 0,
    source: src,
    receivedAt: Number(entry?.received_at) || 0,
    sender,
    serverName,
    title: title.slice(0, 140),
    body: body.slice(0, 1200),
    severity: inferAlertSeverity(combined),
  };
}

const INBOX_READ_LIMIT = 500;

function trackInboxArrival(storeBoxes, inboxId, latest) {
  const boxes = storeBoxes && typeof storeBoxes === "object" ? storeBoxes : {};
  const list = Array.isArray(latest) ? latest : [];
  const top = list.reduce((max, m) => Math.max(max, Number(m?.seq) || 0), 0);
  const existing = boxes[inboxId];
  if (!existing) {
    boxes[inboxId] = { base: top, top, read: [], unread: [] };
    return [];
  }
  if (!Array.isArray(existing.read)) existing.read = [];
  if (!Array.isArray(existing.unread)) existing.unread = [];
  const arrived = list.filter(m => (Number(m?.seq) || 0) > existing.top);
  if (top > existing.top) existing.top = top;
  return arrived;
}

function isInboxUnread(storeBoxes, inboxId, seq) {
  const e = storeBoxes?.[inboxId];
  if (!e) return false;
  const n = Number(seq) || 0;
  return n > e.base ? !e.read.includes(n) : e.unread.includes(n);
}

function setInboxRead(storeBoxes, inboxId, seq, read) {
  const e = storeBoxes?.[inboxId];
  if (!e) return false;
  const n = Number(seq) || 0;
  if (isInboxUnread(storeBoxes, inboxId, n) === !read) return false;
  const list = n > e.base ? e.read : e.unread;
  if (read === (n > e.base)) list.push(n);
  else {
    const idx = list.indexOf(n);
    if (idx >= 0) list.splice(idx, 1);
  }
  e.read.sort((a, b) => a - b);
  while (e.read.length > INBOX_READ_LIMIT) e.base = Math.max(e.base, e.read.shift());
  e.unread = e.unread.filter(s => s <= e.base).slice(-INBOX_READ_LIMIT);
  return true;
}

const svgIcon = (paths, strokeWidth = 1.9) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${strokeWidth}" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

const BRAND = "<svg xmlns=\"http://www.w3.org/2000/svg\" xml:space=\"preserve\" viewBox=\"0 0 512 512\"><path d=\"M21.1 0v186.2L152.4 268 463.8 78.6 441.7 77V0z\" style=\"opacity:.75;fill-rule:evenodd;clip-rule:evenodd\"/><path d=\"M163.9 370 21.1 279.9v128.3L230.7 512l209.6-103.8V175.8L491 93.3z\" style=\"fill-rule:evenodd;clip-rule:evenodd\"/></svg>";

const ICONS = {
