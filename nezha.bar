let locale = "zh";
const T = () => I18N[locale] || I18N.zh;

let baseURL = "";
let apiToken = "";
let refreshSec = 5;
let liveUpdates = true;
let trayFormat = "online_total";
let notchMetric = "rate";
let notchActivityEnabled = true;
let serverViewPref = "auto";
let viewOverride = localStorage.getItem("nezha.view") || "";
let widgetMode = "overview";
let widgetServer = "";
let offlineNotify = true;
let probeNotify = true;
let trafficNotify = true;
let authMode = "guest";
let wsDegraded = false;
let forceAuthHint = false;
let error = "";
let loadedAt = 0;
let inflight = false;
const inflightDomains = new Set();
const forcePending = new Set();
const detailInflight = new Map();
let lastServerRefresh = 0;
let lastServiceRefresh = 0;
let lastMetadataRefresh = 0;
let lastAlertRefresh = 0;
let lastInboxRefresh = 0;
let connectionGeneration = 0;
let settings = null;
let servers = new Map();
let groups = [];
let byServerGroup = new Map();
let serviceRows = [];
let alertRules = [];
let fleetHistory = [];
let lastSampleAt = 0;
let activeTab = localStorage.getItem("nezha.tab") || "servers";
let selectedGroup = localStorage.getItem("nezha.group") || "all";
let watchMode = localStorage.getItem("nezha.watchMode") || "all";
let sortBy = localStorage.getItem("nezha.sort") || "cpu";
let sortDir = localStorage.getItem("nezha.sortDir") || (sortBy === "name" ? "asc" : "desc");
let serverQuery = "";
let selectedServerId = null;
let detailPeriod = localStorage.getItem("nezha.period") || "1d";
let metricsCache = new Map();
let cycleTransfers = [];
let serviceFilter = "all";
let selectedServiceId = null;
let watchlist = new Set();
try {
  const raw = JSON.parse(localStorage.getItem("nezha.watchlist") || "[]");
  if (Array.isArray(raw)) watchlist = new Set(raw.map(String));
} catch {}
let prevOnline = new Set();
let prevFailing = new Set();
let prevTrafficLevels = new Map();
let hadSnapshot = false;
let hadServiceSnapshot = false;
let ws = null;
let reconnectTimer = null;
let lastTitle = "Nezha";
let lastWidgetConfig = "";
let cachedPanelTree = null;
let cachedPanelHadData = false;
let activeNotchActivity = null;
let networkOnline = true;

let capsProbed = false;
const caps = {
  trayContent: false,
  trayContentIcon: false,
  notch: null,
  notchActivity: null,
  widgetChart: true,
  inboxBoxes: false,
  inboxMessage: false,
  inboxRemove: false,
};

let inboxBoxes = [];
let inboxAlerts = [];
let inboxBodies = new Map();
let inboxLoadingKey = null;
let expandedInboxKey = null;
let inboxInflight = false;
let inboxStore = { boxes: {} };
try {
  const parsed = JSON.parse(localStorage.getItem("nezha.inbox.state") || "{}");
  if (parsed && typeof parsed.boxes === "object" && parsed.boxes) inboxStore = { boxes: parsed.boxes };
} catch {}

function saveInboxStore() {
  try { localStorage.setItem("nezha.inbox.state", JSON.stringify(inboxStore)); } catch {}
}

function within(promise, ms = 10000) {
  let timer;
  return Promise.race([
    promise,
    new Promise((_, reject) => {
      timer = setTimeout(() => reject(new Error("timeout")), ms);
    }),
  ]).finally(() => clearTimeout(timer));
}

async function probeCapabilities() {
  if (capsProbed) return;
  capsProbed = true;
  if (!$metrix || typeof $metrix.caniuse !== "function") return;
  const probe = async name => {
    try { return Boolean(await $metrix.caniuse(name)); } catch { return false; }
  };
  const [tc, tci, notch, na, wc, ib, im, ir] = await Promise.all([
    probe("render.tray.content"),
    probe("render.tray.content.icon"),
    probe("render.notch"),
    probe("render.notch.activity"),
    probe("render.widget.chart"),
    probe("inbox.boxes"),
    probe("inbox.message"),
    probe("inbox.remove"),
  ]);
  caps.trayContent = tc;
  caps.trayContentIcon = tci;
  caps.notch = notch;
  caps.notchActivity = na;
  caps.widgetChart = wc;
  caps.inboxBoxes = ib;
  caps.inboxMessage = im;
  caps.inboxRemove = ir;
}

function readOutputs() {
  try {
    if ($metrix && typeof $metrix.outputs === "function") {
      return resolveOutputDemand($metrix.outputs());
    }
  } catch {}
  return resolveOutputDemand(null);
}

function isPlusSubscription() {
  try {
    if ($metrix && typeof $metrix.subscription === "function") {
      return $metrix.subscription() !== "free";
    }
  } catch {}
  return true;
}

async function detectHostLocale() {
  try {
    const lang = String(($metrix && $metrix.env && $metrix.env.locale) || "").toLowerCase();
    locale = lang.startsWith("zh") ? "zh" : (lang ? "en" : locale);
  } catch {}
  try {
    if (!locale) locale = (Intl.DateTimeFormat().resolvedOptions().locale || "").startsWith("zh") ? "zh" : "en";
  } catch { locale = "zh"; }
}

function triggerNotchActivity(id, durationMs = 300000, persistentAttention = false) {
  if (!notchActivityEnabled) return;
  activeNotchActivity = {
    id: String(id),
    expiresAt: Date.now() + durationMs,
    persistentAttention,
  };
}

function handleNotificationClick(tag) {
  const target = parseNotificationTarget(tag);
  activeTab = target.tab || "alerts";
  localStorage.setItem("nezha.tab", activeTab);
  if (target.serverId) {
    selectedServerId = String(target.serverId);
    selectedServiceId = null;
    void loadMetrics(selectedServerId);
  } else if (target.serviceId) {
    selectedServiceId = String(target.serviceId);
    selectedServerId = null;
  } else if (target.inboxKey) {
    expandedInboxKey = String(target.inboxKey);
    const hit = inboxAlerts.find(a => a.key === expandedInboxKey);
    if (hit) {
      if (setInboxRead(inboxStore.boxes, hit.inboxId, hit.seq, true)) saveInboxStore();
      void loadInboxDetail(hit);
    }
  }
  try { $metrix?.panel?.open?.(); } catch {}
  $metrix.invalidate();
}

function sendNotification(title, body, tag) {
  try {
    const n = new Notification(title, { body, tag });
    if (n) n.onclick = () => handleNotificationClick(tag);
  } catch {}
}

async function copyText(text) {
  const value = String(text || "");
  if (!value) return;
  try {
    if (typeof navigator !== "undefined" && navigator.clipboard) {
      if (typeof navigator.clipboard.writeText === "function") {
        await navigator.clipboard.writeText(value);
      } else if (typeof navigator.clipboard.write === "function" && typeof ClipboardItem !== "undefined" && typeof Blob !== "undefined") {
        await navigator.clipboard.write([new ClipboardItem({ "text/plain": new Blob([value], { type: "text/plain" }) })]);
      }
    }
    try { $metrix.toast(T().copied); } catch {}
  } catch {}
}

function recordFleetSample(force = false) {
  if (!servers.size) return;
  const now = Date.now();
  if (!force && now - lastSampleAt < 1000) return;
  lastSampleAt = now;
  const summary = summarizeScoped(Array.from(servers.values()), now);
  fleetHistory = pushFleetSample(fleetHistory, summary, now, 60);
}

function resetConnectionState() {
  connectionGeneration += 1;
  disconnectWS();
  servers = new Map();
  groups = [];
  byServerGroup = new Map();
  serviceRows = [];
  alertRules = [];
  cycleTransfers = [];
  fleetHistory = [];
  lastSampleAt = 0;
  settings = null;
  selectedServerId = null;
  selectedServiceId = null;
  metricsCache = new Map();
  prevOnline = new Set();
  prevFailing = new Set();
  prevTrafficLevels = new Map();
  hadSnapshot = false;
  hadServiceSnapshot = false;
  loadedAt = 0;
  error = "";
  forceAuthHint = false;
  wsDegraded = false;
  wsAttempts = 0;
  wsEverOpened = false;
  inflightDomains.clear();
  forcePending.clear();
  detailInflight.clear();
  inflight = false;
  lastServerRefresh = 0;
  lastServiceRefresh = 0;
  lastMetadataRefresh = 0;
  lastAlertRefresh = 0;
  cachedPanelTree = null;
  cachedPanelHadData = false;
}

function syncInputs(env) {
  const inputs = (env && env.inputs) || {};
  const nextBaseURL = normalizeBaseURL(inputs.baseURL);
  if (nextBaseURL !== baseURL) {
    baseURL = nextBaseURL;
    resetConnectionState();
  }
  let token = "";
  try { token = String($metrix.secret("apiToken") || "").trim(); } catch {}
  if (token !== apiToken) {
    apiToken = token;
    wsDegraded = false;
    wsAttempts = 0;
    wsEverOpened = false;
    disconnectWS();
  }
  authMode = apiToken ? "pat" : "guest";
  const nextLive = inputs.liveUpdates !== false && inputs.liveUpdates !== "false";
  if (nextLive !== liveUpdates) {
    liveUpdates = nextLive;
    if (!liveUpdates || apiToken) {
      disconnectWS();
      wsDegraded = false;
    }
  }
  const nextSec = Math.max(2, Number(inputs.refreshInterval) || 5);
  if (nextSec !== refreshSec) {
    refreshSec = nextSec;
    try { $metrix.schedule(refreshSec * 1000); } catch {}
  }
  const tf = String(inputs.trayFormat || "online_total");
  if (["online_total", "total", "online_both", "online", "stacked_rate", "rate_spark", "cpu_spark"].includes(tf)) {
    trayFormat = tf;
  }
  const nm = String(inputs.notchMetric || "rate");
  notchMetric = ["rate", "cpu", "online"].includes(nm) ? nm : "rate";
  notchActivityEnabled = inputs.notchActivity !== false && inputs.notchActivity !== "false";
  const sv = String(inputs.serverView || "auto");
  serverViewPref = ["auto", "cards", "table"].includes(sv) ? sv : "auto";
  const wm = String(inputs.widgetMode || "overview");
  widgetMode = ["overview", "server", "traffic", "attention"].includes(wm) ? wm : "overview";
  widgetServer = String(inputs.widgetServer || "").trim();
  const nextWidgetConfig = `${widgetMode}\n${widgetServer}`;
  if (lastWidgetConfig && nextWidgetConfig !== lastWidgetConfig) $metrix.invalidate();
  lastWidgetConfig = nextWidgetConfig;
  offlineNotify = inputs.offlineNotify !== false && inputs.offlineNotify !== "false";
  probeNotify = inputs.probeNotify !== false && inputs.probeNotify !== "false";
  trafficNotify = inputs.trafficNotify !== false && inputs.trafficNotify !== "false";
}

function persistWatch() {
  localStorage.setItem("nezha.watchlist", JSON.stringify(Array.from(watchlist)));
}

function authHeaders() {
  const hdrs = { Accept: "application/json" };
  if (apiToken) hdrs.Authorization = `Bearer ${apiToken}`;
  return hdrs;
}

async function nezhaFetch(path) {
  if (!baseURL) throw new Error("missing url");
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 10000);
  try {
    const res = await fetch(`${baseURL}${path}`, { headers: authHeaders(), signal: controller.signal });
    const text = await res.text();
    let body;
    try { body = JSON.parse(text); } catch { throw new Error(`HTTP ${res.status}`); }
    if (res.status === 401 || res.status === 403) forceAuthHint = !apiToken;
    if (!res.ok) throw new Error(String(body && body.error || `HTTP ${res.status}`));
    return unwrapNezha(body);
  } catch (e) {
    if (e && e.name === "AbortError") throw new Error("Request timeout");
    throw e;
  } finally {
    clearTimeout(timer);
  }
}

function disconnectWS() {
  if (reconnectTimer) {
    clearTimeout(reconnectTimer);
    reconnectTimer = null;
  }
  if (ws) {
    try { ws.onopen = ws.onmessage = ws.onerror = ws.onclose = null; ws.close(); } catch {}
  }
  ws = null;
}

let wsAttempts = 0;
let wsEverOpened = false;

function connectWS() {
  disconnectWS();
  if (!baseURL || apiToken || !liveUpdates) return;
  if (wsAttempts >= 3) {
    wsDegraded = true;
    return;
  }
  let url;
  try {
    const u = new URL(baseURL);
    u.protocol = u.protocol === "https:" ? "wss:" : "ws:";
    u.pathname = "/api/v1/ws/server";
    u.search = "";
    u.hash = "";
    url = u.toString();
  } catch { return; }
  try {
    ws = new WebSocket(url);
  } catch {
    wsDegraded = true;
    return;
  }
  ws.onopen = () => {
    wsEverOpened = true;
    wsAttempts = 0;
    wsDegraded = false;
    $metrix.invalidate();
  };
  ws.onmessage = ev => {
    try {
      const frame = JSON.parse(String(ev.data || ""));
      servers = mergeServerFrame(servers, frame);
      loadedAt = Date.now();
      recordFleetSample();
      maybeNotify();
      $metrix.invalidate();
    } catch {}
  };
  ws.onerror = () => {};
  ws.onclose = () => {
    ws = null;
    wsAttempts += 1;
    wsDegraded = true;
    $metrix.invalidate();
    const generation = connectionGeneration;
    reconnectTimer = setTimeout(() => {
      reconnectTimer = null;
      if (generation === connectionGeneration) connectWS();
    }, Math.max(5000, refreshSec * 1000));
  };
}

function applyGroups(payload) {
  const idx = buildGroupIndex(payload);
  groups = idx.groups;
  byServerGroup = idx.byServer;
}

function applyServers(list) {
  servers = mergeServerList(servers, list);
}

function beginDomain(name) {
  if (inflightDomains.has(name)) return false;
  inflightDomains.add(name);
  inflight = true;
  return true;
}

function endDomain(name) {
  inflightDomains.delete(name);
  inflight = inflightDomains.size > 0;
  $metrix.invalidate();
  if (forcePending.delete(name)) void runDomain(name);
}

function runDomain(name) {
  if (name === "server") return refreshServers();
  if (name === "services") return refreshServices();
  if (name === "metadata") return refreshMetadata();
  if (name === "alerts") return refreshAlertRules();
  return Promise.resolve();
}

async function refreshServers() {
  if (!beginDomain("server")) return;
  const generation = connectionGeneration;
  try {
    const list = await nezhaFetch("/api/v1/server");
    if (generation !== connectionGeneration) return;
    applyServers(list);
    forceAuthHint = false;
    error = "";
    loadedAt = Date.now();
    lastServerRefresh = loadedAt;
    recordFleetSample(true);
    maybeNotify();
    hadSnapshot = true;
  } catch (e) {
    if (generation !== connectionGeneration) return;
    error = String(e && e.message || e);
    if (/unauthorized|401|ApiErrorUnauthorized/i.test(error) && !apiToken) forceAuthHint = true;
  } finally {
    endDomain("server");
  }
}

async function refreshServices() {
  if (!beginDomain("services")) return;
  const generation = connectionGeneration;
  try {
    const [list, overview] = await Promise.all([
      nezhaFetch("/api/v1/service/list").catch(() => []),
      nezhaFetch("/api/v1/service").catch(() => ({ services: {} })),
    ]);
    if (generation !== connectionGeneration) return;
    serviceRows = mergeServiceRows(list, overview);
    cycleTransfers = buildCycleTransfers(overview);
    lastServiceRefresh = Date.now();
    const traffic = detectTrafficThresholds(prevTrafficLevels, cycleTransfers);
    if (hadServiceSnapshot && trafficNotify) {
      for (const c of traffic.crossed) {
        const tag = `nezha-traffic-${c.id}-${c.level}`;
        sendNotification(
          T().trafficAlertTitle,
          `${c.serverName} · ${c.cycle} · ${c.pct.toFixed(1)}%`,
          tag
        );
        triggerNotchActivity(tag, 300000, true);
      }
    }
    prevTrafficLevels = traffic.nextLevels;
    maybeNotify();
    hadServiceSnapshot = true;
  } finally {
    endDomain("services");
  }
}

async function refreshMetadata() {
  if (!beginDomain("metadata")) return;
  const generation = connectionGeneration;
  try {
    const [nextSettings, groupPayload] = await Promise.all([
      nezhaFetch("/api/v1/setting"),
      nezhaFetch("/api/v1/server-group").catch(() => []),
    ]);
    if (generation !== connectionGeneration) return;
    settings = nextSettings || {};
    applyGroups(groupPayload);
    lastMetadataRefresh = Date.now();
  } catch (e) {
    if (generation === connectionGeneration) error = String(e && e.message || e);
  } finally {
    endDomain("metadata");
  }
}

async function refreshAlertRules() {
  if (!apiToken || !beginDomain("alerts")) return;
  const generation = connectionGeneration;
  try {
    const rules = await nezhaFetch("/api/v1/alert-rule").catch(() => []);
    if (generation !== connectionGeneration) return;
    alertRules = rules || [];
    lastAlertRefresh = Date.now();
  } finally {
    endDomain("alerts");
  }
}

function decodeUtf8(bytes) {
  try {
    if (typeof TextDecoder !== "undefined") return new TextDecoder("utf-8").decode(bytes);
  } catch {}
  try {
    if (typeof Buffer !== "undefined") return Buffer.from(bytes).toString("utf8");
  } catch {}
  let s = "";
  for (let i = 0; i < bytes.length; i += 1) s += String.fromCharCode(bytes[i]);
  return s;
}

async function fetchInboxPayload(entry) {
  if (!$metrix?.inbox) return null;
  const key = `${entry.inbox_id}:${entry.seq}`;
  if (inboxBodies.has(key)) return inboxBodies.get(key);
  let payload = null;
  if (entry.source === "email" && caps.inboxMessage && typeof $metrix.inbox.message === "function") {
    payload = await within($metrix.inbox.message(entry.inbox_id, entry.seq), 10000).catch(() => null);
  }
  if (!payload && typeof $metrix.inbox.read === "function") {
    const bytes = await within($metrix.inbox.read(entry.inbox_id, entry.seq), 10000).catch(() => null);
    if (bytes) payload = decodeUtf8(bytes);
  }
  if (payload != null) {
    inboxBodies.set(key, payload);
    while (inboxBodies.size > 40) inboxBodies.delete(inboxBodies.keys().next().value);
  }
  return payload;
}

async function refreshInbox(changedIds = null) {
  if (!caps.inboxBoxes || !isPlusSubscription() || !$metrix?.inbox || inboxInflight) return;
  inboxInflight = true;
  try {
    const boxes = await within($metrix.inbox.boxes(), 10000).catch(() => null);
    if (!Array.isArray(boxes)) return;
    inboxBoxes = boxes;
    const targetIds = Array.isArray(changedIds) && changedIds.length ? new Set(changedIds) : null;
    const prevByKey = new Map(inboxAlerts.map(a => [a.key, a]));
    const collected = [];
    for (const box of boxes) {
      if (targetIds && !targetIds.has(box.id)) {
        for (const existing of inboxAlerts) {
          if (existing.inboxId === box.id) collected.push(existing);
        }
        continue;
      }
      const list = await within($metrix.inbox.list(box.id, { limit: 25 }), 10000).catch(() => []);
      if (!Array.isArray(list)) continue;
      const arrived = trackInboxArrival(inboxStore.boxes, box.id, list);
      saveInboxStore();
      const arrivedSeqs = new Set(arrived.map(m => Number(m.seq)));
      for (const entry of list) {
        const key = `${entry.inbox_id}:${entry.seq}`;
        let payload = inboxBodies.get(key) ?? null;
        if (arrivedSeqs.has(Number(entry.seq)) && payload == null) {
          payload = await fetchInboxPayload(entry);
        }
        const parsed = parseInboxAlert(entry, payload);
        if (!parsed.body && prevByKey.has(key)) {
          const prev = prevByKey.get(key);
          parsed.body = prev.body;
          parsed.title = prev.title || parsed.title;
          parsed.serverName = prev.serverName || parsed.serverName;
          parsed.severity = prev.severity;
        }
        collected.push(parsed);
        if (arrivedSeqs.has(Number(entry.seq))) {
          const tag = `nezha-inbox-${parsed.key}`;
          sendNotification(
            parsed.serverName ? `${T().inboxAlertTitle} · ${parsed.serverName}` : T().inboxAlertTitle,
            `${parsed.title}${parsed.body ? `\n${parsed.body.slice(0, 140)}` : ""}`,
            tag
          );
          triggerNotchActivity(tag, 20000, false);
        }
      }
    }
    collected.sort((a, b) => (b.receivedAt - a.receivedAt) || (b.seq - a.seq));
    inboxAlerts = collected.slice(0, 50);
    lastInboxRefresh = Date.now();
    $metrix.invalidate();
  } finally {
    inboxInflight = false;
  }
}

async function loadInboxDetail(alert) {
  if (!alert || !$metrix?.inbox) return;
  if (inboxBodies.has(alert.key)) return;
  inboxLoadingKey = alert.key;
  $metrix.invalidate();
  try {
    const payload = await fetchInboxPayload({
      inbox_id: alert.inboxId,
      seq: alert.seq,
      source: alert.source,
      subject: alert.title,
      sender: alert.sender,
      received_at: alert.receivedAt,
    });
    if (payload != null) {
      const parsed = parseInboxAlert({
        inbox_id: alert.inboxId,
        seq: alert.seq,
        source: alert.source,
        subject: alert.title,
        sender: alert.sender,
        received_at: alert.receivedAt,
      }, payload);
      inboxAlerts = inboxAlerts.map(a => a.key === alert.key ? parsed : a);
    }
  } finally {
    if (inboxLoadingKey === alert.key) inboxLoadingKey = null;
    $metrix.invalidate();
  }
}

async function deleteInboxMessage(alert) {
  if (!alert || !caps.inboxRemove || !$metrix?.inbox?.remove) return;
  try {
    await within($metrix.inbox.remove(alert.inboxId, alert.seq), 10000);
    inboxAlerts = inboxAlerts.filter(a => a.key !== alert.key);
    inboxBodies.delete(alert.key);
    if (expandedInboxKey === alert.key) expandedInboxKey = null;
    $metrix.invalidate();
  } catch {}
}

function toggleInboxRead(alert) {
  const unread = isInboxUnread(inboxStore.boxes, alert.inboxId, alert.seq);
  if (setInboxRead(inboxStore.boxes, alert.inboxId, alert.seq, unread)) {
    saveInboxStore();
    $metrix.invalidate();
  }
}

async function refreshAll({ force = false } = {}) {
  if (!baseURL) return;
  if (force) {
    for (const name of inflightDomains) forcePending.add(name);
  }
  const now = Date.now();
  const initial = !lastServerRefresh;
  const wsHealthy = liveUpdates && !apiToken && ws && ws.readyState === 1 && !wsDegraded;
  const demand = readOutputs();
  const tasks = [];
  if (force || initial || now - lastServerRefresh >= (wsHealthy ? 30000 : refreshSec * 1000)) {
    tasks.push(refreshServers());
  }
  if (force || initial || now - lastServiceRefresh >= Math.max(15000, refreshSec * 1000)) {
    tasks.push(refreshServices());
  }
  if (force || initial || now - lastMetadataRefresh >= 300000) tasks.push(refreshMetadata());
  if (apiToken && (force || initial || now - lastAlertRefresh >= 60000)) tasks.push(refreshAlertRules());
  if (caps.inboxBoxes && isPlusSubscription() && (force || !lastInboxRefresh || now - lastInboxRefresh >= 120000)) {
    tasks.push(refreshInbox());
  }
  await Promise.all(tasks);
  if (liveUpdates && !apiToken && (!ws || ws.readyState > 1)) connectWS();

  const wantsServerWidgetLarge = widgetMode === "server" && (!demand.widgetKnown || demand.widgetFamilies.includes("large"));
  const wantsPanelDetails = !demand.known || demand.panel;
  const detailIds = new Set();
  if (selectedServerId && wantsPanelDetails) detailIds.add(String(selectedServerId));
  if (wantsServerWidgetLarge) {
    const selected = resolveWidgetServer(servers, widgetServer || selectedServerId || "");
    if (selected.status === "ok") detailIds.add(String(selected.server.id));
  }
  for (const id of detailIds) {
    const key = `${id}:${detailPeriod}`;
    const cached = metricsCache.get(key);
    if (!cached || !cached.loadedAt || Date.now() - cached.loadedAt > 60000) void loadMetrics(id);
  }
  $metrix.invalidate();
}

function launchRefresh() { void refreshAll({ force: true }); }

function maybeNotify() {
  const t = T();
  const now = Date.now();
  const nextOnline = new Set();
  for (const s of servers.values()) {
    if (isServerOnline(s, now)) nextOnline.add(String(s.id));
  }
  if (hadSnapshot && offlineNotify) {
    const { wentOffline } = detectTransitions(prevOnline, nextOnline);
    for (const id of wentOffline) {
      const s = servers.get(id);
      const tag = `nezha-off-${id}`;
      sendNotification(t.offlineAlertTitle, t.offlineAlertBody(s && s.name || id), tag);
      triggerNotchActivity(tag, 300000, true);
    }
  }
  prevOnline = nextOnline;
  const nextFail = new Set();
  for (const svc of serviceRows) {
    if (svc.failing) nextFail.add(String(svc.id));
  }
  if (hadServiceSnapshot && probeNotify) {
    for (const id of nextFail) {
      if (!prevFailing.has(id)) {
        const svc = serviceRows.find(x => String(x.id) === id);
        const tag = `nezha-probe-${id}`;
        sendNotification(t.probeAlertTitle, t.probeAlertBody(svc && svc.name || id), tag);
        triggerNotchActivity(tag, 300000, true);
      }
    }
  }
  prevFailing = nextFail;
  if (activeNotchActivity && activeNotchActivity.persistentAttention) {
    const attn = buildAttention({ servers: Array.from(servers.values()), services: serviceRows, alertRules, cycleTransfers, nowMs: now }).items;
    if (!attn.length) activeNotchActivity = null;
  }
}

function currentScoped(applySearch = false) {
  const scoped = scopedServers({
    servers,
    groupId: resolveGroupSelection(selectedGroup, groups),
    watchMode,
    watchlist,
    byServerGroup,
  });
  return applySearch && servers.size > 6 ? filterServers(scoped, serverQuery) : scoped;
}

function sortServers(list) {
  return sortServerList(list, sortBy, sortDir);
}

function toggleSort(column) {
  if (sortBy === column) {
    sortDir = sortDir === "desc" ? "asc" : "desc";
  } else {
    sortBy = column;
    sortDir = column === "name" ? "asc" : "desc";
  }
  localStorage.setItem("nezha.sort", sortBy);
  localStorage.setItem("nezha.sortDir", sortDir);
  $metrix.invalidate();
}

function capsuleBar(pctVal, colorHexOrToken, heightCls = "h-[3.5px]") {
  const p = Math.max(0, Math.min(100, Number(pctVal) || 0));
  const rounded = Number(p.toFixed(1));
  const widthStr = rounded % 1 === 0 ? String(rounded) : rounded.toFixed(1);
  const fillCls = String(colorHexOrToken || "").startsWith("#") ? `bg-[${colorHexOrToken}]` : `bg-${colorHexOrToken || "[#3b82f6]"}`;
  return h("Row", { tw: `${heightCls} w-full rounded-full bg-surfaceHover overflow-hidden` },
    rounded > 0 ? h("Box", { key: "progress-fill", tw: `h-full w-[${widthStr}%] rounded-full ${fillCls}` }) : null
  );
}

function statusDot(colorHexOrToken, size = 7) {
  const bgCls = String(colorHexOrToken || "").startsWith("#") ? `bg-[${colorHexOrToken}]` : `bg-${colorHexOrToken || "[#10b981]"}`;
  return h("Box", { tw: `size-[${size}px] rounded-full ${bgCls} shrink-0` });
}

function CompactToggle(items, value, onChange, keyPrefix) {
  return h(
    "Row",
    { tw: "p-[2px] rounded-[7px] bg-surfaceHover items-center gap-[2px] shrink-0" },
    items.map(it => {
      const active = it.value === value;
      return h(
        "Row",
        {
          key: `${keyPrefix}-${it.value}`,
          tw: `py-[3px] px-2.5 rounded-[5px] cursor-pointer items-center ${active ? "bg-background shadow-sm" : ""}`,
          onClick: () => { if (!active) onChange(it.value); },
        },
        TX(it.label, {
          tw: `text-[10.5px] leading-tight ${active ? "font-semibold text-text" : "font-medium text-textMuted"}`,
        })
      );
    })
  );
}

function setMetricsCache(key, value) {
  metricsCache.delete(key);
  metricsCache.set(key, value);
  while (metricsCache.size > 8) {
    metricsCache.delete(metricsCache.keys().next().value);
  }
}

function loadMetrics(serverId, period = detailPeriod) {
  const key = `${serverId}:${period}`;
  if (detailInflight.has(key)) return detailInflight.get(key);
  const generation = connectionGeneration;
  const prev = metricsCache.get(key) || {};
  setMetricsCache(key, { ...prev, loading: true, error: "" });
  $metrix.invalidate();
  const promise = (async () => {
    try {
      const metrics = ["cpu", "memory", "net_in_speed", "net_out_speed"];
      const qs = `period=${encodeURIComponent(period)}&aggregate=true`;
      const days = period === "7d" ? 7 : 1;
      const [metricResults, monitorsRes, onlineRes] = await Promise.all([
        Promise.all(metrics.map(m =>
          nezhaFetch(`/api/v1/server/${serverId}/metrics?metric=${m}&${qs}`).catch(() => null)
        )),
        nezhaFetch(`/api/v1/service/${serverId}?period=${encodeURIComponent(period)}`).catch(() => null),
        nezhaFetch(`/api/v1/server/${serverId}/online-history?days=${days}`).catch(() => null),
      ]);
      if (generation !== connectionGeneration) return;
      const series = {};
      metrics.forEach((m, i) => {
        const d = metricResults[i];
        series[m] = (d && Array.isArray(d.data_points)) ? d.data_points : [];
      });
      setMetricsCache(key, {
        loading: false,
        error: "",
        loadedAt: Date.now(),
        series,
        monitorRows: buildMonitorRows(monitorsRes),
        online: onlineRes || null,
      });
    } catch (e) {
      if (generation !== connectionGeneration) return;
      setMetricsCache(key, { loading: false, error: String(e && e.message || e), loadedAt: 0, series: {}, monitorRows: [], online: null });
    } finally {
      detailInflight.delete(key);
      if (generation === connectionGeneration) $metrix.invalidate();
    }
  })();
  detailInflight.set(key, promise);
  return promise;
}

function chartFromPoints(pts, name, color) {
  if (!Array.isArray(pts) || !pts.length) return null;
  const tail = pts.slice(-120);
  return {
    name,
    color,
    points: tail.map(p => ({ x: Number(p.ts) || 0, y: Number(p.value) || 0 })),
  };
}

function resolveEffectiveServerView(isWide) {
  if (viewOverride === "cards" || viewOverride === "table") return viewOverride;
  if (serverViewPref === "cards" || serverViewPref === "table") return serverViewPref;
  return isWide ? "table" : "cards";
}

function unreadInboxCount() {
  return inboxAlerts.reduce((acc, a) => acc + (isInboxUnread(inboxStore.boxes, a.inboxId, a.seq) ? 1 : 0), 0);
}

function totalAlertBadgeCount() {
  const attn = buildAttention({ servers: currentScoped(), services: serviceRows, alertRules, cycleTransfers, nowMs: Date.now() }).items;
  return attn.length + unreadInboxCount();
}

function iconActionBtn({ key, svg, onClick, disabled, tooltip, active = false, busy = false }) {
  return h("Column", {
    key,
    onClick: disabled ? undefined : onClick,
    tooltip,
    tw: `w-7 h-7 rounded-[7px] items-center justify-center shrink-0 ${disabled ? "opacity-40" : "cursor-pointer hover:bg-surfaceHover pressed:bg-surfacePressed"} ${active ? "bg-surfaceHover" : ""}`,
  },
    h("Icon", {
      svg,
      tw: `size-[14px] ${active ? "text-[#0a94f2]" : "text-textMuted"}`,
      ...(busy ? {
        keyframes: {
          duration: 900,
          repeat: -1,
          ease: "linear",
          frames: [{ at: 0, rotate: 0 }, { at: 1, rotate: 360 }],
        },
      } : {}),
    })
  );
}

function brandHeader(isWide = false) {
  const t = T();
  const site = (settings && settings.config && settings.config.site_name) || "Nezha";
  const isLive = !(apiToken || !liveUpdates || wsDegraded);
  const effectiveView = resolveEffectiveServerView(isWide);
  return h(
    "Row",
    { tw: "items-center gap-2 w-full min-w-0" },
    h("Icon", { svg: BRAND, tw: "size-[19px] text-[#0a94f2] shrink-0" }),
    TX(site === "Nezha" ? "Nezha" : site, { tw: "text-sm font-bold leading-tight truncate min-w-0 shrink" }),
    loadedAt ? h("Row", {
      tw: `items-center gap-1 py-0.5 px-2 rounded-full shrink-0 ${isLive ? "bg-[#10b9811a]" : "bg-surfaceHover"}`,
    },
      statusDot(isLive ? PAL.emerald : PAL.sky, 5),
      TX(`${isLive ? "Live" : "REST"} · ${formatClockTime(loadedAt)}`, {
        tw: `text-[10px] font-medium tabular-nums ${isLive ? "text-[#10b981]" : "text-textMuted"}`,
      })
    ) : null,
    h("Spacer"),
    activeTab === "servers" && loadedAt ? iconActionBtn({
      key: "toggle-view",
      svg: effectiveView === "table" ? ICONS.grid : ICONS.table,
      tooltip: effectiveView === "table" ? t.viewCards : t.viewTable,
      active: effectiveView === "table",
      onClick: () => {
        viewOverride = effectiveView === "table" ? "cards" : "table";
        localStorage.setItem("nezha.view", viewOverride);
        $metrix.invalidate();
      },
    }) : null,
    iconActionBtn({
      key: "btn-refresh",
      svg: ICONS.refresh,
      tooltip: t.refresh,
      disabled: !baseURL,
      busy: inflight,
      onClick: launchRefresh,
    }),
    iconActionBtn({
      key: "btn-open",
      svg: ICONS.external,
      tooltip: t.openNezha,
      disabled: !baseURL,
      onClick: () => {
        if (!baseURL) return;
        try { $metrix.openURL(baseURL); } catch {}
      },
    })
  );
}

function topTabs() {
  const t = T();
  const badge = totalAlertBadgeCount();
  return h("Segmented", {
    key: "main-tabs",
    items: [
      { label: t.tabServers, value: "servers" },
      { label: t.tabServices, value: "services" },
      { label: t.tabTraffic, value: "traffic" },
      { label: badge > 0 ? `${t.tabAlerts} (${badge})` : t.tabAlerts, value: "alerts" },
    ],
    value: activeTab,
    onChange: v => {
      activeTab = String(v || "servers");
      if (activeTab !== "servers") selectedServerId = null;
      localStorage.setItem("nezha.tab", activeTab);
      $metrix.invalidate();
    },
  });
}

function statCell(value, label, color, key, sizeCls = "text-[18px]") {
  const colorTw = !color || color === "text"
    ? "text-text"
    : String(color).startsWith("#") ? `text-[${color}]` : `text-${color}`;
  return h(
    "Column",
    { key, tw: "gap-0.5 grow basis-0 min-w-0" },
    TX(value, { tw: `${sizeCls} font-bold leading-tight tabular-nums truncate ${colorTw}` }),
    TX(label, { tw: "text-[10.5px] text-textMuted leading-tight truncate" })
  );
}

function tintedStatTile({ key, label, value, valueColor = "text", tintHex = PAL.blue, sub = "" }) {
  const valTw = valueColor === "text"
    ? "text-text"
    : String(valueColor).startsWith("#") ? `text-[${valueColor}]` : `text-${valueColor}`;
  return h("Column", {
    key,
    tw: `gap-1 py-2.5 px-3 rounded-xl border border-${cardBorder()} bg-background grow basis-0 min-w-0`,
    linearGradient: { from: `${tintHex}12`, to: "background", angle: 135 },
  },
    TX(label, { tw: "text-[10.5px] font-medium text-textMuted leading-tight truncate" }),
    TX(value, { tw: `text-[19px] font-bold leading-tight tabular-nums truncate ${valTw}`, contentTransition: { numeric: true } }),
    sub ? TX(sub, { tw: "text-[10px] text-textMuted tabular-nums truncate" }) : null
  );
}

function kpiSparkTile({ key, label, value, valueColor = "text", tintHex = PAL.blue, sparkKey, sparkColor, progressPct, progressHex }) {
  const pts = sparkKey ? buildSparkPoints(fleetHistory, sparkKey, 30) : [];
  const valTw = valueColor === "text"
    ? "text-text"
    : String(valueColor).startsWith("#") ? `text-[${valueColor}]` : `text-${valueColor}`;
  return h(
    "Column",
    {
      key,
      tw: `justify-between gap-1.5 py-2.5 px-2.5 rounded-xl border border-${cardBorder()} bg-background grow basis-0 min-w-0`,
      linearGradient: { from: `${tintHex}12`, to: "background", angle: 135 },
    },
    TX(label, { tw: "text-[10px] font-medium text-textMuted leading-none truncate" }),
    TX(value, { tw: `text-[15.5px] font-bold leading-none tabular-nums truncate ${valTw}`, contentTransition: { numeric: true } }),
    progressPct != null
      ? capsuleBar(progressPct, progressHex || PAL.emerald, "h-[3.5px]")
      : pts.length > 1
        ? h("Chart", {
            type: "area",
            height: 20,
            tw: "w-full h-[20px]",
            curve: "monotone",
            grid: false,
            legend: false,
            axes: false,
            hover: false,
            strokeWidth: 1.4,
            series: [{ name: sparkKey, color: sparkColor || PAL.sky, points: pts }],
          })
        : h("Box", { tw: "h-[3.5px] w-full rounded-full bg-surfaceHover" })
  );
}

function overviewCard() {
  const t = T();
  const scoped = currentScoped(true);
  const s = summarizeScoped(scoped);
  const unfilteredTotal = currentScoped().length;
  const searchActive = servers.size > 6 && serverQuery.trim() && s.total !== unfilteredTotal;
  const probesDown = serviceRows.filter(r => r.failing).length;
  const issues = s.offline + probesDown;
  const onlineRate = s.total > 0 ? (s.online / s.total) * 100 : 0;
  const cpuHex = barHex(s.avgCpu, PAL.blue);
  return h(
    "Column",
    { tw: "gap-2 w-full" },
    h("Row", { tw: "gap-2 w-full items-stretch" },
      kpiSparkTile({
        key: "ov-online",
        label: searchActive ? `${t.online} · ${s.total}/${unfilteredTotal}` : t.online,
        value: `${s.online}/${s.total}`,
        valueColor: s.offline > 0 ? PAL.amber : PAL.emerald,
        tintHex: s.offline > 0 ? PAL.amber : PAL.emerald,
        progressPct: onlineRate,
        progressHex: s.offline > 0 ? PAL.amber : PAL.emerald,
      }),
      kpiSparkTile({
        key: "ov-down",
        label: t.downRate,
        value: `↓${formatRate(s.netDown, true)}`,
        valueColor: "text",
        tintHex: PAL.sky,
        sparkKey: "down",
        sparkColor: PAL.sky,
      }),
      kpiSparkTile({
        key: "ov-up",
        label: t.upRate,
        value: `↑${formatRate(s.netUp, true)}`,
        valueColor: "text",
        tintHex: PAL.emerald,
        sparkKey: "up",
        sparkColor: PAL.emerald,
      }),
      kpiSparkTile({
        key: "ov-cpu",
        label: t.avgCpu,
        value: `${s.avgCpu.toFixed(0)}%`,
        valueColor: s.avgCpu >= 80 ? cpuHex : "text",
        tintHex: cpuHex,
        sparkKey: "cpu",
        sparkColor: cpuHex,
      })
    ),
    h("Row", { tw: "items-center gap-2 px-0.5 w-full" },
      TX(t.transfer, { tw: "text-[10.5px] text-textMuted shrink-0" }),
      TX(`↓${formatBytes(s.transferDown, 1, true)}`, { tw: "text-[10.5px] font-semibold tabular-nums text-text" }),
      TX(`↑${formatBytes(s.transferUp, 1, true)}`, { tw: "text-[10.5px] font-semibold tabular-nums text-text" }),
      h("Spacer"),
      issues > 0
        ? h("Row", { tw: "items-center gap-1 py-0.5 px-2 rounded-full bg-[#ef44441a] shrink-0" },
            statusDot(PAL.red, 5),
            TX(`${s.offline} ${t.offline}${probesDown ? ` · ${probesDown} probe` : ""}`, { tw: "text-[10px] font-semibold text-[#ef4444] tabular-nums" })
          )
        : TX(`${onlineRate.toFixed(0)}% · ${t.allOnline}`, { tw: "text-[10.5px] text-textMuted tabular-nums shrink-0" })
    )
  );
}

function serversToolbar(isTableMode = false) {
  const t = T();
  const groupItems = [{ label: t.all, value: "all" }, ...groups.map(g => ({ label: g.name, value: g.id }))];
  const groupValue = resolveGroupSelection(selectedGroup, groups);
  const selectGroup = v => {
    selectedGroup = String(v || "all");
    localStorage.setItem("nezha.group", selectedGroup);
    $metrix.invalidate();
  };
  return h("Column", { tw: "gap-2 w-full" },
    groupItems.length > 1 ? h(groupItems.length > 8 ? "Select" : "Segmented", {
      key: "groups",
      items: groupItems,
      value: groupValue,
      onChange: selectGroup,
    }) : null,
    servers.size > 6 ? h("SearchField", {
      key: "server-search",
      value: serverQuery,
      placeholder: t.searchPlaceholder,
      onChange: v => { serverQuery = String(v || ""); $metrix.invalidate(); },
    }) : null,
    h("Row", { tw: "gap-2 items-center w-full" },
      CompactToggle(
        [{ label: t.all, value: "all" }, { label: `${t.starred}${watchlist.size ? ` ${watchlist.size}` : ""}`, value: "starred" }],
        watchMode,
        v => { watchMode = String(v || "all"); localStorage.setItem("nezha.watchMode", watchMode); $metrix.invalidate(); },
        "watch"
      ),
      h("Spacer"),
      !isTableMode ? CompactToggle(
        [{ label: t.sortCpu, value: "cpu" }, { label: t.sortNet, value: "net" }, { label: t.sortName, value: "name" }],
        ["cpu", "net", "name"].includes(sortBy) ? sortBy : "cpu",
        v => {
          const next = String(v || "cpu");
          sortBy = next;
          sortDir = next === "name" ? "asc" : "desc";
          localStorage.setItem("nezha.sort", sortBy);
          localStorage.setItem("nezha.sortDir", sortDir);
          $metrix.invalidate();
        },
        "sort"
      ) : null
    )
  );
}

function miniBarMetric(label, pctVal, online, normalHex) {
  const color = online ? barHex(pctVal, normalHex) : "surfaceHover";
  return h("Column", { tw: "gap-1 grow basis-0 min-w-0" },
    h("Row", { tw: "items-center justify-between w-full" },
      TX(label, { tw: "text-[9.5px] text-textMuted font-medium" }),
      TX(`${pctVal.toFixed(0)}%`, { tw: `text-[10.5px] font-semibold tabular-nums ${metricValueTw(pctVal, online)}` })
    ),
    capsuleBar(pctVal, color, "h-[3px]")
  );
}

function serverCard(s, isSelected = false) {
  const t = T();
  const st = s.state || {};
  const host = s.host || {};
  const on = isServerOnline(s);
  const id = String(s.id);
  const starred = watchlist.has(id);
  const memPct = pct(st.mem_used, host.mem_total);
  const diskPct = pct(st.disk_used, host.disk_total);
  const cpuPct = Math.max(0, Math.min(100, Number(st.cpu) || 0));
  const cc = String(s.country_code || host.country_code || "").trim().toUpperCase();
  const borderCls = isSelected ? "border-[#3b82f6]" : (!on ? "border-[#ef444466]" : `border-${cardBorder()}`);
  return h(
    "Column",
    {
      key: `srv-${id}`,
      tw: `gap-2.5 p-3 rounded-xl bg-background border ${borderCls} grow basis-0 min-w-0 cursor-pointer hover:bg-surfaceHover pressed:bg-surfacePressed`,
      onClick: () => {
        selectedServerId = id;
        void loadMetrics(id);
        $metrix.invalidate();
      },
    },
    h("Row", { tw: "items-center gap-1.5 w-full" },
      statusDot(on ? PAL.emerald : PAL.red, 7),
      TX(s.name || id, { tw: "text-[12.5px] font-semibold text-text truncate grow min-w-0" }),
      cc ? TX(cc, { tw: "text-[9px] font-semibold text-textMuted px-1.5 py-0.5 rounded bg-surfaceHover shrink-0" }) : null,
      h("Column", {
        tw: "w-5 h-5 items-center justify-center rounded-[5px] shrink-0 cursor-pointer hover:bg-surfacePressed",
        onClick: e => {
          if (e && e.stopPropagation) e.stopPropagation();
          if (starred) watchlist.delete(id); else watchlist.add(id);
          persistWatch();
          $metrix.invalidate();
        },
      },
        h("Icon", { svg: starred ? ICONS.starFilled : ICONS.star, tw: `size-[11px] ${starred ? "text-[#f59e0b]" : "text-textMuted"}` })
      )
    ),
    h("Row", { tw: "gap-2.5 w-full" },
      miniBarMetric("CPU", cpuPct, on, PAL.blue),
      miniBarMetric("MEM", memPct, on, PAL.sky),
      miniBarMetric("DSK", diskPct, on, PAL.slate)
    ),
    h("Row", { tw: "items-center gap-1.5 w-full" },
      TX(`↓${formatRate(st.net_in_speed, true)}`, { tw: "text-[10px] tabular-nums text-textMuted" }),
      TX(`↑${formatRate(st.net_out_speed, true)}`, { tw: "text-[10px] tabular-nums text-textMuted" }),
      h("Spacer"),
      TX(on ? `L ${Number(st.load_1 || 0).toFixed(2)}` : `${t.offline} · ${formatRelativeTime(s.last_active, Date.now(), locale)}`, {
        tw: `text-[10px] tabular-nums ${on ? "text-textMuted" : "text-[#ef4444] font-medium"}`,
      })
    )
  );
}

function tableHeaderCell(label, colKey, widthCls, alignEnd = true) {
  const active = sortBy === colKey;
  return h("Row", {
    key: `th-${colKey}`,
    tw: `items-center gap-0.5 ${alignEnd ? "justify-end" : "justify-start"} ${widthCls} cursor-pointer`,
    onClick: () => toggleSort(colKey),
  },
    TX(label, { tw: `text-[10px] font-semibold ${active ? "text-[#0a94f2]" : "text-textMuted"} truncate` }),
    active ? h("Icon", { svg: sortDir === "asc" ? ICONS.chevronUp : ICONS.chevronDown, tw: "size-[10px] text-[#0a94f2] shrink-0" }) : null
  );
}

function serverTable(list, selectedId, compact = false) {
  const t = T();
  const header = h("Row", { tw: "items-center gap-2 px-3 py-2 w-full bg-surfaceHover" },
    tableHeaderCell(t.colNode, "name", "grow min-w-0", false),
    tableHeaderCell(t.sortCpu, "cpu", "w-[40px] shrink-0", true),
    tableHeaderCell(t.sortMem, "mem", "w-[40px] shrink-0", true),
    !compact ? tableHeaderCell(t.sortDisk, "disk", "w-[40px] shrink-0", true) : null,
    tableHeaderCell(t.sortDown, "down", "w-[58px] shrink-0", true),
    tableHeaderCell(t.sortUp, "up", "w-[58px] shrink-0", true),
    !compact ? tableHeaderCell(t.sortLoad, "load", "w-[42px] shrink-0", true) : null
  );
  const rows = [];
  list.forEach((s, idx) => {
    const st = s.state || {};
    const host = s.host || {};
    const on = isServerOnline(s);
    const id = String(s.id);
    const starred = watchlist.has(id);
    const selected = String(selectedId || "") === id;
    const cpuPct = Math.max(0, Math.min(100, Number(st.cpu) || 0));
    const memPct = pct(st.mem_used, host.mem_total);
    const diskPct = pct(st.disk_used, host.disk_total);
    if (idx > 0) rows.push(h("Box", { key: `sep-${id}`, tw: `h-px w-full bg-${cardBorder()}` }));
    rows.push(h("Row", {
      key: `srv-${id}`,
      tw: `items-center gap-2 px-3 h-[34px] w-full cursor-pointer hover:bg-surfaceHover pressed:bg-surfacePressed ${selected ? "bg-[#3b82f614]" : ""}`,
      onClick: () => {
        selectedServerId = id;
        void loadMetrics(id);
        $metrix.invalidate();
      },
    },
      h("Row", { tw: "items-center gap-1.5 grow min-w-0" },
        statusDot(on ? PAL.emerald : PAL.red, 6),
        h("Column", {
          tw: "size-[16px] items-center justify-center shrink-0 cursor-pointer",
          onClick: e => {
            if (e && e.stopPropagation) e.stopPropagation();
            if (starred) watchlist.delete(id); else watchlist.add(id);
            persistWatch();
            $metrix.invalidate();
          },
        },
          h("Icon", { svg: starred ? ICONS.starFilled : ICONS.star, tw: `size-[10px] ${starred ? "text-[#f59e0b]" : "text-textMuted"}` })
        ),
        TX(s.name || id, { tw: `text-[11.5px] ${selected ? "font-bold text-[#0a94f2]" : "font-medium text-text"} truncate` })
      ),
      TX(on ? `${cpuPct.toFixed(0)}%` : "—", { tw: `w-[40px] shrink-0 text-right text-[11px] font-semibold tabular-nums ${metricValueTw(cpuPct, on)}` }),
      TX(on ? `${memPct.toFixed(0)}%` : "—", { tw: `w-[40px] shrink-0 text-right text-[11px] tabular-nums ${metricValueTw(memPct, on)}` }),
      !compact ? TX(on ? `${diskPct.toFixed(0)}%` : "—", { tw: `w-[40px] shrink-0 text-right text-[11px] tabular-nums ${metricValueTw(diskPct, on)}` }) : null,
      TX(on ? formatRate(st.net_in_speed, true) : "—", { tw: "w-[58px] shrink-0 text-right text-[10.5px] tabular-nums text-textMuted" }),
      TX(on ? formatRate(st.net_out_speed, true) : "—", { tw: "w-[58px] shrink-0 text-right text-[10.5px] tabular-nums text-textMuted" }),
      !compact ? TX(on ? Number(st.load_1 || 0).toFixed(2) : t.offline, { tw: `w-[42px] shrink-0 text-right text-[10.5px] tabular-nums ${on ? "text-textMuted" : "text-[#ef4444]"}` }) : null
    ));
  });
  return [h("Column", { key: "server-table", tw: `rounded-xl bg-background border border-${cardBorder()} overflow-hidden w-full` }, header, Line(), ...rows)];
}

function chunk(list, size) {
  const out = [];
  for (let i = 0; i < list.length; i += size) out.push(list.slice(i, i + size));
  return out;
}

function serverGrid(list, selectedId) {
  return chunk(list, 2).map((row, i) => {
    const cells = row.map(s => serverCard(s, String(selectedId || "") === String(s.id)));
    if (row.length === 1) cells.push(h("Box", { key: `ph-${i}`, tw: "grow basis-0 min-w-0" }));
    return h("Row", { key: `row-${i}`, tw: "gap-2.5 w-full items-start" }, ...cells);
  });
}

function panelShell(header, body, { width = 520, height, isWide = false } = {}) {
  const statusBody = [
    ...body,
    error && loadedAt ? h("Row", { tw: "gap-2 py-2 px-3 rounded-xl bg-surfaceHover items-center w-full" },
      statusDot(PAL.red, 6),
      TX(error, { tw: "text-[11px] text-[#ef4444] grow min-w-0 line-clamp-1" }),
      h("Button", { text: T().retry, onClick: launchRefresh, tw: "text-[10.5px]" })
    ) : null,
  ];
  const rootProps = {
    preferredWidth: isWide ? Math.max(920, width) : width,
    fill: true,
    minHeight: 0,
    safeArea: true,
    tw: "gap-0 text-text",
  };
  if (height != null && !isWide) rootProps.preferredHeight = height;
  return h(
    "Column",
    rootProps,
    h("Column", { tw: "gap-2.5 px-4 pt-3 pb-2.5 w-full" }, ...header),
    Line(),
    h(
      "Scroll",
      { grow: 1, minHeight: 0, fillWidth: true, tw: "px-4 py-3" },
      h("Column", { tw: "gap-2.5 w-full" }, ...statusBody)
    )
  );
}

function metricChartCard(title, legendItems, charts, type, height = 140) {
  return h("Column", { tw: `gap-2 py-3 px-3.5 rounded-xl bg-background border border-${cardBorder()} w-full` },
    h("Row", { tw: "items-center gap-2 w-full" },
      TX(title, { tw: "text-[11.5px] font-semibold text-textMuted" }),
      h("Spacer"),
      ...legendItems.map((lg, i) => h("Row", { key: `lg-${i}`, tw: "items-center gap-1" },
        statusDot(lg.color, 6),
        TX(lg.label, { tw: "text-[10px] text-textMuted" })
      ))
    ),
    h("Chart", {
      tw: `w-full h-[${height}px]`,
      type: type || "area",
      xKind: "time",
      curve: "monotone",
      grid: true,
      legend: false,
      series: charts,
    })
  );
}

function formatServerSummaryText(s) {
  const st = s.state || {};
  const host = s.host || {};
  const on = isServerOnline(s);
  const memPct = pct(st.mem_used, host.mem_total).toFixed(1);
  const diskPct = pct(st.disk_used, host.disk_total).toFixed(1);
  return [
    `${s.name || s.id} (#${s.id}) — ${on ? "Online" : "Offline"}`,
    `OS: ${host.platform || "?"} ${host.platform_version || ""} ${host.arch || ""}`.trim(),
    `CPU: ${Number(st.cpu || 0).toFixed(1)}% | MEM: ${memPct}% (${formatBytes(st.mem_used)} / ${formatBytes(host.mem_total)}) | DISK: ${diskPct}%`,
    `Net: ↓${formatRate(st.net_in_speed)} ↑${formatRate(st.net_out_speed)} | Transfer: ↓${formatBytes(st.net_in_transfer, 1, true)} ↑${formatBytes(st.net_out_transfer, 1, true)}`,
    `Load: ${Number(st.load_1 || 0).toFixed(2)} / ${Number(st.load_5 || 0).toFixed(2)} / ${Number(st.load_15 || 0).toFixed(2)}`,
  ].join("\n");
}

function serverDetailBody(s) {
  const t = T();
  const st = s.state || {};
  const host = s.host || {};
  const id = String(s.id);
  const starred = watchlist.has(id);
  const key = `${s.id}:${detailPeriod}`;
  const cache = metricsCache.get(key) || {};
  const series = cache.series || {};
  const cpu = chartFromPoints(series.cpu, "CPU %", PAL.blue);
  const memPts = (series.memory || []).map(p => ({ ts: p.ts, value: host.mem_total ? (Number(p.value) / host.mem_total) * 100 : Number(p.value) }));
  const mem = chartFromPoints(memPts, "Mem %", PAL.indigo);
  const netIn = chartFromPoints(series.net_in_speed, "↓ B/s", PAL.sky);
  const netOut = chartFromPoints(series.net_out_speed, "↑ B/s", PAL.emerald);
  const resourceCharts = [cpu, mem].filter(Boolean);
  const networkCharts = [netIn, netOut].filter(Boolean);
  const memPct = pct(st.mem_used, host.mem_total);
  const diskPct = pct(st.disk_used, host.disk_total);
  const monitorRows = cache.monitorRows || [];
  const latencyCharts = monitorRows
    .filter(r => r.points.length)
    .slice(0, 8)
    .map(r => ({ name: r.name, points: r.points.slice(-120).map(p => ({ x: p.ts, y: p.value })) }));
  const days = detailPeriod === "7d" ? 7 : 1;
  const online = cache.online ? buildOnlineSummary(cache.online, days * 86400) : null;
  const on = isServerOnline(s);

  const monitorCard = r => h(
    "Column",
    { key: `mon-${r.id}`, tw: `gap-0.5 p-2.5 rounded-xl bg-background border border-${cardBorder()} grow basis-0 min-w-0` },
    h("Row", { tw: "items-center gap-1 w-full" },
      TX(r.name, { tw: "text-[10.5px] font-medium text-textMuted truncate" }),
      h("Spacer"),
      TX(r.lossPct > 0 ? `${r.lossPct.toFixed(1)}%` : "", {
        tw: `text-[9.5px] tabular-nums ${r.lossPct >= 5 ? "text-[#ef4444]" : "text-[#f59e0b]"}`,
      })
    ),
    TX(r.delay != null ? `${r.delay.toFixed(1)} ms` : "—", {
      tw: `text-[13px] font-bold tabular-nums ${r.delay == null ? "text-[#ef4444]" : "text-text"}`,
    })
  );
  const monitorGrid = chunk(monitorRows, 2).map((row, i) => {
    const cells = row.map(monitorCard);
    if (row.length === 1) cells.push(h("Box", { key: `mon-ph-${i}`, tw: "grow basis-0 min-w-0" }));
    return h("Row", { key: `mon-row-${i}`, tw: "gap-2 w-full items-start" }, ...cells);
  });

  const dayHex = c => c === "success" ? PAL.emerald : c === "warning" ? PAL.amber : PAL.red;

  const onlineSection = online
    ? h("Column", { tw: `gap-2.5 py-3 px-3.5 rounded-xl bg-background border border-${cardBorder()} w-full` },
        TX(t.onlineSec, { tw: "text-[11.5px] font-semibold text-textMuted" }),
        h("Row", { tw: "items-end gap-3 w-full" },
          statCell(`${online.ratePct.toFixed(1)}%`, t.onlineRate, online.ratePct >= 99 ? PAL.emerald : online.ratePct >= 95 ? PAL.amber : PAL.red, "on-rate", "text-[17px]"),
          statCell(formatDuration(online.onlineSeconds), t.totalOnline, "text", "on-up", "text-[17px]"),
          statCell(formatDuration(online.offlineSeconds), t.totalOffline, online.offlineSeconds > 300 ? PAL.red : online.offlineSeconds > 60 ? PAL.amber : "textMuted", "on-down", "text-[17px]"),
          statCell(online.lastActive ? formatMonthDayTime(online.lastActive) : "—", t.lastActive, "textMuted", "on-last", "text-[12.5px]")
        ),
        online.daily.length
          ? h("Column", { tw: "gap-1.5 pt-1 w-full" },
              TX(t.dailyOnline, { tw: "text-[10px] text-textMuted" }),
              ...buildDailyOnlineRows(online.daily, Date.now(), { start: online.windowStart, end: online.windowEnd }).slice(-7).map((d, i) => h("Row", { key: `day-${i}`, tw: "items-center gap-2.5 w-full" },
                TX(d.date.slice(5), { tw: "text-[10px] tabular-nums text-textMuted w-[38px] shrink-0", noWrap: true }),
                h("Box", { tw: "grow min-w-0" }, capsuleBar(d.pct, dayHex(d.color), "h-[4px]")),
                TX(`${formatDailyDuration(d.onlineSeconds)}${d.isToday ? " · " + t.inProgress : ""}`, {
                  tw: `text-[10px] tabular-nums shrink-0 text-right ${d.isToday ? "text-[#0a94f2] font-medium" : "text-textMuted"}`,
                  noWrap: true,
                })
              ))
            )
          : null
      )
    : null;

  const detailActions = h("Row", { tw: "items-center gap-1.5 w-full min-w-0" },
    statusDot(on ? PAL.emerald : PAL.red, 8),
    TX(s.name || id, { tw: "text-[13.5px] font-bold text-text truncate grow min-w-0" }),
    iconActionBtn({
      key: `detail-star-${id}`,
      svg: starred ? ICONS.starFilled : ICONS.star,
      active: starred,
      onClick: () => {
        if (starred) watchlist.delete(id); else watchlist.add(id);
        persistWatch();
        $metrix.invalidate();
      },
    }),
    iconActionBtn({
      key: `detail-copy-${id}`,
      svg: ICONS.copy,
      tooltip: t.copy,
      onClick: () => { void copyText(formatServerSummaryText(s)); },
    }),
    CompactToggle(
      [{ label: t.period1d, value: "1d" }, { label: t.period7d, value: "7d" }],
      detailPeriod,
      v => {
        detailPeriod = String(v || "1d");
        localStorage.setItem("nezha.period", detailPeriod);
        void loadMetrics(s.id);
        $metrix.invalidate();
      },
      "period"
    )
  );

  const factRow = (label, value) => h("Column", { tw: "gap-0.5 grow basis-0 min-w-0" },
    TX(label, { tw: "text-[10px] text-textMuted" }),
    TX(value, { tw: "text-[11px] font-medium text-text tabular-nums truncate" })
  );

  const cpuVal = Number(st.cpu || 0);
  return {
    detailActions,
    nodes: [
      h("Column", {
        tw: `gap-2.5 py-3 px-3.5 rounded-xl bg-background border border-${cardBorder()} w-full`,
        linearGradient: { from: `${on ? PAL.blue : PAL.red}0d`, to: "background", angle: 135 },
      },
        h("Row", { tw: "items-end gap-3 w-full" },
          statCell(`${cpuVal.toFixed(0)}%`, "CPU", cpuVal >= 80 ? barHex(cpuVal) : "text", "d-cpu"),
          statCell(`${memPct.toFixed(0)}%`, "MEM", memPct >= 80 ? barHex(memPct) : "text", "d-mem"),
          statCell(`${diskPct.toFixed(0)}%`, "DISK", diskPct >= 80 ? barHex(diskPct) : "text", "d-disk"),
          statCell(on ? t.online : t.offline, t.onlineSec, on ? PAL.emerald : PAL.red, "d-online", "text-[16px]")
        ),
        Line(),
        h("Row", { tw: "gap-3 w-full" },
          factRow(t.osLabel, `${host.platform || "?"} ${host.platform_version || ""} · ${host.arch || ""}`),
          factRow(t.load, `${Number(st.load_1 || 0).toFixed(2)} / ${Number(st.load_5 || 0).toFixed(2)} / ${Number(st.load_15 || 0).toFixed(2)}`)
        ),
        h("Row", { tw: "gap-3 w-full" },
          factRow(t.netLabel, `↓ ${formatRate(st.net_in_speed)} · ↑ ${formatRate(st.net_out_speed)}`),
          factRow(t.transfer, `↓${formatBytes(st.net_in_transfer, 1, true)}  ↑${formatBytes(st.net_out_transfer, 1, true)}`)
        )
      ),
      cache.loading ? h("Row", { tw: "items-center gap-2 px-1" }, h("Spinner", { tw: "size-[12px]" }), TX(t.loading, { tw: "text-[11.5px] text-textMuted" })) : null,
      cache.error ? h("Row", { tw: "items-center gap-2 py-2 px-3 rounded-xl bg-surfaceHover" },
        TX(cache.error, { tw: "text-[11.5px] text-[#ef4444] grow min-w-0" }),
        h("Button", { text: t.retry, onClick: () => { void loadMetrics(s.id); }, tw: "text-[10px]" })
      ) : null,
      resourceCharts.length ? metricChartCard(t.resourceChart, [{ label: "CPU", color: PAL.blue }, { label: "MEM", color: PAL.indigo }], resourceCharts, "area", 140) : null,
      networkCharts.length ? metricChartCard(t.networkChart, [{ label: t.downRate, color: PAL.sky }, { label: t.upRate, color: PAL.emerald }], networkCharts, "line", 140) : null,
      monitorRows.length
        ? h("Column", { tw: "gap-2 w-full" },
            latencyCharts.length
              ? metricChartCard(t.latency, [], latencyCharts, "line", 136)
              : TX(t.latency, { tw: "text-[11px] font-semibold text-textMuted px-1" }),
            ...monitorGrid
          )
        : (!cache.loading && cache.monitorRows ? TX(t.latencyEmpty, { tw: "text-[11px] text-textMuted px-1" }) : null),
      onlineSection,
      !cache.loading && !resourceCharts.length && !networkCharts.length
        ? TX(t.noMetrics, { tw: "text-[11.5px] text-textMuted px-1" })
        : null,
    ].filter(Boolean),
  };
}

function serverDetail(s) {
  const t = T();
  const { detailActions, nodes } = serverDetailBody(s);
  return panelShell(
    [
      brandHeader(false),
      h("Row", { tw: "items-center gap-1.5 w-full" },
        iconActionBtn({
          key: "detail-back",
          svg: ICONS.back,
          tooltip: t.back,
          onClick: () => { selectedServerId = null; $metrix.invalidate(); },
        }),
        h("Row", { tw: "grow min-w-0" }, detailActions)
      ),
    ],
    nodes
  );
}

function serversPanel(viewportWidth = 0) {
  const t = T();
  const isWide = viewportWidth >= 860;
  const list = sortServers(currentScoped(true));
  const effectiveView = resolveEffectiveServerView(isWide);

  if (!isWide && selectedServerId) {
    const s = servers.get(String(selectedServerId));
    if (s) return serverDetail(s);
  }

  if (isWide) {
    const activeServer = (selectedServerId && servers.get(String(selectedServerId))) || list[0] || null;
    const listNodes = list.length
      ? (effectiveView === "table" ? serverTable(list, activeServer?.id, false) : serverGrid(list, activeServer?.id))
      : [TX(t.emptyServers, { tw: "text-[12px] text-textMuted" })];
    const detailBlock = activeServer ? serverDetailBody(activeServer) : null;
    return h(
      "Column",
      { preferredWidth: Math.max(920, Math.min(1180, viewportWidth)), fill: true, minHeight: 0, safeArea: true, tw: "gap-0 text-text" },
      h("Column", { tw: "gap-2.5 px-4 pt-3 pb-2.5 w-full" }, brandHeader(true), topTabs(), overviewCard()),
      Line(),
      h("Row", { grow: 1, minHeight: 0, tw: "w-full gap-0" },
        h("Column", { grow: 1, minWidth: 0, minHeight: 0, tw: "gap-2.5 px-4 py-3" },
          serversToolbar(effectiveView === "table"),
          h("Scroll", { grow: 1, minHeight: 0, fillWidth: true },
            h("Column", { tw: "gap-2.5 w-full pb-2" },
              wsDegraded ? TX(t.wsDegraded, { tw: "text-[11px] text-[#f59e0b] line-clamp-1" }) : null,
              ...listNodes,
              error && loadedAt ? h("Row", { tw: "gap-2 py-2 px-3 rounded-xl bg-surfaceHover items-center w-full" },
                statusDot(PAL.red, 6),
                TX(error, { tw: "text-[10.5px] text-[#ef4444] grow min-w-0 line-clamp-1" }),
                h("Button", { text: t.retry, onClick: launchRefresh, tw: "text-[10px]" })
              ) : null
            )
          )
        ),
        h("Box", { tw: `w-px bg-${cardBorder()} self-stretch shrink-0` }),
        h("Column", { width: 410, shrink: 0, minHeight: 0, tw: "gap-2.5 px-4 py-3" },
          detailBlock ? detailBlock.detailActions : null,
          h("Scroll", { grow: 1, minHeight: 0, fillWidth: true },
            detailBlock
              ? h("Column", { tw: "gap-2.5 w-full pb-2" }, ...detailBlock.nodes)
              : h("Column", { tw: "py-10 items-center justify-center w-full" },
                  TX(t.selectServerHint, { tw: "text-[12px] text-textMuted" })
                )
          )
        )
      )
    );
  }

  const body = list.length
    ? (effectiveView === "table" ? serverTable(list, selectedServerId, true) : serverGrid(list, selectedServerId))
    : [TX(t.emptyServers, { tw: "text-[12px] text-textMuted" })];
  const fourRowHeight = list.length > 6
    ? 664 + (groups.length > 0 ? 40 : 0) + (servers.size > 6 ? 40 : 0) + (wsDegraded ? 22 : 0) + (error && loadedAt ? 42 : 0)
    : undefined;
  return panelShell(
    [brandHeader(false), topTabs(), overviewCard(), serversToolbar(effectiveView === "table")],
    wsDegraded ? [TX(t.wsDegraded, { tw: "text-[11px] text-[#f59e0b] line-clamp-1" }), ...body] : body,
    { height: fourRowHeight }
  );
}

function serviceRow(r) {
  const borderCls = r.failing ? "border-[#ef444466]" : selectedServiceId === String(r.id) ? "border-[#3b82f6]" : `border-${cardBorder()}`;
  return h(
    "Column",
    {
      key: `svc-${r.id}`,
      tw: `gap-1.5 py-2.5 px-3 rounded-xl bg-background border ${borderCls} w-full hover:bg-surfaceHover`,
    },
    h("Row", { tw: "items-center gap-2 w-full" },
      statusDot(r.failing ? PAL.red : PAL.emerald, 7),
      TX(r.name, { tw: "text-[12.5px] font-semibold text-text truncate grow min-w-0" }),
      TX(r.typeLabel, { tw: "text-[9.5px] font-medium text-textMuted px-1.5 py-0.5 rounded bg-surfaceHover shrink-0" }),
      r.failing
        ? TX("DOWN", { tw: "text-[10.5px] font-semibold text-[#ef4444] px-1.5 py-0.5 rounded bg-[#ef44441a] shrink-0" })
        : TX(`${r.upPercent.toFixed(1)}%`, { tw: "text-[11px] font-semibold tabular-nums text-[#10b981] shrink-0" })
    ),
    h("Row", { tw: "items-center w-full" },
      TX(r.target || "", { tw: "text-[10.5px] text-textMuted truncate" }),
      h("Spacer"),
      TX(r.delay != null ? `${r.delay.toFixed(1)} ms` : "", { tw: "text-[10.5px] tabular-nums text-textMuted shrink-0" })
    )
  );
}

function servicesPanel(viewportWidth = 0) {
  const t = T();
  const isWide = viewportWidth >= 860;
  const items = [
    { label: t.all, value: "all" },
    { label: "HTTP", value: "HTTP" },
    { label: "Ping", value: "Ping" },
    { label: "TCP", value: "TCP" },
  ];
  const rows = serviceRows.filter(r => serviceFilter === "all" || r.typeLabel === serviceFilter);
  const downCount = serviceRows.filter(r => r.failing).length;
  const summary = h(
    "Row",
    { tw: "gap-2 w-full items-stretch" },
    tintedStatTile({ key: "sv-total", label: t.tabServices, value: String(serviceRows.length), valueColor: "text", tintHex: PAL.blue }),
    tintedStatTile({ key: "sv-down", label: "DOWN", value: String(downCount), valueColor: downCount > 0 ? PAL.red : PAL.emerald, tintHex: downCount > 0 ? PAL.red : PAL.emerald })
  );
  const body = rows.length
    ? (isWide ? chunk(rows, 2).map((pair, i) => {
        const cells = pair.map(r => h("Box", { key: `svw-${r.id}`, tw: "grow basis-0 min-w-0" }, serviceRow(r)));
        if (pair.length === 1) cells.push(h("Box", { key: `svph-${i}`, tw: "grow basis-0 min-w-0" }));
        return h("Row", { key: `svrow-${i}`, tw: "gap-2.5 w-full items-start" }, ...cells);
      }) : rows.map(serviceRow))
    : [TX(t.emptyServices, { tw: "text-[12px] text-textMuted" })];
  return panelShell(
    [
      brandHeader(isWide),
      topTabs(),
      summary,
      h("Row", { tw: "items-center w-full" },
        CompactToggle(items, serviceFilter, v => { serviceFilter = String(v || "all"); $metrix.invalidate(); }, "svc-filter"),
        h("Spacer")
      ),
    ],
    body,
    { width: isWide ? Math.min(1080, viewportWidth) : 520, isWide }
  );
}

function cycleCard(c) {
  const t = T();
  const barColor = c.pct >= 95 ? PAL.red : c.pct >= 80 ? PAL.amber : PAL.emerald;
  const borderCls = c.pct >= 95 ? "border-[#ef444466]" : c.pct >= 80 ? "border-[#f59e0b66]" : `border-${cardBorder()}`;
  return h(
    "Column",
    { key: `cyc-${c.id}`, tw: `gap-2 p-3 rounded-xl bg-background border ${borderCls} grow basis-0 min-w-0` },
    h("Row", { tw: "items-center gap-1.5 w-full" },
      TX(c.serverName, { tw: "text-[12.5px] font-semibold text-text truncate grow min-w-0" }),
      TX(`${c.pct.toFixed(1)}%`, { tw: `text-[11px] font-bold tabular-nums shrink-0 text-[${barColor}]` })
    ),
    h("Row", { tw: "items-center w-full" },
      TX(c.cycle, { tw: "text-[9.5px] font-medium text-[#0a94f2] px-1.5 py-0.5 rounded bg-[#0a94f214] truncate" })
    ),
    h("Row", { tw: "items-end gap-1.5 w-full" },
      TX(`${formatBytes(c.used, 1, true)} / ${formatBytes(c.max, 1, true)}`, { tw: "text-[11.5px] font-semibold text-text tabular-nums" }),
      h("Spacer"),
      TX(`${t.remaining} ${formatBytes(c.remaining, 1, true)}`, { tw: "text-[10px] tabular-nums text-textMuted" })
    ),
    capsuleBar(c.pct, barColor, "h-[4px]"),
    h("Row", { tw: "items-center gap-1 w-full" },
      TX(`${formatMonthDay(c.from)} - ${formatMonthDay(c.to)}`, { tw: "text-[9.5px] tabular-nums text-textMuted truncate" }),
      h("Spacer"),
      TX(`${t.nextUpdate} ${formatMonthDayTime(c.nextUpdate)}`, { tw: "text-[9.5px] tabular-nums text-textMuted truncate" })
    )
  );
}

function trafficPanel(viewportWidth = 0) {
  const t = T();
  const isWide = viewportWidth >= 860;
  const cols = isWide ? 3 : 2;
  const warnCount = cycleTransfers.filter(c => c.pct >= 80).length;
  const summary = h(
    "Row",
    { tw: "gap-2 w-full items-stretch" },
    tintedStatTile({ key: "cyc-total", label: t.cycleCount, value: String(cycleTransfers.length), valueColor: "text", tintHex: PAL.sky }),
    tintedStatTile({ key: "cyc-warn", label: t.cycleWarn, value: String(warnCount), valueColor: warnCount > 0 ? PAL.amber : PAL.emerald, tintHex: warnCount > 0 ? PAL.amber : PAL.emerald })
  );
  const body = cycleTransfers.length
    ? chunk(cycleTransfers, cols).map((row, i) => {
        const cells = row.map(cycleCard);
        while (cells.length < cols) cells.push(h("Box", { key: `cyc-ph-${i}-${cells.length}`, tw: "grow basis-0 min-w-0" }));
        return h("Row", { key: `cyc-row-${i}`, tw: "gap-2.5 w-full items-start" }, ...cells);
      })
    : [TX(t.emptyTraffic, { tw: "text-[12px] text-textMuted" })];
  return panelShell([brandHeader(isWide), topTabs(), summary], body, { width: isWide ? Math.min(1080, viewportWidth) : 520, isWide });
}

function attentionRow(it) {
  const t = T();
  const critical = it.kind === "offline" || it.severity === "critical";
  const hex = critical ? PAL.red : PAL.amber;
  const kindLabel = it.kind === "traffic" ? t.kindTraffic : it.kind === "probe" ? t.kindProbe : t.kindOffline;
  return h(
    "Column",
    {
      key: it.id,
      tw: `gap-1 p-3 rounded-xl bg-background w-full border border-[${hex}55] cursor-pointer hover:bg-surfaceHover`,
      onClick: () => {
        if (it.serverId) {
          activeTab = "servers";
          selectedServerId = String(it.serverId);
          selectedServiceId = null;
          localStorage.setItem("nezha.tab", activeTab);
          void loadMetrics(selectedServerId);
        } else if (it.serviceId) {
          activeTab = "services";
          selectedServiceId = String(it.serviceId);
          selectedServerId = null;
          localStorage.setItem("nezha.tab", activeTab);
        }
        $metrix.invalidate();
      },
    },
    h("Row", { tw: "items-center gap-2 w-full" },
      statusDot(hex, 7),
      TX(it.title, { tw: "text-[12.5px] font-semibold text-text truncate grow min-w-0" }),
      TX(kindLabel, { tw: `text-[9.5px] font-semibold text-[${hex}] px-1.5 py-0.5 rounded bg-[${hex}1a] shrink-0` })
    ),
    TX(it.kind === "offline" ? formatRelativeTime(it.meta, Date.now(), locale) || it.meta : it.meta || it.kind, {
      tw: "text-[10.5px] text-textMuted",
    })
  );
}

function inboxAlertCard(alert) {
  const t = T();
  const unread = isInboxUnread(inboxStore.boxes, alert.inboxId, alert.seq);
  const expanded = expandedInboxKey === alert.key;
  const hex = alert.severity === "critical" ? PAL.red : alert.severity === "info" ? PAL.emerald : PAL.amber;
  const age = alert.receivedAt ? formatRelativeTime(alert.receivedAt * 1000, Date.now(), locale) : "";
  return h(
    "Column",
    {
      key: `inbox-${alert.key}`,
      tw: `gap-1.5 p-3 rounded-xl bg-background border ${unread ? `border-[${hex}55]` : `border-${cardBorder()}`} w-full`,
    },
    h("Row", {
      tw: "items-center gap-2 w-full cursor-pointer",
      onClick: () => {
        expandedInboxKey = expanded ? null : alert.key;
        if (!expanded) {
          if (setInboxRead(inboxStore.boxes, alert.inboxId, alert.seq, true)) saveInboxStore();
          void loadInboxDetail(alert);
        }
        $metrix.invalidate();
      },
    },
      statusDot(unread ? hex : "surfaceHover", 7),
      TX(alert.title, { tw: `text-[12px] text-text ${unread ? "font-bold" : "font-medium"} truncate grow min-w-0` }),
      alert.serverName ? TX(alert.serverName, { tw: "text-[9.5px] font-medium text-[#0a94f2] px-1.5 py-0.5 rounded bg-[#0a94f214] shrink-0" }) : null,
      TX(alert.source === "email" ? "Email" : "Webhook", { tw: "text-[9.5px] font-medium text-textMuted px-1.5 py-0.5 rounded bg-surfaceHover shrink-0" }),
      age ? TX(age, { tw: "text-[9.5px] text-textMuted tabular-nums shrink-0" }) : null
    ),
    alert.body && !expanded ? TX(alert.body, { tw: "text-[10.5px] text-textMuted line-clamp-2" }) : null,
    expanded ? h("Column", { tw: "gap-2 pt-1.5 w-full" },
      Line(),
      inboxLoadingKey === alert.key
        ? h("Row", { tw: "items-center gap-1.5" }, h("Spinner", { tw: "size-[11px]" }), TX(t.loading, { tw: "text-[10.5px] text-textMuted" }))
        : TX(alert.body || alert.title, { selectable: true, tw: "text-[11px] text-text leading-relaxed" }),
      h("Row", { tw: "items-center gap-2 w-full" },
        alert.sender ? TX(alert.sender, { tw: "text-[9.5px] text-textMuted truncate" }) : null,
        h("Spacer"),
        h("Button", { text: t.copy, tw: "text-[10px]", onClick: () => { void copyText(`${alert.title}\n${alert.body || ""}`.trim()); } }),
        h("Button", { text: unread ? t.markRead : t.markUnread, tw: "text-[10px]", onClick: () => toggleInboxRead(alert) }),
        caps.inboxRemove ? h("Button", { text: t.deleteBtn, tw: "text-[10px] text-[#ef4444]", onClick: () => { void deleteInboxMessage(alert); } }) : null
      )
    ) : null
  );
}

function ruleRow(r) {
  return h(
    "Row",
    {
      key: `rule-${r.id}`,
      tw: `py-2.5 px-3 rounded-xl bg-background border border-${cardBorder()} items-center gap-2.5 w-full`,
    },
    statusDot(r.enable ? PAL.emerald : "surfaceHover", 6),
    TX(r.name || r.id, { tw: "text-[12px] text-text truncate grow min-w-0" }),
    TX(r.enable ? "ON" : "OFF", {
      tw: `text-[10px] font-semibold px-1.5 py-0.5 rounded shrink-0 ${r.enable ? "text-[#10b981] bg-[#10b9811a]" : "text-textMuted bg-surfaceHover"}`,
    })
  );
}

function alertsPanelFn(viewportWidth = 0) {
  const t = T();
  const isWide = viewportWidth >= 860;
  const scoped = currentScoped();
  const { items, rules } = buildAttention({
    servers: scoped,
    services: serviceRows,
    alertRules,
    cycleTransfers,
    nowMs: Date.now(),
  });
  const unreadCount = unreadInboxCount();
  const summary = h(
    "Row",
    { tw: "gap-2 w-full items-stretch" },
    tintedStatTile({ key: "al-attn", label: t.liveAttention, value: String(items.length), valueColor: items.length ? PAL.amber : PAL.emerald, tintHex: items.length ? PAL.amber : PAL.emerald }),
    tintedStatTile({ key: "al-inbox", label: t.inboxUnread, value: String(unreadCount), valueColor: unreadCount ? PAL.red : "text", tintHex: unreadCount ? PAL.red : PAL.sky }),
    tintedStatTile({ key: "al-rules", label: t.rules, value: String(rules.filter(r => r.enable).length), valueColor: "text", tintHex: PAL.blue })
  );
  const attention = items.length
    ? [TX(t.liveAttention, { tw: "text-[11px] font-semibold text-textMuted px-0.5" }), ...items.map(attentionRow)]
    : [h("Row", { tw: `items-center gap-2 py-2.5 px-3 rounded-xl bg-background border border-${cardBorder()} w-full` },
        statusDot(PAL.emerald, 7),
        TX(t.emptyAlerts, { tw: "text-[12px] text-textMuted" })
      )];

  let inboxSection = [];
  if (isPlusSubscription()) {
    if (inboxBoxes.length > 0) {
      inboxSection = [
        h("Row", { tw: "items-center gap-1.5 pt-1 px-0.5 w-full" },
          h("Icon", { svg: ICONS.inbox, tw: "size-[12px] text-[#0a94f2]" }),
          TX(`${t.inboxTitle} (${inboxAlerts.length})`, { tw: "text-[11px] font-semibold text-textMuted" }),
          h("Spacer"),
          h("Button", { text: t.refresh, tw: "text-[10px]", onClick: () => { void refreshInbox(); } })
        ),
        ...(inboxAlerts.length
          ? inboxAlerts.slice(0, 20).map(inboxAlertCard)
          : [TX(t.inboxEmpty, { tw: "text-[11.5px] text-textMuted px-1" })]),
      ];
    } else if (caps.inboxBoxes) {
      inboxSection = [
        h("Column", { tw: `gap-1.5 p-3 rounded-xl bg-background border border-${cardBorder()} w-full` },
          h("Row", { tw: "items-center gap-1.5" },
            h("Icon", { svg: ICONS.inbox, tw: "size-[13px] text-[#0a94f2]" }),
            TX(t.inboxSetupTitle, { tw: "text-[11.5px] font-semibold text-text" })
          ),
          TX(t.inboxSetupDesc, { tw: "text-[10.5px] text-textMuted leading-relaxed" })
        ),
      ];
    }
  }

  const rulesBody = rules.length
    ? [TX(t.rules, { tw: "text-[11px] font-semibold text-textMuted pt-1 px-0.5" }), ...rules.map(ruleRow)]
    : [];

  return panelShell(
    [brandHeader(isWide), topTabs(), summary],
    [...attention, ...inboxSection, ...rulesBody],
    { width: isWide ? Math.min(1080, viewportWidth) : 520, isWide }
  );
}

function statusCard() {
  const t = T();
  if (!baseURL) {
    return panelShell([brandHeader(false)], [
      h("Column", { tw: `gap-2 p-4 rounded-xl bg-background border border-${cardBorder()}` },
        TX(t.setupTitle, { tw: "text-[15px] font-bold text-text" }),
        TX(t.setupDesc, { tw: "text-[12px] text-textMuted" })
      ),
    ]);
  }
  if (error && !servers.size) {
    return panelShell([brandHeader(false)], [
      h("Column", { tw: "gap-3 p-4 rounded-xl bg-background border border-[#ef444455]" },
        TX(forceAuthHint ? t.guestForced : error, { tw: "text-[13px] text-[#ef4444]" }),
        h("Button", { text: t.retry, onClick: launchRefresh })
      ),
    ]);
  }
  return null;
}

function panelTree(env) {
  const blocked = statusCard();
  if (blocked) return blocked;
  if (!loadedAt && inflight) {
    return panelShell([brandHeader(false)], [
      h("Row", { tw: `items-center gap-2 p-4 rounded-xl bg-background border border-${cardBorder()}` },
        h("Spinner", { tw: "size-[13px]" }),
        TX(T().loading, { tw: "text-[12px] text-textMuted" })
      ),
    ]);
  }
  const viewportWidth = Number(env?.viewport?.width) || 0;
  if (activeTab === "services") return servicesPanel(viewportWidth);
  if (activeTab === "traffic") return trafficPanel(viewportWidth);
  if (activeTab === "alerts") return alertsPanelFn(viewportWidth);
  return serversPanel(viewportWidth);
}

const WTX = (text, props) => h("Text", { text: String(text), ...(props || {}) });
const widgetColor = value => value === "danger" ? "error" : value;

function widgetHeader(title, badge) {
  return h("Row", { gap: 6, alignItems: "center" },
    h("Icon", { svg: BRAND, size: 15, color: "accent" }),
    WTX(title, { fontSize: 13, fontWeight: 600, maxLines: 1 }),
    h("Spacer"),
    badge ? h("Badge", { text: badge, fontSize: 10 }) : null
  );
}

function widgetMessage(title, detail) {
  return h("Column", { gap: 8 },
    widgetHeader(title),
    h("Spacer"),
    WTX(detail, { fontSize: 12, color: "secondary", textAlign: "center", maxLines: 4 }),
    h("Spacer")
  );
}

function widgetStat(value, label, color, size = 20) {
  return h("Column", { gap: 2 },
    WTX(value, { fontSize: size, fontWeight: 700, color: color || "primary", maxLines: 1 }),
    WTX(label, { fontSize: 10, color: "secondary", maxLines: 1 })
  );
}

function widgetProgress(value, color) {
  return h("Progress", { value: Math.max(0, Math.min(100, Number(value) || 0)) / 100, color: widgetColor(color || "accent") });
}

function formatWidgetRate(bytesPerSecond) {
  let value = Math.abs(Number(bytesPerSecond) || 0);
  const units = ["B/s", "K/s", "M/s", "G/s", "T/s"];
  let unit = 0;
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024;
    unit += 1;
  }
  const digits = value >= 10 ? 0 : value >= 1 ? 1 : 2;
  return `${value.toFixed(digits)}${units[unit]}`;
}

function widgetRates(summary) {
  return h("Row", { gap: 12 },
    WTX(`↓${formatWidgetRate(summary.netDown)}`, { fontSize: 11, fontWeight: 600, maxLines: 1 }),
    WTX(`↑${formatWidgetRate(summary.netUp)}`, { fontSize: 11, fontWeight: 600, maxLines: 1 })
  );
}

function widgetTransfer(summary) {
  return WTX(`${T().transfer} ↓${formatBytes(summary.transferDown, 1, true)}  ↑${formatBytes(summary.transferUp, 1, true)}`, {
    fontSize: 11, color: "secondary", maxLines: 1,
  });
}

function overviewWidget(family) {
  const t = T();
  const summary = summarizeScoped(Array.from(servers.values()));
  const attention = buildAttention({ servers: Array.from(servers.values()), services: serviceRows, alertRules, cycleTransfers }).items;
  const heading = widgetHeader("Nezha", `${summary.online}/${summary.total}`);
  const statusText = WTX(summary.offline ? t.offlineCount(summary.offline) : t.allOnline, {
    fontSize: 10, color: summary.offline ? "warning" : "secondary", maxLines: 1,
  });
  if (family === "small") {
    const windows = $metrix.platform === "windows";
    return h("Column", { gap: windows ? 6 : 8 }, heading, windows ? null : h("Spacer"),
      widgetStat(`${summary.online}/${summary.total}`, t.online, summary.offline ? "warning" : "success", windows ? 24 : 28),
      widgetRates(summary), statusText,
      windows ? null : h("Spacer")
    );
  }
  const stats = h("Grid", { key: "widget-overview-stats", columns: 2, gap: 10 },
    widgetStat(`${summary.online}/${summary.total}`, t.online, summary.offline ? "warning" : "success"),
    widgetStat(`↓${formatWidgetRate(summary.netDown)}`, t.downRate),
    widgetStat(`↑${formatWidgetRate(summary.netUp)}`, t.upRate),
    widgetStat(`${summary.avgCpu.toFixed(0)}%`, "Avg CPU", "accent")
  );
  const sparkRate = caps.widgetChart && fleetHistory.length > 1
    ? h("Chart", {
        key: "widget-overview-chart",
        type: "area",
        height: family === "medium" ? 34 : 52,
        series: [
          { color: "accent", points: buildSparkPoints(fleetHistory, "down", 40) },
          { color: "success", points: buildSparkPoints(fleetHistory, "up", 40) },
        ],
      })
    : null;
  if (family === "medium") {
    return h("Column", { gap: 8 }, heading, stats,
      sparkRate,
      h("Row", { key: "widget-overview-footer", gap: 8 }, widgetTransfer(summary), h("Spacer"), statusText)
    );
  }
  const topCpu = Array.from(servers.values())
    .filter(server => isServerOnline(server))
    .sort((a, b) => Number(b.state?.cpu || 0) - Number(a.state?.cpu || 0))
    .slice(0, 3);
  return h("Column", { gap: 9 }, heading, stats, sparkRate, widgetTransfer(summary), statusText,
    h("Divider"),
    h("Row", { gap: 8 },
      WTX(t.topCpu, { fontSize: 11, fontWeight: 600, color: "secondary" }),
      h("Spacer"),
      WTX(t.attentionCount(attention.length), { fontSize: 11, color: attention.length ? "warning" : "secondary" })
    ),
    topCpu.length ? topCpu.map(server => h("Row", { key: `widget-cpu-${server.id}`, gap: 8, alignItems: "center" },
      WTX(server.name || server.id, { fontSize: 11, maxLines: 1 }),
      h("Spacer"),
      WTX(`${Number(server.state?.cpu || 0).toFixed(0)}%`, { fontSize: 11, fontWeight: 600, color: widgetColor(resourceColor(server.state?.cpu)) })
    )) : WTX(t.noOnlineNodes, { fontSize: 11, color: "secondary" })
  );
}

function widgetCompactResources(server) {
  const state = server.state || {};
  const host = server.host || {};
  const resources = [
    ["MEM", pct(state.mem_used, host.mem_total)],
    ["DISK", pct(state.disk_used, host.disk_total)],
  ];
  return h("Grid", { key: "widget-server-compact-resources", columns: 2, gap: 8 }, resources.map(([label, value]) =>
    h("Column", { gap: 3 },
      WTX(`${label} ${value.toFixed(0)}%`, { fontSize: 10, fontWeight: 600, color: widgetColor(resourceColor(value)), maxLines: 1 }),
      widgetProgress(value, resourceColor(value))
    )
  ));
}

function widgetDiskRow(server) {
  const value = pct(server.state?.disk_used, server.host?.disk_total);
  return h("Column", { key: "widget-server-disk", gap: 3 },
    WTX(`DISK ${value.toFixed(0)}%`, { fontSize: 10, fontWeight: 600, color: widgetColor(resourceColor(value)), maxLines: 1 }),
    widgetProgress(value, resourceColor(value))
  );
}

function widgetChartSeries(points, color) {
  return { color, points: (points || []).slice(-120).map(point => ({ y: Number(point.value) || 0 })) };
}

function serverWidget(family) {
  const t = T();
  const resolved = resolveWidgetServer(servers, widgetServer || selectedServerId || "");
  if (resolved.status !== "ok") {
    const messages = {
      empty: t.widgetServerEmpty,
      missing: t.widgetServerMissing,
      ambiguous: t.widgetServerAmbiguous,
    };
    return widgetMessage(t.widgetServerTitle, messages[resolved.status]);
  }
  const server = resolved.server;
  const state = server.state || {};
  const online = isServerOnline(server);
  const heading = widgetHeader(server.name || String(server.id), online ? t.online : t.offline);
  const summary = summarizeScoped([server]);
  if (family === "small") {
    return h("Column", { gap: 8 }, heading, h("Spacer"),
      widgetStat(`${Number(state.cpu || 0).toFixed(0)}%`, "CPU", resourceColor(state.cpu), 28),
      widgetRates(summary),
      h("Spacer"), widgetCompactResources(server)
    );
  }
  const cache = metricsCache.get(`${server.id}:${detailPeriod}`) || {};
  const series = cache.series || {};
  const chartCells = [];
  if (family === "large" && caps.widgetChart) {
    if (series.cpu && series.cpu.length) {
      chartCells.push(h("Column", { gap: 3 },
        WTX(`CPU / ${t.mem}`, { fontSize: 10, color: "secondary" }),
        h("Chart", { type: "area", height: 64, series: [widgetChartSeries(series.cpu, "accent"), widgetChartSeries(series.memory, "warning")] })
      ));
    }
    if (series.net_in_speed && series.net_in_speed.length) {
      chartCells.push(h("Column", { gap: 3 },
        WTX(t.networkChart, { fontSize: 10, color: "secondary" }),
        h("Chart", { type: "area", height: 64, series: [widgetChartSeries(series.net_in_speed, "accent"), widgetChartSeries(series.net_out_speed, "success")] })
      ));
    }
  }
  return h("Column", { gap: 9 }, heading,
    h("Grid", { key: "widget-server-stats", columns: 2, gap: 9 },
      widgetStat(`${Number(state.cpu || 0).toFixed(0)}%`, "CPU", resourceColor(state.cpu)),
      widgetStat(`${pct(state.mem_used, server.host?.mem_total).toFixed(0)}%`, t.mem, resourceColor(pct(state.mem_used, server.host?.mem_total))),
      widgetStat(`↓${formatWidgetRate(state.net_in_speed)}`, t.downRate),
      widgetStat(`↑${formatWidgetRate(state.net_out_speed)}`, t.upRate)
    ),
    widgetDiskRow(server),
    h("Row", { gap: 10 },
      widgetTransfer(summary),
      h("Spacer"),
      WTX(`Load ${Number(state.load_1 || 0).toFixed(2)}`, { fontSize: 10, color: "secondary" })
    ),
    chartCells.length
      ? h("Grid", { key: "widget-server-charts", columns: 2, gap: 8 }, ...chartCells)
      : family === "large"
        ? WTX(cache.loading ? t.loadingMetrics : t.noHistory, { fontSize: 11, color: "secondary", textAlign: "center" })
        : null
  );
}

function trafficWidget(family) {
  const t = T();
  const limit = family === "small" ? 1 : family === "medium" ? 2 : 6;
  const items = cycleTransfers.slice(0, limit);
  if (!items.length) return widgetMessage(t.widgetTrafficTitle, t.widgetTrafficEmpty);
  return h("Column", { gap: 10 }, widgetHeader(t.tabTraffic, `${cycleTransfers.length}`),
    items.map(item => h("Column", { key: `widget-traffic-${item.id}`, gap: 4 },
      h("Row", { gap: 6 },
        WTX(item.serverName, { fontSize: 11, fontWeight: 600, maxLines: 1 }),
        h("Spacer"),
        WTX(`${item.pct.toFixed(0)}%`, { fontSize: 11, fontWeight: 700, color: item.pct >= 95 ? "error" : item.pct >= 80 ? "warning" : "primary" })
      ),
      widgetProgress(item.pct, item.pct >= 95 ? "error" : item.pct >= 80 ? "warning" : "accent"),
      WTX(`${item.cycle} · ${t.remaining} ${formatBytes(item.remaining, 1, true)}`, { fontSize: 10, color: "secondary", maxLines: 1 })
    ))
  );
}

function attentionWidget(family) {
  const t = T();
  const limit = family === "small" ? 1 : family === "medium" ? 2 : 6;
  const items = buildAttention({ servers: Array.from(servers.values()), services: serviceRows, alertRules, cycleTransfers }).items;
  if (!items.length) return widgetMessage(t.widgetAttentionTitle, t.widgetAttentionEmpty);
  return h("Column", { gap: 10 }, widgetHeader(t.liveAttention, `${items.length}`),
    items.slice(0, limit).map(item => h("Column", { key: `widget-attention-${item.id}`, gap: 3 },
      h("Row", { gap: 6, alignItems: "center" },
        h("Badge", { text: item.kind, fontSize: 9, color: item.severity === "critical" ? "error" : "warning" }),
        WTX(item.title, { fontSize: 11, fontWeight: 600, maxLines: 1 })
      ),
      WTX(item.meta || item.kind, { fontSize: 10, color: "secondary", maxLines: 1 })
    ))
  );
}

function widgetSummary(family) {
  const t = T();
  if (!baseURL) return widgetMessage("Nezha", t.widgetSetup);
  if (!loadedAt) return widgetMessage("Nezha", error || t.widgetLoading);
  if (widgetMode === "server") return serverWidget(family);
  if (widgetMode === "traffic") return trafficWidget(family);
  if (widgetMode === "attention") return attentionWidget(family);
  return overviewWidget(family);
}

function widgetTrees(demand) {
  const families = demand && demand.widgetKnown ? demand.widgetFamilies : ["small", "medium", "large"];
  if (!families.length) return undefined;
  const out = {};
  for (const f of families) out[f] = widgetSummary(f);
  return out;
}

function notchSparkRow(label, value, hexColor, sparkKey) {
  const pts = buildSparkPoints(fleetHistory, sparkKey, 36);
  return h("Row", { tw: "items-center gap-2.5 w-full" },
    TX(label, { tw: "text-[10.5px] text-textMuted w-[64px] shrink-0 truncate" }),
    pts.length > 1
      ? h("Chart", {
          type: "area",
          height: 22,
          tw: "grow h-[22px]",
          curve: "monotone",
          grid: false,
          legend: false,
          axes: false,
          hover: false,
          strokeWidth: 1.4,
          series: [{ name: sparkKey, color: hexColor, points: pts }],
        })
      : h("Box", { tw: "grow h-[2px] bg-surfaceHover rounded-full" }),
    TX(value, { tw: `text-[11px] font-semibold tabular-nums w-[68px] text-right shrink-0 text-[${hexColor}]` })
  );
}

function notchTree(demand) {
  if (caps.notch === false) return undefined;
  const t = T();
  const scoped = currentScoped();
  const summary = summarizeScoped(scoped);
  const attn = buildAttention({ servers: scoped, services: serviceRows, alertRules, cycleTransfers, nowMs: Date.now() }).items;
  const unread = unreadInboxCount();
  const healthHex = summary.offline > 0 || attn.some(i => i.kind === "offline" || i.severity === "critical")
    ? PAL.red
    : (attn.length > 0 || unread > 0 ? PAL.amber : PAL.brand);

  const compactLeading = h("Icon", { svg: BRAND, tw: `size-[15px] text-[${healthHex}]` });
  const compactTrailing = TX(
    loadedAt ? formatCompactNotchValue(notchMetric, summary) : "…",
    { fontSize: 11, fontWeight: 600, fontFeatures: "tnum", textColor: summary.offline > 0 ? PAL.red : "text" }
  );
  const minimal = h("Icon", { svg: BRAND, tw: `size-[14px] text-[${healthHex}]` });

  const view = {
    compact: { leading: compactLeading, trailing: compactTrailing },
    minimal,
  };

  if (notchActivityEnabled && caps.notchActivity !== false && activeNotchActivity) {
    if (activeNotchActivity.expiresAt > Date.now()) {
      view.activity = { id: activeNotchActivity.id, expiresAt: activeNotchActivity.expiresAt };
    } else {
      activeNotchActivity = null;
    }
  }

  const wantsExpanded = !demand || !demand.known || demand.notch === "expanded";
  if (wantsExpanded) {
    const alertEntries = [
      ...attn.map(i => ({ key: i.id, title: i.title, meta: i.meta, color: i.kind === "offline" || i.severity === "critical" ? PAL.red : PAL.amber, serverId: i.serverId, serviceId: i.serviceId })),
      ...inboxAlerts.filter(a => isInboxUnread(inboxStore.boxes, a.inboxId, a.seq)).slice(0, 2).map(a => ({ key: a.key, title: a.title, meta: a.serverName || a.source, color: a.severity === "critical" ? PAL.red : PAL.amber, inboxKey: a.key })),
    ].slice(0, 2);

    const hotNodes = scoped
      .filter(s => isServerOnline(s))
      .sort((a, b) => (Number(b.state?.cpu) || 0) - (Number(a.state?.cpu) || 0))
      .slice(0, 3);

    view.expanded = h("Column", { width: 420, padding: 14, gap: 10 },
      h("Row", { tw: "items-center gap-2 w-full" },
        h("Icon", { svg: BRAND, tw: `size-[16px] text-[${healthHex}]` }),
        TX((settings && settings.config && settings.config.site_name) || "Nezha", { tw: "text-[13px] font-bold truncate" }),
        TX(`${summary.online}/${summary.total}`, {
          tw: `text-[10px] font-semibold px-1.5 py-0.5 rounded-full tabular-nums ${summary.offline ? "text-[#f59e0b] bg-[#f59e0b1a]" : "text-[#10b981] bg-[#10b9811a]"}`,
        }),
        h("Spacer"),
        TX(`↓${formatRate(summary.netDown, true)} ↑${formatRate(summary.netUp, true)}`, { tw: "text-[10.5px] font-semibold tabular-nums text-textMuted" })
      ),
      notchSparkRow(t.avgCpu, `${summary.avgCpu.toFixed(0)}%`, barHex(summary.avgCpu, PAL.blue), "cpu"),
      notchSparkRow(t.notchAggRate, formatRate(summary.netDown + summary.netUp, true), PAL.sky, "totalRate"),
      Line(),
      alertEntries.length
        ? h("Column", { tw: "gap-1.5 w-full" },
            TX(t.notchAlerts, { tw: "text-[10px] font-semibold text-[#f59e0b]" }),
            ...alertEntries.map(al => h("Row", {
              key: `na-${al.key}`,
              tw: "items-center gap-2 px-2 py-1.5 rounded-lg bg-surfaceHover cursor-pointer w-full",
              onClick: () => {
                if (al.serverId) handleNotificationClick(`nezha-off-${al.serverId}`);
                else if (al.serviceId) handleNotificationClick(`nezha-probe-${al.serviceId}`);
                else if (al.inboxKey) handleNotificationClick(`nezha-inbox-${al.inboxKey}`);
              },
            },
              statusDot(al.color, 6),
              TX(al.title, { tw: "text-[11px] font-semibold truncate grow min-w-0" }),
              TX(al.meta || "", { tw: "text-[9.5px] text-textMuted truncate shrink-0" })
            ))
          )
        : h("Column", { tw: "gap-1.5 w-full" },
            TX(t.topNodes, { tw: "text-[10px] font-semibold text-textMuted" }),
            ...(hotNodes.length
              ? hotNodes.map(s => h("Row", {
                  key: `nh-${s.id}`,
                  tw: "items-center gap-2 px-2 py-1 rounded-lg bg-surfaceHover cursor-pointer w-full",
                  onClick: () => handleNotificationClick(`nezha-off-${s.id}`),
                },
                  statusDot(PAL.emerald, 6),
                  TX(s.name || String(s.id), { tw: "text-[11px] font-medium truncate grow min-w-0" }),
                  TX(`CPU ${Number(s.state?.cpu || 0).toFixed(0)}%`, { tw: `text-[10.5px] font-semibold tabular-nums ${metricValueTw(s.state?.cpu, true)}` }),
                  TX(`↓${formatShortRate(s.state?.net_in_speed)}`, { tw: "text-[10px] tabular-nums text-textMuted w-[44px] text-right" })
                ))
              : [TX(t.noOnlineNodes, { tw: "text-[10.5px] text-textMuted" })])
          ),
      h("Row", { tw: "items-center gap-2 w-full pt-0.5" },
        h("Spacer"),
        h("Button", { text: t.refresh, tw: "text-[10.5px]", onClick: launchRefresh }),
        h("Button", { text: t.openPanel, tw: "text-[10.5px]", onClick: () => { try { $metrix?.panel?.open?.(); } catch {} } })
      )
    );
  }
  return view;
}

function trayTree() {
  const t = T();
  const scoped = currentScoped();
  const summary = summarizeScoped(scoped);
  const title = scoped.length || servers.size ? trayTitle(trayFormat, summary) : (baseURL ? (error ? lastTitle : "…") : "Nezha");
  if (scoped.length || servers.size) lastTitle = title;

  const tray = {
    icon: "data:image/svg+xml," + encodeURIComponent(BRAND),
    iconTemplate: true,
    title,
    tooltip: baseURL ? `${baseURL} · ${summary.online}/${summary.total} · CPU ${summary.avgCpu.toFixed(0)}%` : "Nezha",
    error: error || (forceAuthHint ? t.guestForced : "") || "",
    menu: [
      { label: t.refresh, onClick: launchRefresh, disabled: !baseURL },
      { label: t.openNezha, onClick: () => { if (baseURL) $metrix.openURL(baseURL); }, disabled: !baseURL },
      { separator: true },
      { label: t.clearWatch, onClick: () => { watchlist = new Set(); persistWatch(); $metrix.invalidate(); } },
    ],
  };

  if (caps.trayContent && (scoped.length || servers.size)) {
    const rich = buildTrayContent({
      format: trayFormat,
      summary,
      history: fleetHistory,
      canIcon: caps.trayContentIcon,
      brandSvg: BRAND,
    });
    if (rich) tray.content = rich;
  }

  return tray;
}

export default {
  async scheduled(env) {
    syncInputs(env);
    try { $metrix.schedule(refreshSec * 1000); } catch {}
    await detectHostLocale();
    if ($metrix && typeof $metrix.caniuse === "function" && !capsProbed) {
      await probeCapabilities();
    }
    await refreshAll();
  },
  render(env) {
    syncInputs(env);
    const demand = readOutputs();
    const out = { tray: trayTree() };
    const shouldRebuildPanel = !demand.known || demand.panel || !cachedPanelTree || (loadedAt > 0 && !cachedPanelHadData);
    if (shouldRebuildPanel) {
      cachedPanelTree = panelTree(env);
      cachedPanelHadData = loadedAt > 0;
    }
    out.panel = cachedPanelTree;
    const w = widgetTrees(demand);
    if (w) out.widget = w;
    const n = notchTree(demand);
    if (n) out.notch = n;
    return out;
  },
  event(name, payload) {
    if (name === "lifecycle" && payload && payload.type === "expand") {
      if (baseURL && !inflight && Date.now() - loadedAt > 15000) launchRefresh();
      else $metrix.invalidate();
      return;
    }
    if (name === "outputs") {
      const demand = readOutputs();
      if ((demand.panel || demand.notch === "expanded") && baseURL && !inflight && Date.now() - loadedAt > 15000) {
        launchRefresh();
      }
      if (demand.panel && selectedServerId) {
        const cached = metricsCache.get(`${selectedServerId}:${detailPeriod}`);
        if (!cached || !cached.loadedAt || Date.now() - cached.loadedAt > 60000) {
          void loadMetrics(selectedServerId);
        }
      }
      $metrix.invalidate();
      return;
    }
    if (name === "system" && payload && typeof payload === "object") {
      if (payload.type === "network.change") {
        const wasOffline = !networkOnline;
        networkOnline = payload.online !== false;
        if (networkOnline && baseURL) {
          wsAttempts = 0;
          wsDegraded = false;
          if (liveUpdates && !apiToken) connectWS();
          if (wasOffline || !loadedAt || Date.now() - loadedAt > 5000) launchRefresh();
        }
        return;
      }
      if (payload.type === "notification.click") {
        handleNotificationClick(payload.tag || payload.id || "");
        return;
      }
    }
    if (name === "inboxchange") {
      return refreshInbox(payload && Array.isArray(payload.inboxIds) ? payload.inboxIds : null);
    }
  },
};

  ]]></script>
</bar>
