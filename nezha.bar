let locale = "zh";
const T = () => I18N[locale] || I18N.zh;

let baseURL = "";
let apiToken = "";
let refreshSec = 5;
let liveUpdates = true;
let trayFormat = "online_total";
let widgetMode = "overview";
let widgetServer = "";
let offlineNotify = true;
let probeNotify = true;
let trafficNotify = true;
let authMode = "guest";
let wsDegraded = false;
let forceAuthHint = false;
let error = "";
let loadedAt = 0;
let inflight = false;
const inflightDomains = new Set();
const forcePending = new Set();
const detailInflight = new Map();
let lastServerRefresh = 0;
let lastServiceRefresh = 0;
let lastMetadataRefresh = 0;
let lastAlertRefresh = 0;
let connectionGeneration = 0;
let settings = null;
let servers = new Map();
let groups = [];
let byServerGroup = new Map();
let serviceRows = [];
let alertRules = [];
let activeTab = localStorage.getItem("nezha.tab") || "servers";
let selectedGroup = localStorage.getItem("nezha.group") || "all";
let watchMode = localStorage.getItem("nezha.watchMode") || "all";
let sortBy = localStorage.getItem("nezha.sort") || "cpu";
let serverQuery = "";
let selectedServerId = null;
let detailPeriod = localStorage.getItem("nezha.period") || "1d";
let metricsCache = new Map();
let cycleTransfers = [];
let serviceFilter = "all";
let selectedServiceId = null;
let watchlist = new Set();
try {
  const raw = JSON.parse(localStorage.getItem("nezha.watchlist") || "[]");
  if (Array.isArray(raw)) watchlist = new Set(raw.map(String));
} catch {}
let prevOnline = new Set();
let prevFailing = new Set();
let prevTrafficLevels = new Map();
let hadSnapshot = false;
let hadServiceSnapshot = false;
let ws = null;
let reconnectTimer = null;
let lastTitle = "Nezha";
let lastWidgetConfig = "";

async function detectHostLocale() {
  try {
    const lang = String(($metrix && $metrix.env && $metrix.env.locale) || "").toLowerCase();
    locale = lang.startsWith("zh") ? "zh" : (lang ? "en" : locale);
  } catch {}
  try {
    if (!locale) locale = (Intl.DateTimeFormat().resolvedOptions().locale || "").startsWith("zh") ? "zh" : "en";
  } catch { locale = "zh"; }
}

function resetConnectionState() {
  connectionGeneration += 1;
  disconnectWS();
  servers = new Map();
  groups = [];
  byServerGroup = new Map();
  serviceRows = [];
  alertRules = [];
  cycleTransfers = [];
  settings = null;
  selectedServerId = null;
  selectedServiceId = null;
  metricsCache = new Map();
  prevOnline = new Set();
  prevFailing = new Set();
  prevTrafficLevels = new Map();
  hadSnapshot = false;
  hadServiceSnapshot = false;
  loadedAt = 0;
  error = "";
  forceAuthHint = false;
  wsDegraded = false;
  wsAttempts = 0;
  wsEverOpened = false;
  inflightDomains.clear();
  forcePending.clear();
  detailInflight.clear();
  inflight = false;
  lastServerRefresh = 0;
  lastServiceRefresh = 0;
  lastMetadataRefresh = 0;
  lastAlertRefresh = 0;
}

function syncInputs(env) {
  const inputs = (env && env.inputs) || {};
  const nextBaseURL = normalizeBaseURL(inputs.baseURL);
  if (nextBaseURL !== baseURL) {
    baseURL = nextBaseURL;
    resetConnectionState();
  }
  let token = "";
  try { token = String($metrix.secret("apiToken") || "").trim(); } catch {}
  if (token !== apiToken) {
    apiToken = token;
    wsDegraded = false;
    wsAttempts = 0;
    wsEverOpened = false;
    disconnectWS();
  }
  authMode = apiToken ? "pat" : "guest";
  const nextLive = inputs.liveUpdates !== false && inputs.liveUpdates !== "false";
  if (nextLive !== liveUpdates) {
    liveUpdates = nextLive;
    if (!liveUpdates || apiToken) {
      disconnectWS();
      wsDegraded = false;
    }
  }
  const nextSec = Math.max(2, Number(inputs.refreshInterval) || 5);
  if (nextSec !== refreshSec) {
    refreshSec = nextSec;
    try { $metrix.schedule(refreshSec * 1000); } catch {}
  }
  const tf = String(inputs.trayFormat || "online_total");
  if (["online_total", "total", "online_both", "online"].includes(tf)) trayFormat = tf;
  const wm = String(inputs.widgetMode || "overview");
  widgetMode = ["overview", "server", "traffic", "attention"].includes(wm) ? wm : "overview";
  widgetServer = String(inputs.widgetServer || "").trim();
  const nextWidgetConfig = `${widgetMode}\n${widgetServer}`;
  if (lastWidgetConfig && nextWidgetConfig !== lastWidgetConfig) $metrix.invalidate();
  lastWidgetConfig = nextWidgetConfig;
  offlineNotify = inputs.offlineNotify !== false && inputs.offlineNotify !== "false";
  probeNotify = inputs.probeNotify !== false && inputs.probeNotify !== "false";
  trafficNotify = inputs.trafficNotify !== false && inputs.trafficNotify !== "false";
}

function persistWatch() {
  localStorage.setItem("nezha.watchlist", JSON.stringify(Array.from(watchlist)));
}

function authHeaders() {
  const h = { Accept: "application/json" };
  if (apiToken) h.Authorization = `Bearer ${apiToken}`;
  return h;
}

async function nezhaFetch(path) {
  if (!baseURL) throw new Error("missing url");
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 10000);
  try {
    const res = await fetch(`${baseURL}${path}`, { headers: authHeaders(), signal: controller.signal });
    const text = await res.text();
    let body;
    try { body = JSON.parse(text); } catch { throw new Error(`HTTP ${res.status}`); }
    if (res.status === 401 || res.status === 403) forceAuthHint = !apiToken;
    if (!res.ok) throw new Error(String(body && body.error || `HTTP ${res.status}`));
    return unwrapNezha(body);
  } catch (e) {
    if (e && e.name === "AbortError") throw new Error("Request timeout");
    throw e;
  } finally {
    clearTimeout(timer);
  }
}

function disconnectWS() {
  if (reconnectTimer) {
    clearTimeout(reconnectTimer);
    reconnectTimer = null;
  }
  if (ws) {
    try { ws.onopen = ws.onmessage = ws.onerror = ws.onclose = null; ws.close(); } catch {}
  }
  ws = null;
}

let wsAttempts = 0;
let wsEverOpened = false;

function connectWS() {
  disconnectWS();
  // PAT mode never uses WebSocket because Worker sockets cannot send Authorization.
  if (!baseURL || apiToken || !liveUpdates) return;
  if (wsAttempts >= 3) {
    wsDegraded = true;
    return;
  }
  let url;
  try {
    const u = new URL(baseURL);
    u.protocol = u.protocol === "https:" ? "wss:" : "ws:";
    u.pathname = "/api/v1/ws/server";
    u.search = "";
    u.hash = "";
    url = u.toString();
  } catch { return; }
  try {
    ws = new WebSocket(url);
  } catch (e) {
    wsDegraded = true;
    return;
  }
  ws.onopen = () => {
    wsEverOpened = true;
    wsAttempts = 0;
    wsDegraded = false;
    $metrix.invalidate();
  };
  ws.onmessage = ev => {
    try {
      const frame = JSON.parse(String(ev.data || ""));
      servers = mergeServerFrame(servers, frame);
      loadedAt = Date.now();
      maybeNotify();
      $metrix.invalidate();
    } catch {}
  };
  ws.onerror = () => {};
  ws.onclose = () => {
    ws = null;
    wsAttempts += 1;
    wsDegraded = true;
    $metrix.invalidate();
    const generation = connectionGeneration;
    reconnectTimer = setTimeout(() => {
      reconnectTimer = null;
      if (generation === connectionGeneration) connectWS();
    }, Math.max(5000, refreshSec * 1000));
  };
}

function applyGroups(payload) {
  const idx = buildGroupIndex(payload);
  groups = idx.groups;
  byServerGroup = idx.byServer;
}

function applyServers(list) {
  servers = mergeServerList(servers, list);
}

function beginDomain(name) {
  if (inflightDomains.has(name)) return false;
  inflightDomains.add(name);
  inflight = true;
  return true;
}

function endDomain(name) {
  inflightDomains.delete(name);
  inflight = inflightDomains.size > 0;
  $metrix.invalidate();
  if (forcePending.delete(name)) void runDomain(name);
}

function runDomain(name) {
  if (name === "server") return refreshServers();
  if (name === "services") return refreshServices();
  if (name === "metadata") return refreshMetadata();
  if (name === "alerts") return refreshAlertRules();
  return Promise.resolve();
}

async function refreshServers() {
  if (!beginDomain("server")) return;
  const generation = connectionGeneration;
  try {
    const list = await nezhaFetch("/api/v1/server");
    if (generation !== connectionGeneration) return;
    applyServers(list);
    forceAuthHint = false;
    error = "";
    loadedAt = Date.now();
    lastServerRefresh = loadedAt;
    maybeNotify();
    hadSnapshot = true;
  } catch (e) {
    if (generation !== connectionGeneration) return;
    error = String(e && e.message || e);
    if (/unauthorized|401|ApiErrorUnauthorized/i.test(error) && !apiToken) forceAuthHint = true;
  } finally {
    endDomain("server");
  }
}

async function refreshServices() {
  if (!beginDomain("services")) return;
  const generation = connectionGeneration;
  try {
    const [list, overview] = await Promise.all([
      nezhaFetch("/api/v1/service/list").catch(() => []),
      nezhaFetch("/api/v1/service").catch(() => ({ services: {} })),
    ]);
    if (generation !== connectionGeneration) return;
    serviceRows = mergeServiceRows(list, overview);
    cycleTransfers = buildCycleTransfers(overview);
    lastServiceRefresh = Date.now();
    const traffic = detectTrafficThresholds(prevTrafficLevels, cycleTransfers);
    if (hadServiceSnapshot && trafficNotify) {
      for (const c of traffic.crossed) {
        try {
          new Notification(locale === "zh" ? "哪吒 · 周期流量提醒" : "Nezha · Cycle traffic", {
            body: `${c.serverName} · ${c.cycle} · ${c.pct.toFixed(1)}%`,
            tag: `nezha-traffic-${c.id}-${c.level}`,
          });
        } catch {}
      }
    }
    prevTrafficLevels = traffic.nextLevels;
    maybeNotify();
    hadServiceSnapshot = true;
  } finally {
    endDomain("services");
  }
}

async function refreshMetadata() {
  if (!beginDomain("metadata")) return;
  const generation = connectionGeneration;
  try {
    const [nextSettings, groupPayload] = await Promise.all([
      nezhaFetch("/api/v1/setting"),
      nezhaFetch("/api/v1/server-group").catch(() => []),
    ]);
    if (generation !== connectionGeneration) return;
    settings = nextSettings || {};
    applyGroups(groupPayload);
    lastMetadataRefresh = Date.now();
  } catch (e) {
    if (generation === connectionGeneration) error = String(e && e.message || e);
  } finally {
    endDomain("metadata");
  }
}

async function refreshAlertRules() {
  if (!apiToken || !beginDomain("alerts")) return;
  const generation = connectionGeneration;
  try {
    const rules = await nezhaFetch("/api/v1/alert-rule").catch(() => []);
    if (generation !== connectionGeneration) return;
    alertRules = rules || [];
    lastAlertRefresh = Date.now();
  } finally {
    endDomain("alerts");
  }
}

async function refreshAll({ force = false } = {}) {
  if (!baseURL) return;
  if (force) {
    for (const name of inflightDomains) forcePending.add(name);
  }
  const now = Date.now();
  const initial = !lastServerRefresh;
  const wsHealthy = liveUpdates && !apiToken && ws && ws.readyState === 1 && !wsDegraded;
  const tasks = [];
  if (force || initial || now - lastServerRefresh >= (wsHealthy ? 30000 : refreshSec * 1000)) {
    tasks.push(refreshServers());
  }
  if (force || initial || now - lastServiceRefresh >= Math.max(15000, refreshSec * 1000)) {
    tasks.push(refreshServices());
  }
  if (force || initial || now - lastMetadataRefresh >= 300000) tasks.push(refreshMetadata());
  if (apiToken && (force || initial || now - lastAlertRefresh >= 60000)) tasks.push(refreshAlertRules());
  await Promise.all(tasks);
  if (liveUpdates && !apiToken && (!ws || ws.readyState > 1)) connectWS();
  const detailIds = new Set();
  if (selectedServerId) detailIds.add(String(selectedServerId));
  if (widgetMode === "server") {
    const selected = resolveWidgetServer(servers, widgetServer || selectedServerId || "");
    if (selected.status === "ok") detailIds.add(String(selected.server.id));
  }
  for (const id of detailIds) {
    const key = `${id}:${detailPeriod}`;
    const cached = metricsCache.get(key);
    if (!cached || !cached.loadedAt || Date.now() - cached.loadedAt > 60000) void loadMetrics(id);
  }
  $metrix.invalidate();
}

function launchRefresh() { void refreshAll({ force: true }); }

function maybeNotify() {
  const t = T();
  const now = Date.now();
  const nextOnline = new Set();
  for (const s of servers.values()) {
    if (isServerOnline(s, now)) nextOnline.add(String(s.id));
  }
  if (hadSnapshot && offlineNotify) {
    const { wentOffline } = detectTransitions(prevOnline, nextOnline);
    for (const id of wentOffline) {
      const s = servers.get(id);
      try {
        new Notification(t.offlineAlertTitle, { body: t.offlineAlertBody(s && s.name || id), tag: `nezha-off-${id}` });
      } catch {}
    }
  }
  prevOnline = nextOnline;
  const nextFail = new Set();
  for (const svc of serviceRows) {
    if (svc.failing) nextFail.add(String(svc.id));
  }
  if (hadServiceSnapshot && probeNotify) {
    for (const id of nextFail) {
      if (!prevFailing.has(id)) {
        const svc = serviceRows.find(x => String(x.id) === id);
        try {
          new Notification(t.probeAlertTitle, { body: t.probeAlertBody(svc && svc.name || id), tag: `nezha-probe-${id}` });
        } catch {}
      }
    }
  }
  prevFailing = nextFail;
}

function currentScoped(applySearch = false) {
  const scoped = scopedServers({
    servers,
    groupId: resolveGroupSelection(selectedGroup, groups),
    watchMode,
    watchlist,
    byServerGroup,
  });
  return applySearch && servers.size > 6 ? filterServers(scoped, serverQuery) : scoped;
}

function sortServers(list) {
  const arr = list.slice();
  arr.sort((a, b) => {
    const sa = a.state || {}, sb = b.state || {};
    if (sortBy === "name") return String(a.name).localeCompare(String(b.name));
    if (sortBy === "net") return (Number(sb.net_in_speed)||0) + (Number(sb.net_out_speed)||0) - ((Number(sa.net_in_speed)||0) + (Number(sa.net_out_speed)||0));
    return (Number(sb.cpu)||0) - (Number(sa.cpu)||0);
  });
  // keep offline at bottom
  arr.sort((a, b) => Number(isServerOnline(b)) - Number(isServerOnline(a)));
  return arr;
}

function capsuleBar(pctVal, color) {
  const p = Math.max(0, Math.min(100, Number(pctVal) || 0));
  return h("Row", { tw: "h-1.5 w-full rounded-full bg-border overflow-hidden" },
    p > 0 ? h("Box", { key: "progress-fill", tw: `h-full w-[${p}%] bg-${color}` }) : null
  );
}

function setMetricsCache(key, value) {
  metricsCache.delete(key);
  metricsCache.set(key, value);
  while (metricsCache.size > 8) {
    metricsCache.delete(metricsCache.keys().next().value);
  }
}

function loadMetrics(serverId, period = detailPeriod) {
  const key = `${serverId}:${period}`;
  if (detailInflight.has(key)) return detailInflight.get(key);
  const generation = connectionGeneration;
  const prev = metricsCache.get(key) || {};
  setMetricsCache(key, { ...prev, loading: true, error: "" });
  $metrix.invalidate();
  const promise = (async () => {
    try {
      const metrics = ["cpu", "memory", "net_in_speed", "net_out_speed"];
      const days = period === "7d" ? 7 : 1;
      const [metricValues, monitorsPayload, onlinePayload] = await Promise.all([
        Promise.all(metrics.map(async m => {
          const data = await nezhaFetch(`/api/v1/server/${serverId}/metrics?metric=${m}&period=${period}`);
          return [m, Array.isArray(data && data.data_points) ? data.data_points.slice(-120) : []];
        })),
        nezhaFetch(`/api/v1/server/${serverId}/service`).catch(() => []),
        nezhaFetch(`/api/v1/server/${serverId}/online-history?days=${days}`).catch(() => null),
      ]);
      if (generation !== connectionGeneration) return;
      const monitors = Array.isArray(monitorsPayload) ? monitorsPayload : (monitorsPayload && monitorsPayload.data) || [];
      const monitorRows = buildMonitorRows(monitors).map(r => ({ ...r, points: r.points.slice(-120) }));
      setMetricsCache(key, {
        loading: false,
        error: "",
        series: Object.fromEntries(metricValues),
        monitorRows,
        online: onlinePayload && typeof onlinePayload === "object" ? (onlinePayload.data || onlinePayload) : null,
        loadedAt: Date.now(),
      });
    } catch (e) {
      if (generation !== connectionGeneration) return;
      const current = metricsCache.get(key) || prev;
      setMetricsCache(key, { ...current, loading: false, error: String(e.message || e), loadedAt: Date.now() });
    } finally {
      if (detailInflight.get(key) === promise) detailInflight.delete(key);
      $metrix.invalidate();
    }
  })();
  detailInflight.set(key, promise);
  return promise;
}

function chartFromPoints(points, name) {
  const pts = (points || []).slice(-120);
  if (!pts.length) return null;
  return {
    name,
    points: pts.map(p => ({ x: Number(p.ts), y: Number(p.value) || 0 })),
  };
}

// ---------------------------------------------------------------------------
// Layout shell: fixed header + scrollable body (native flyout)
// ---------------------------------------------------------------------------

const SERVER_LAYOUT = {
  chrome: 340,
  search: 36,
  empty: 20,
  card: 100,
  rowGap: 10,
  error: 43,
  degraded: 24,
};

function serverPanelHeight(rowCount, { searchable, hasError, degraded }) {
  const rows = Math.min(4, Math.max(0, rowCount));
  const content = rows ? rows * SERVER_LAYOUT.card + (rows - 1) * SERVER_LAYOUT.rowGap : SERVER_LAYOUT.empty;
  return SERVER_LAYOUT.chrome + (searchable ? SERVER_LAYOUT.search : 0) + content +
    (hasError ? SERVER_LAYOUT.error : 0) + (degraded ? SERVER_LAYOUT.degraded : 0);
}

function panelShell(header, body, estContentH, minH, maxH) {
  const hDip = Math.round(
    Math.max(minH == null ? 420 : minH, Math.min(maxH == null ? 760 : maxH, (estContentH == null ? 600 : estContentH)))
  );
  const statusBody = [
    ...body,
    error && loadedAt ? h("Row", { tw: "gap-2 p-2.5 rounded-lg bg-surface items-center w-full" },
      TX(error, { tw: "text-[10.5px] text-danger grow min-w-0 line-clamp-1" }),
      h("Button", { text: T().retry, onClick: launchRefresh, tw: "text-[10px]" })
    ) : null,
    loadedAt ? h("Row", { tw: "items-center w-full" },
      h("Spacer"),
      TX(`${apiToken || !liveUpdates || wsDegraded ? "REST" : "Live"} · ${formatMonthDayTime(new Date(loadedAt).toISOString())}`, {
        tw: "text-[9px] text-textMuted tabular-nums",
      })
    ) : null,
  ];
  return h(
    "Column",
    { preferredWidth: 500, preferredHeight: hDip, fill: true, minHeight: 0, safeArea: true, tw: "gap-0" },
    h("Column", { tw: "gap-3 px-4 pt-4 pb-3 w-full" }, ...header),
    h(
      "Scroll",
      { grow: 1, minHeight: 0, fillWidth: true, tw: "px-4 pb-4" },
      h("Column", { tw: "gap-2.5 w-full" }, ...statusBody)
    )
  );
}

function brandHeader() {
  const t = T();
  const site = (settings && settings.config && settings.config.site_name) || "Nezha";
  return h(
    "Row",
    { tw: "items-center gap-2.5 w-full" },
    h("Icon", { svg: BRAND, tw: "size-[22px] text-[#0a94f2] shrink-0" }),
    h(
      "Column",
      { tw: "gap-0 min-w-0" },
      TX("Nezha", { tw: "text-[15px] font-bold leading-tight" }),
      TX(site, { tw: "text-[10.5px] text-textMuted leading-tight truncate" })
    ),
    h("Spacer"),
    h("Button", {
      text: "⟳",
      onClick: launchRefresh,
      disabled: !baseURL,
      tw: "text-[13px]",
    }),
    h("Button", {
      text: t.openNezha,
      onClick: () => {
        if (!baseURL) return;
        try { $metrix.openURL(baseURL); } catch (e) {}
      },
      disabled: !baseURL,
      tw: "text-[11px]",
    })
  );
}

function topTabs() {
  const t = T();
  return h("Segmented", {
    key: "main-tabs",
    items: [
      { label: t.tabServers, value: "servers" },
      { label: t.tabServices, value: "services" },
      { label: t.tabTraffic, value: "traffic" },
      { label: t.tabAlerts, value: "alerts" },
    ],
    value: activeTab,
    onChange: v => {
      activeTab = String(v || "servers");
      selectedServerId = null;
      localStorage.setItem("nezha.tab", activeTab);
      $metrix.invalidate();
    },
  });
}

function statCell(value, label, color, key) {
  return h(
    "Column",
    { key, tw: "gap-0.5 grow basis-0 min-w-0" },
    TX(value, { tw: `text-[20px] font-bold leading-none tabular-nums text-${color || "text"}` }),
    TX(label, { tw: "text-[10px] text-textMuted leading-tight" })
  );
}

function overviewCard() {
  const t = T();
  const scoped = currentScoped(true);
  const s = summarizeScoped(scoped);
  const unfilteredTotal = currentScoped().length;
  const searchActive = servers.size > 6 && serverQuery.trim() && s.total !== unfilteredTotal;
  const probesDown = serviceRows.filter(r => r.failing).length;
  const issues = s.offline + probesDown;
  const onlineRate = s.total > 0 ? (s.online / s.total) * 100 : 0;
  return h(
    "Column",
    { tw: "gap-2.5 p-3 rounded-xl bg-surface w-full" },
    h(
      "Row",
      { tw: "items-end gap-3 w-full" },
      statCell(`${s.online}/${s.total}`, searchActive ? `${t.online} · ${s.total}/${unfilteredTotal}` : t.online, s.offline > 0 ? "warning" : "success", "ov-online"),
      statCell(`↓${formatRate(s.netDown, true)}`, t.downRate || "下行", "text", "ov-down"),
      statCell(`↑${formatRate(s.netUp, true)}`, t.upRate || "上行", "text", "ov-up"),
      statCell(`${s.avgCpu.toFixed(0)}%`, "Avg CPU", "accent", "ov-cpu")
    ),
    h("Row", { tw: "items-center gap-3 w-full" },
      TX(t.transfer || "累计流量", { tw: "text-[10px] text-textMuted shrink-0" }),
      TX(`↓${formatBytes(s.transferDown, 1, true)}`, { tw: "text-[11px] font-semibold tabular-nums" }),
      TX(`↑${formatBytes(s.transferUp, 1, true)}`, { tw: "text-[11px] font-semibold tabular-nums" }),
      h("Spacer")
    ),
    h("Row", { tw: "items-center gap-2 w-full" },
      capsuleBar(onlineRate, s.offline > 0 ? "warning" : "success"),
      issues > 0
        ? TX(`${s.offline} ${t.offline} · ${probesDown} probe`, { tw: "text-[10px] text-danger shrink-0" })
        : TX(`${onlineRate.toFixed(0)}%`, { tw: "text-[10px] text-textMuted shrink-0" })
    )
  );
}

function serversToolbar() {
  const t = T();
  const groupItems = [{ label: t.all, value: "all" }, ...groups.map(g => ({ label: g.name, value: g.id }))];
  const groupValue = resolveGroupSelection(selectedGroup, groups);
  const selectGroup = v => {
    selectedGroup = String(v || "all");
    localStorage.setItem("nezha.group", selectedGroup);
    $metrix.invalidate();
  };
  return h("Column", { tw: "gap-2 w-full" },
    groupItems.length > 1 ? h(groupItems.length > 8 ? "Select" : "Segmented", {
      key: "groups",
      items: groupItems,
      value: groupValue,
      onChange: selectGroup,
    }) : null,
    servers.size > 6 ? h("SearchField", {
      key: "server-search",
      value: serverQuery,
      placeholder: locale === "zh" ? "搜索名称或备注" : "Search name or note",
      onChange: v => { serverQuery = String(v || ""); $metrix.invalidate(); },
    }) : null,
    h("Row", { tw: "gap-2 items-center w-full" },
      h("Segmented", {
        key: "watch",
        items: [{ label: t.all, value: "all" }, { label: `${t.starred}${watchlist.size?` ${watchlist.size}`:""}`, value: "starred" }],
        value: watchMode,
        onChange: v => { watchMode = String(v||"all"); localStorage.setItem("nezha.watchMode", watchMode); $metrix.invalidate(); },
      }),
      h("Spacer"),
      h("Segmented", {
        key: "sort",
        items: [{ label: t.sortCpu, value: "cpu" }, { label: t.sortNet, value: "net" }, { label: t.sortName, value: "name" }],
        value: sortBy,
        onChange: v => { sortBy = String(v||"cpu"); localStorage.setItem("nezha.sort", sortBy); $metrix.invalidate(); },
      })
    )
  );
}

function miniResource(label, pctVal, color, key) {
  return h(
    "Column",
    { key, tw: "gap-1 grow basis-0 min-w-0" },
    h("Row", { tw: "items-center gap-1 w-full" },
      TX(label, { tw: "text-[10px] text-textMuted" }),
      h("Spacer"),
      TX(`${pctVal.toFixed(0)}%`, { tw: "text-[10.5px] font-semibold tabular-nums" })
    ),
    capsuleBar(pctVal, color)
  );
}

function serverCard(s) {
  const t = T();
  const st = s.state || {};
  const host = s.host || {};
  const on = isServerOnline(s);
  const id = String(s.id);
  const starred = watchlist.has(id);
  const memPct = pct(st.mem_used, host.mem_total);
  const diskPct = pct(st.disk_used, host.disk_total);
  const cpuPct = Math.max(0, Math.min(100, Number(st.cpu)||0));
  return h(
    "Column",
    {
      key: `srv-${id}`,
      height: SERVER_LAYOUT.card,
      tw: "gap-1.5 p-2.5 rounded-xl bg-surface border border-border grow basis-0 min-w-0",
      onClick: () => {
        selectedServerId = id;
        void loadMetrics(id);
        $metrix.invalidate();
      },
    },
    h("Row", { tw: "items-center gap-1.5 w-full" },
      TX("●", { tw: `text-[9px] text-${on ? "success" : "danger"}` }),
      TX(s.name || id, { tw: "text-[12px] font-bold truncate" }),
      h("Spacer"),
      h("Button", {
        text: starred ? "★" : "☆",
        tw: `p-0 min-w-0 text-[12px] text-${starred ? "warning" : "textMuted"}`,
        onClick: e => {
          if (e && e.stopPropagation) e.stopPropagation();
          if (starred) watchlist.delete(id); else watchlist.add(id);
          persistWatch();
          $metrix.invalidate();
        },
      })
    ),
    h("Row", { tw: "items-center gap-1.5 w-full" },
      TX(`C ${cpuPct.toFixed(0)}%`, { tw: `text-[10px] tabular-nums font-semibold text-${on ? resourceColor(cpuPct) : "textMuted"}` }),
      TX(`M ${memPct.toFixed(0)}%`, { tw: `text-[10px] tabular-nums font-semibold text-${on ? resourceColor(memPct) : "textMuted"}` }),
      h("Spacer"),
      TX(`D ${diskPct.toFixed(0)}%`, { tw: `text-[10px] tabular-nums font-semibold text-${on ? resourceColor(diskPct) : "textMuted"}` })
    ),
    h("Row", { tw: "gap-1 w-full" },
      capsuleBar(cpuPct, on ? resourceColor(cpuPct) : "border"),
      capsuleBar(memPct, on ? resourceColor(memPct) : "border")
    ),
    h("Row", { tw: "items-center gap-1.5 w-full" },
      TX(`↓${formatRate(st.net_in_speed, true)}`, { tw: "text-[9.5px] tabular-nums text-textMuted" }),
      TX(`↑${formatRate(st.net_out_speed, true)}`, { tw: "text-[9.5px] tabular-nums text-textMuted" }),
      h("Spacer"),
      TX(on ? `${Number(st.load_1 || 0).toFixed(2)}` : `${t.offline} · ${formatRelativeTime(s.last_active, Date.now(), locale)}`, {
        tw: `text-[9.5px] tabular-nums ${on ? "text-textMuted" : "text-danger"}`,
      })
    ),
    h("Row", { tw: "items-center gap-1.5 w-full" },
      TX(`↓${formatBytes(st.net_in_transfer, 1, true)}`, { tw: "text-[9.5px] tabular-nums text-textMuted" }),
      TX(`↑${formatBytes(st.net_out_transfer, 1, true)}`, { tw: "text-[9.5px] tabular-nums text-textMuted" }),
      h("Spacer")
    )
  );
}

function chunk(list, size) {
  const out = [];
  for (let i = 0; i < list.length; i += size) out.push(list.slice(i, i + size));
  return out;
}

function serverGrid(list) {
  return chunk(list, 2).map((row, i) => {
    const cells = row.map(serverCard);
    if (row.length === 1) cells.push(h("Box", { key: `ph-${i}`, tw: "grow basis-0 min-w-0" }));
    return h("Row", { key: `row-${i}`, tw: "gap-2.5 w-full items-start" }, ...cells);
  });
}

function serversPanel() {
  const t = T();
  if (selectedServerId) {
    const s = servers.get(String(selectedServerId));
    if (s) return serverDetail(s);
  }
  const list = sortServers(currentScoped(true));
  const body = list.length
    ? serverGrid(list)
    : [TX(t.emptyServers, { tw: "text-[12px] text-textMuted" })];
  const height = serverPanelHeight(Math.ceil(list.length / 2), {
    searchable: servers.size > 6,
    hasError: Boolean(error && loadedAt),
    degraded: wsDegraded,
  });
  return panelShell(
    [brandHeader(), topTabs(), overviewCard(), serversToolbar()],
    wsDegraded ? [TX(t.wsDegraded, { tw: "text-[11px] text-warning line-clamp-1" }), ...body] : body,
    height,
    0,
    height
  );
}

function metricChart(charts, type, height) {
  return h("Chart", {
    tw: `w-full h-[${height || 150}px]`,
    type: type || "area",
    xKind: "time",
    curve: "monotone",
    grid: true,
    legend: false,
    series: charts,
  });
}

function serverDetail(s) {
  const t = T();
  const st = s.state || {};
  const host = s.host || {};
  const key = `${s.id}:${detailPeriod}`;
  const cache = metricsCache.get(key) || {};
  const series = cache.series || {};
  const cpu = chartFromPoints(series.cpu, "CPU %");
  const memPts = (series.memory || []).map(p => ({ ts: p.ts, value: host.mem_total ? (Number(p.value)/host.mem_total)*100 : Number(p.value) }));
  const mem = chartFromPoints(memPts, "Mem %");
  const netIn = chartFromPoints(series.net_in_speed, "↓ B/s");
  const netOut = chartFromPoints(series.net_out_speed, "↑ B/s");
  const resourceCharts = [cpu, mem].filter(Boolean);
  const networkCharts = [netIn, netOut].filter(Boolean);
  const memPct = pct(st.mem_used, host.mem_total);
  const diskPct = pct(st.disk_used, host.disk_total);
  const monitorRows = cache.monitorRows || [];
  const latencyCharts = monitorRows
    .filter(r => r.points.length)
    .slice(0, 8)
    .map(r => ({ name: r.name, points: r.points.slice(-120).map(p => ({ x: p.ts, y: p.value })) }));
  const days = detailPeriod === "7d" ? 7 : 1;
  const online = cache.online ? buildOnlineSummary(cache.online, days * 86400) : null;
  const monitorCard = r => h(
    "Column",
    { key: `mon-${r.id}`, tw: "gap-0.5 p-2 rounded-lg bg-surface border border-border grow basis-0 min-w-0" },
    h("Row", { tw: "items-center gap-1 w-full" },
      TX(r.name, { tw: "text-[10.5px] truncate" }),
      h("Spacer"),
      TX(r.lossPct > 0 ? `${r.lossPct.toFixed(1)}%` : "", {
        tw: `text-[9.5px] tabular-nums text-${r.lossPct >= 5 ? "danger" : "warning"}`,
      })
    ),
    TX(r.delay != null ? `${r.delay.toFixed(1)} ms` : "—", {
      tw: `text-[12px] font-bold tabular-nums text-${r.delay == null ? "danger" : "text"}`,
    })
  );
  const monitorGrid = chunk(monitorRows, 2).map((row, i) => {
    const cells = row.map(monitorCard);
    if (row.length === 1) cells.push(h("Box", { key: `mon-ph-${i}`, tw: "grow basis-0 min-w-0" }));
    return h("Row", { key: `mon-row-${i}`, tw: "gap-2 w-full items-start" }, ...cells);
  });
  const onlineSection = online
    ? h("Column", { tw: "gap-2.5 p-3 rounded-xl bg-surface w-full" },
        TX(t.onlineSec, { tw: "text-[11px] font-bold" }),
        h("Row", { tw: "items-end gap-3 w-full" },
          statCell(`${online.ratePct.toFixed(1)}%`, t.onlineRate, online.ratePct >= 99 ? "success" : online.ratePct >= 95 ? "warning" : "danger", "on-rate"),
          statCell(formatDuration(online.onlineSeconds), t.totalOnline, "success", "on-up"),
          statCell(formatDuration(online.offlineSeconds), t.totalOffline, online.offlineSeconds > 300 ? "danger" : online.offlineSeconds > 60 ? "warning" : "textMuted", "on-down"),
          statCell(online.lastActive ? formatMonthDayTime(online.lastActive) : "—", t.lastActive, "textMuted", "on-last")
        ),
        online.daily.length
          ? h("Column", { tw: "gap-1.5 w-full" },
              TX(t.dailyOnline, { tw: "text-[10px] text-textMuted" }),
              ...buildDailyOnlineRows(online.daily, Date.now(), { start: online.windowStart, end: online.windowEnd }).slice(-7).map((d, i) => h("Row", { key: `day-${i}`, tw: "items-center gap-2 w-full" },
                TX(d.date.slice(5), { tw: "text-[9.5px] tabular-nums text-textMuted w-[42px]" }),
                capsuleBar(d.pct, d.color),
                TX(`${formatDailyDuration(d.onlineSeconds)}${d.isToday ? " ·" + (t.inProgress || "进行中") : ""}`, {
                  tw: `text-[9.5px] tabular-nums ${d.isToday ? "text-accent" : "text-textMuted"}`,
                })
              ))
            )
          : null
      )
    : null;
  const on = isServerOnline(s);
  const body = [
    h("Column", { tw: "gap-2.5 p-3 rounded-xl bg-surface w-full" },
      h("Row", { tw: "items-end gap-3 w-full" },
        statCell(`${Number(st.cpu || 0).toFixed(0)}%`, "CPU", resourceColor(Number(st.cpu || 0)), "d-cpu"),
        statCell(`${memPct.toFixed(0)}%`, "MEM", resourceColor(memPct), "d-mem"),
        statCell(`${diskPct.toFixed(0)}%`, "DISK", resourceColor(diskPct), "d-disk"),
        statCell(on ? t.online : t.offline, t.onlineSec, on ? "success" : "danger", "d-online")
      ),
      TX(`${host.platform || "?"} ${host.platform_version || ""} · ${host.arch || ""}`, { tw: "text-[10.5px] text-textMuted" }),
      TX(`↓ ${formatRate(st.net_in_speed)} · ↑ ${formatRate(st.net_out_speed)} · load ${Number(st.load_1 || 0).toFixed(2)} / ${Number(st.load_5 || 0).toFixed(2)} / ${Number(st.load_15 || 0).toFixed(2)}`, { tw: "text-[10.5px] tabular-nums text-textMuted" }),
      TX(`${t.transfer}  ↓${formatBytes(st.net_in_transfer, 1, true)}  ↑${formatBytes(st.net_out_transfer, 1, true)}`, {
        tw: "text-[10.5px] tabular-nums text-textMuted",
      })
    ),
    cache.loading ? h("Row", { tw: "items-center gap-2" }, h("Spinner", { tw: "size-[12px]" }), TX(t.loading, { tw: "text-[12px] text-textMuted" })) : null,
    cache.error ? h("Row", { tw: "items-center gap-2" },
      TX(cache.error, { tw: "text-[12px] text-danger grow min-w-0" }),
      h("Button", { text: t.retry, onClick: () => { void loadMetrics(s.id); }, tw: "text-[10px]" })
    ) : null,
    resourceCharts.length ? metricChart(resourceCharts, "area", 150) : null,
    networkCharts.length ? metricChart(networkCharts, "line", 150) : null,
    monitorRows.length
      ? h("Column", { tw: "gap-2 w-full" },
          TX(t.latency, { tw: "text-[11px] font-bold" }),
          latencyCharts.length ? metricChart(latencyCharts, "line", 150) : null,
          ...monitorGrid
        )
      : (!cache.loading && cache.monitorRows ? TX(t.latencyEmpty, { tw: "text-[11px] text-textMuted" }) : null),
    onlineSection,
    !cache.loading && !resourceCharts.length && !networkCharts.length
      ? TX(t.noMetrics, { tw: "text-[12px] text-textMuted" })
      : null,
  ];
  return panelShell(
    [
      brandHeader(),
      h("Row", { tw: "items-center gap-2 w-full" },
        h("Button", { text: `‹ ${t.back}`, onClick: () => { selectedServerId = null; $metrix.invalidate(); }, tw: "text-[12px]" }),
        TX(s.name, { tw: "text-[14px] font-bold truncate" }),
        h("Spacer"),
        h("Segmented", {
          items: [{ label: t.period1d, value: "1d" }, { label: t.period7d, value: "7d" }],
          value: detailPeriod,
          onChange: v => { detailPeriod = String(v||"1d"); localStorage.setItem("nezha.period", detailPeriod); void loadMetrics(s.id); $metrix.invalidate(); },
        })
      ),
    ],
    body,
    150 + 118 + (resourceCharts.length ? 158 : 0) + (networkCharts.length ? 158 : 0) +
      (monitorRows.length ? 60 + (latencyCharts.length ? 158 : 0) + Math.ceil(monitorRows.length / 2) * 56 : 0) +
      (online ? 190 + online.daily.slice(-7).length * 22 : 0) + 40
  );
}

function serviceRow(r) {
  return h(
    "Column",
    {
      key: `svc-${r.id}`,
      tw: `gap-1.5 p-3 rounded-xl bg-surface w-full ${r.failing ? "border border-danger" : selectedServiceId === String(r.id) ? "border border-accent" : ""}`,
    },
    h(
      "Row",
      { tw: "items-center gap-2 w-full" },
      TX("●", { tw: `text-[10px] text-${r.failing ? "danger" : "success"}` }),
      TX(r.name, { tw: "text-[12.5px] font-bold truncate" }),
      h("Badge", { text: r.typeLabel, textColor: K.muted, background: "background" }),
      h("Spacer"),
      TX(r.failing ? "DOWN" : `${r.upPercent.toFixed(1)}%`, {
        tw: `text-[11px] font-semibold tabular-nums text-${r.failing ? K.down : K.up}`,
      })
    ),
    h("Row", { tw: "items-center w-full" },
      TX(r.target || "", { tw: "text-[10.5px] text-textMuted truncate" }),
      h("Spacer"),
      TX(r.delay != null ? `${r.delay.toFixed(1)} ms` : "", { tw: "text-[10.5px] tabular-nums text-textMuted" })
    )
  );
}

function servicesPanel() {
  const t = T();
  const items = [
    { label: t.all, value: "all" },
    { label: "HTTP", value: "HTTP" },
    { label: "Ping", value: "Ping" },
    { label: "TCP", value: "TCP" },
  ];
  const rows = serviceRows.filter(r => serviceFilter === "all" || r.typeLabel === serviceFilter);
  const downCount = serviceRows.filter(r => r.failing).length;
  const summary = h(
    "Column",
    { tw: "gap-2.5 p-3 rounded-xl bg-surface w-full" },
    h("Row", { tw: "items-end gap-3 w-full" },
      statCell(String(serviceRows.length), t.tabServices, "accent", "sv-total"),
      statCell(String(downCount), "DOWN", downCount > 0 ? "danger" : "success", "sv-down")
    )
  );
  const body = rows.length
    ? rows.map(serviceRow)
    : [TX(t.emptyServices, { tw: "text-[12px] text-textMuted" })];
  return panelShell(
    [
      brandHeader(),
      topTabs(),
      summary,
      h("Segmented", {
        items,
        value: serviceFilter,
        onChange: v => { serviceFilter = String(v || "all"); $metrix.invalidate(); },
      }),
    ],
    body,
    292 + rows.length * 68
  );
}

function cycleCard(c) {
  const t = T();
  const color = c.pct >= 95 ? "danger" : c.pct >= 80 ? "warning" : "success";
  return h(
    "Column",
    { key: `cyc-${c.id}`, tw: "gap-1.5 p-2.5 rounded-xl bg-surface border border-border grow basis-0 min-w-0" },
    h("Row", { tw: "items-center gap-1.5 w-full" },
      TX(c.serverName, { tw: "text-[12px] font-bold truncate" }),
      h("Spacer"),
      TX(`${c.pct.toFixed(1)}%`, { tw: `text-[10.5px] font-semibold tabular-nums text-${color}` })
    ),
    h("Row", { tw: "items-center gap-1 w-full" },
      TX(c.cycle, { tw: "text-[9.5px] font-semibold text-accent truncate" })
    ),
    TX(`${formatBytes(c.used, 1, true)} / ${formatBytes(c.max, 1, true)}`, {
      tw: "text-[11px] font-semibold tabular-nums",
    }),
    TX(`${locale === "zh" ? "剩余" : "Remaining"} ${formatBytes(c.remaining, 1, true)}`, {
      tw: "text-[9.5px] tabular-nums text-textMuted",
    }),
    capsuleBar(c.pct, color),
    h("Row", { tw: "items-center gap-1 w-full" },
      TX(`${formatMonthDay(c.from)} - ${formatMonthDay(c.to)}`, { tw: "text-[9px] tabular-nums text-textMuted truncate" }),
      h("Spacer")
    ),
    TX(`${t.nextUpdate} ${formatMonthDayTime(c.nextUpdate)}`, { tw: "text-[9px] tabular-nums text-textMuted truncate" })
  );
}

function trafficPanel() {
  const t = T();
  const warnCount = cycleTransfers.filter(c => c.pct >= 80).length;
  const summary = h(
    "Column",
    { tw: "gap-2.5 p-3 rounded-xl bg-surface w-full" },
    h("Row", { tw: "items-end gap-3 w-full" },
      statCell(String(cycleTransfers.length), t.cycleCount, "accent", "cyc-total"),
      statCell(String(warnCount), t.cycleWarn, warnCount > 0 ? "warning" : "success", "cyc-warn")
    )
  );
  const body = cycleTransfers.length
    ? chunk(cycleTransfers, 2).map((row, i) => {
        const cells = row.map(cycleCard);
        if (row.length === 1) cells.push(h("Box", { key: `cyc-ph-${i}`, tw: "grow basis-0 min-w-0" }));
        return h("Row", { key: `cyc-row-${i}`, tw: "gap-2.5 w-full items-start" }, ...cells);
      })
    : [TX(t.emptyTraffic, { tw: "text-[12px] text-textMuted" })];
  const rowCount = Math.ceil(cycleTransfers.length / 2);
  return panelShell([brandHeader(), topTabs(), summary], body, 232 + rowCount * 136);
}

function attentionRow(it) {
  const critical = it.kind === "offline" || it.severity === "critical";
  const color = critical ? "danger" : "warning";
  return h(
    "Column",
    {
      key: it.id,
      tw: `gap-1 p-3 rounded-xl bg-surface w-full border border-${color} cursor-pointer`,
      onClick: () => {
        if (it.serverId) {
          activeTab = "servers";
          selectedServerId = String(it.serverId);
          selectedServiceId = null;
          localStorage.setItem("nezha.tab", activeTab);
          void loadMetrics(selectedServerId);
        } else if (it.serviceId) {
          activeTab = "services";
          selectedServiceId = String(it.serviceId);
          selectedServerId = null;
          localStorage.setItem("nezha.tab", activeTab);
        }
        $metrix.invalidate();
      },
    },
    h("Row", { tw: "items-center gap-2 w-full" },
      TX(it.kind === "offline" ? "●" : it.kind === "traffic" ? "◆" : "▲", { tw: `text-[10px] text-${color}` }),
      TX(it.title, { tw: "text-[12.5px] font-bold truncate" }),
      h("Spacer"),
      TX(it.kind === "traffic" ? "Traffic" : it.kind === "probe" ? "Probe" : "Offline", { tw: `text-[9px] text-${color}` })
    ),
    TX(it.kind === "offline" ? formatRelativeTime(it.meta, Date.now(), locale) || it.meta : it.meta || it.kind, {
      tw: "text-[10.5px] text-textMuted",
    })
  );
}

function ruleRow(r) {
  return h(
    "Row",
    {
      key: `rule-${r.id}`,
      tw: "p-2.5 rounded-xl bg-surface items-center gap-2 w-full",
    },
    TX(r.name || r.id, { tw: "text-[12px] truncate" }),
    h("Spacer"),
    TX(r.enable ? "on" : "off", { tw: `text-[11px] ${r.enable ? "text-success" : "text-textMuted"}` })
  );
}

function alertsPanelFn() {
  const t = T();
  const scoped = currentScoped();
  const { items, rules } = buildAttention({
    servers: scoped,
    services: serviceRows,
    alertRules,
    cycleTransfers,
    nowMs: Date.now(),
  });
  const summary = h(
    "Column",
    { tw: "gap-2.5 p-3 rounded-xl bg-surface w-full" },
    h("Row", { tw: "items-end gap-3 w-full" },
      statCell(String(items.length), t.tabAlerts, items.length ? "warning" : "success", "al-attn"),
      statCell(String(rules.filter(r => r.enable).length), t.rules, "accent", "al-rules")
    )
  );
  const attention = items.length ? items.map(attentionRow) : [TX(t.emptyAlerts, { tw: "text-[12px] text-textMuted" })];
  const rulesBody = rules.length
    ? [TX(t.rules, { tw: "text-[11px] font-bold text-textMuted" }), ...rules.map(ruleRow)]
    : [];
  return panelShell(
    [brandHeader(), topTabs(), summary],
    [...attention, ...rulesBody],
    236 + items.length * 76 + rules.length * 52
  );
}

function statusCard() {
  const t = T();
  if (!baseURL) {
    return panelShell([brandHeader()],
      [h("Column", { tw: "gap-2 p-4 rounded-xl bg-surface" },
          TX(t.setupTitle, { tw: "text-[15px] font-bold" }),
          TX(t.setupDesc, { tw: "text-[12px] text-textMuted" })
        )], 250, 250);
  }
  if (error && !servers.size) {
    return panelShell([brandHeader()],
      [h("Column", { tw: "gap-3 p-4 rounded-xl bg-surface" },
          TX(forceAuthHint ? t.guestForced : error, { tw: "text-[13px] text-danger" }),
          h("Button", { text: t.retry, onClick: launchRefresh })
        )], 300, 300);
  }
  return null;
}

function panelTree() {
  const blocked = statusCard();
  if (blocked) return blocked;
  if (!loadedAt && inflight) {
    return panelShell([brandHeader()], [TX(T().loading, { tw: "text-[12px] text-textMuted" })], 300, 300);
  }
  if (activeTab === "services") return servicesPanel();
  if (activeTab === "traffic") return trafficPanel();
  if (activeTab === "alerts") return alertsPanelFn();
  return serversPanel();
}


const WTX = (text, props) => h("Text", { text: String(text), ...(props || {}) });
const widgetColor = value => value === "danger" ? "error" : value;

function widgetHeader(title, badge) {
  return h("Row", { gap: 6, alignItems: "center" },
    h("Icon", { svg: BRAND, size: 15, color: "accent" }),
    WTX(title, { fontSize: 13, fontWeight: 600, maxLines: 1 }),
    h("Spacer"),
    badge ? h("Badge", { text: badge, fontSize: 10 }) : null
  );
}

function widgetMessage(title, detail) {
  return h("Column", { gap: 8 },
    widgetHeader(title),
    h("Spacer"),
    WTX(detail, { fontSize: 12, color: "secondary", textAlign: "center", maxLines: 4 }),
    h("Spacer")
  );
}

function widgetStat(value, label, color, size = 20) {
  return h("Column", { gap: 2 },
    WTX(value, { fontSize: size, fontWeight: 700, color: color || "primary", maxLines: 1 }),
    WTX(label, { fontSize: 10, color: "secondary", maxLines: 1 })
  );
}

function widgetProgress(value, color) {
  return h("Progress", { value: Math.max(0, Math.min(100, Number(value) || 0)) / 100, color: widgetColor(color || "accent") });
}

function formatWidgetRate(bytesPerSecond) {
  let value = Math.abs(Number(bytesPerSecond) || 0);
  const units = ["B/s", "K/s", "M/s", "G/s", "T/s"];
  let unit = 0;
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024;
    unit += 1;
  }
  const digits = value >= 10 ? 0 : value >= 1 ? 1 : 2;
  return `${value.toFixed(digits)}${units[unit]}`;
}

function widgetRates(summary) {
  return h("Row", { gap: 12 },
    WTX(`↓${formatWidgetRate(summary.netDown)}`, { fontSize: 11, fontWeight: 600, maxLines: 1 }),
    WTX(`↑${formatWidgetRate(summary.netUp)}`, { fontSize: 11, fontWeight: 600, maxLines: 1 })
  );
}

function widgetTransfer(summary) {
  return WTX(`累计 ↓${formatBytes(summary.transferDown, 1, true)}  ↑${formatBytes(summary.transferUp, 1, true)}`, {
    fontSize: 11, color: "secondary", maxLines: 1,
  });
}

function overviewWidget(family) {
  const summary = summarizeScoped(Array.from(servers.values()));
  const attention = buildAttention({ servers: Array.from(servers.values()), services: serviceRows, alertRules, cycleTransfers }).items;
  const heading = widgetHeader("Nezha", `${summary.online}/${summary.total}`);
  const statusText = WTX(summary.offline ? `${summary.offline} 台离线` : "全部在线", {
    fontSize: 10, color: summary.offline ? "warning" : "secondary", maxLines: 1,
  });
  if (family === "small") {
    const windows = $metrix.platform === "windows";
    return h("Column", { gap: windows ? 6 : 8 }, heading, windows ? null : h("Spacer"),
      widgetStat(`${summary.online}/${summary.total}`, "在线", summary.offline ? "warning" : "success", windows ? 24 : 28),
      widgetRates(summary), statusText,
      windows ? null : h("Spacer")
    );
  }
  const stats = h("Grid", { key: "widget-overview-stats", columns: 2, gap: 10 },
    widgetStat(`${summary.online}/${summary.total}`, "在线", summary.offline ? "warning" : "success"),
    widgetStat(`↓${formatWidgetRate(summary.netDown)}`, "下行"),
    widgetStat(`↑${formatWidgetRate(summary.netUp)}`, "上行"),
    widgetStat(`${summary.avgCpu.toFixed(0)}%`, "Avg CPU", "accent")
  );
  if (family === "medium") return h("Column", { gap: 8 }, heading, stats,
    h("Row", { key: "widget-overview-footer", gap: 8 }, widgetTransfer(summary), h("Spacer"), statusText)
  );
  const topCpu = Array.from(servers.values()).filter(server => isServerOnline(server)).sort((a, b) => Number(b.state?.cpu || 0) - Number(a.state?.cpu || 0)).slice(0, 3);
  return h("Column", { gap: 10 }, heading, stats, widgetTransfer(summary), statusText,
    h("Divider"),
    h("Row", { gap: 8 },
      WTX("CPU 较高", { fontSize: 11, fontWeight: 600, color: "secondary" }),
      h("Spacer"),
      WTX(`${attention.length} 项关注`, { fontSize: 11, color: attention.length ? "warning" : "secondary" })
    ),
    topCpu.length ? topCpu.map(server => h("Row", { key: `widget-cpu-${server.id}`, gap: 8, alignItems: "center" },
      WTX(server.name || server.id, { fontSize: 11, maxLines: 1 }),
      h("Spacer"),
      WTX(`${Number(server.state?.cpu || 0).toFixed(0)}%`, { fontSize: 11, fontWeight: 600, color: widgetColor(resourceColor(server.state?.cpu)) })
    )) : WTX("暂无在线实例", { fontSize: 11, color: "secondary" })
  );
}

function widgetCompactResources(server) {
  const state = server.state || {};
  const host = server.host || {};
  const resources = [
    ["MEM", pct(state.mem_used, host.mem_total)],
    ["DISK", pct(state.disk_used, host.disk_total)],
  ];
  return h("Grid", { key: "widget-server-compact-resources", columns: 2, gap: 8 }, resources.map(([label, value]) =>
    h("Column", { gap: 3 },
      WTX(`${label} ${value.toFixed(0)}%`, { fontSize: 10, fontWeight: 600, color: widgetColor(resourceColor(value)), maxLines: 1 }),
      widgetProgress(value, resourceColor(value))
    )
  ));
}

function widgetDiskRow(server) {
  const value = pct(server.state?.disk_used, server.host?.disk_total);
  return h("Column", { key: "widget-server-disk", gap: 3 },
    WTX(`DISK ${value.toFixed(0)}%`, { fontSize: 10, fontWeight: 600, color: widgetColor(resourceColor(value)), maxLines: 1 }),
    widgetProgress(value, resourceColor(value))
  );
}

function widgetChartSeries(points, color) {
  return { color, points: (points || []).slice(-120).map(point => ({ y: Number(point.value) || 0 })) };
}

function serverWidget(family) {
  const resolved = resolveWidgetServer(servers, widgetServer || selectedServerId || "");
  if (resolved.status !== "ok") {
    const messages = {
      empty: "请在面板中选择一台服务器，或在 widgetServer 中填写 ID / 唯一完整名称。",
      missing: "未找到 widgetServer 对应的服务器，请检查 ID 或名称。",
      ambiguous: "widgetServer 名称不唯一，请改用服务器 ID。",
    };
    return widgetMessage("Nezha · 单服务器", messages[resolved.status]);
  }
  const server = resolved.server;
  const state = server.state || {};
  const online = isServerOnline(server);
  const heading = widgetHeader(server.name || String(server.id), online ? "在线" : "离线");
  const summary = summarizeScoped([server]);
  if (family === "small") {
    return h("Column", { gap: 8 }, heading, h("Spacer"),
      widgetStat(`${Number(state.cpu || 0).toFixed(0)}%`, "CPU", resourceColor(state.cpu), 28),
      widgetRates(summary),
      h("Spacer"), widgetCompactResources(server)
    );
  }
  const cache = metricsCache.get(`${server.id}:${detailPeriod}`) || {};
  const series = cache.series || {};
  const chartCells = [];
  if (family === "large") {
    if (series.cpu && series.cpu.length) {
      chartCells.push(h("Column", { gap: 3 },
        WTX("CPU / 内存", { fontSize: 10, color: "secondary" }),
        h("Chart", { type: "area", height: 64, series: [widgetChartSeries(series.cpu, "accent"), widgetChartSeries(series.memory, "warning")] })
      ));
    }
    if (series.net_in_speed && series.net_in_speed.length) {
      chartCells.push(h("Column", { gap: 3 },
        WTX("网络", { fontSize: 10, color: "secondary" }),
        h("Chart", { type: "area", height: 64, series: [widgetChartSeries(series.net_in_speed, "accent"), widgetChartSeries(series.net_out_speed, "success")] })
      ));
    }
  }
  return h("Column", { gap: 9 }, heading,
    h("Grid", { key: "widget-server-stats", columns: 2, gap: 9 },
      widgetStat(`${Number(state.cpu || 0).toFixed(0)}%`, "CPU", resourceColor(state.cpu)),
      widgetStat(`${pct(state.mem_used, server.host?.mem_total).toFixed(0)}%`, "内存", resourceColor(pct(state.mem_used, server.host?.mem_total))),
      widgetStat(`↓${formatWidgetRate(state.net_in_speed)}`, "下行"),
      widgetStat(`↑${formatWidgetRate(state.net_out_speed)}`, "上行")
    ),
    widgetDiskRow(server),
    h("Row", { gap: 10 },
      widgetTransfer(summary),
      h("Spacer"),
      WTX(`Load ${Number(state.load_1 || 0).toFixed(2)}`, { fontSize: 10, color: "secondary" })
    ),
    chartCells.length
      ? h("Grid", { key: "widget-server-charts", columns: 2, gap: 8 }, ...chartCells)
      : family === "large"
        ? WTX(cache.loading ? "正在加载历史指标…" : "暂无历史指标", { fontSize: 11, color: "secondary", textAlign: "center" })
        : null
  );
}

function trafficWidget(family) {
  const limit = family === "small" ? 1 : family === "medium" ? 2 : 6;
  const items = cycleTransfers.slice(0, limit);
  if (!items.length) return widgetMessage("Nezha · 周期流量", "暂无周期流量规则。");
  return h("Column", { gap: 10 }, widgetHeader("周期流量", `${cycleTransfers.length}`),
    items.map(item => h("Column", { key: `widget-traffic-${item.id}`, gap: 4 },
      h("Row", { gap: 6 },
        WTX(item.serverName, { fontSize: 11, fontWeight: 600, maxLines: 1 }),
        h("Spacer"),
        WTX(`${item.pct.toFixed(0)}%`, { fontSize: 11, fontWeight: 700, color: item.pct >= 95 ? "error" : item.pct >= 80 ? "warning" : "primary" })
      ),
      widgetProgress(item.pct, item.pct >= 95 ? "error" : item.pct >= 80 ? "warning" : "accent"),
      WTX(`${item.cycle} · 剩余 ${formatBytes(item.remaining, 1, true)}`, { fontSize: 10, color: "secondary", maxLines: 1 })
    ))
  );
}

function attentionWidget(family) {
  const limit = family === "small" ? 1 : family === "medium" ? 2 : 6;
  const items = buildAttention({ servers: Array.from(servers.values()), services: serviceRows, alertRules, cycleTransfers }).items;
  if (!items.length) return widgetMessage("Nezha · 关注", "当前没有需要关注的事项。");
  return h("Column", { gap: 10 }, widgetHeader("关注事项", `${items.length}`),
    items.slice(0, limit).map(item => h("Column", { key: `widget-attention-${item.id}`, gap: 3 },
      h("Row", { gap: 6, alignItems: "center" },
        h("Badge", { text: item.kind, fontSize: 9, color: item.severity === "critical" ? "error" : "warning" }),
        WTX(item.title, { fontSize: 11, fontWeight: 600, maxLines: 1 })
      ),
      WTX(item.meta || item.kind, { fontSize: 10, color: "secondary", maxLines: 1 })
    ))
  );
}

function widgetSummary(family) {
  if (!baseURL) return widgetMessage("Nezha", "请先在看板设置中填写 Dashboard URL。");
  if (!loadedAt) return widgetMessage("Nezha", error || "正在加载哪吒数据…");
  if (widgetMode === "server") return serverWidget(family);
  if (widgetMode === "traffic") return trafficWidget(family);
  if (widgetMode === "attention") return attentionWidget(family);
  return overviewWidget(family);
}

function widgetTrees() {
  return { small: widgetSummary("small"), medium: widgetSummary("medium"), large: widgetSummary("large") };
}

function trayTree() {
  const t = T();
  const scoped = currentScoped();
  const summary = summarizeScoped(scoped);
  const title = scoped.length || servers.size ? trayTitle(trayFormat, summary) : (baseURL ? (error ? lastTitle : "…") : "Nezha");
  if (scoped.length || servers.size) lastTitle = title;
  return {
    icon: "data:image/svg+xml," + encodeURIComponent(BRAND),
    iconTemplate: true,
    title,
    tooltip: baseURL ? `${baseURL} · ${summary.online}/${summary.total}` : "Nezha",
    error: error || (forceAuthHint ? t.guestForced : "") || "",
    menu: [
      { label: t.refresh, onClick: launchRefresh, disabled: !baseURL },
      { label: t.openNezha, onClick: () => { if (baseURL) $metrix.openURL(baseURL); }, disabled: !baseURL },
      { separator: true },
      { label: t.clearWatch, onClick: () => { watchlist = new Set(); persistWatch(); $metrix.invalidate(); } },
    ],
  };
}

export default {
  async scheduled(env) {
    syncInputs(env);
    try { $metrix.schedule(refreshSec * 1000); } catch {}
    await detectHostLocale();
    await refreshAll();
  },
  render(env) {
    syncInputs(env);
    return { tray: trayTree(), panel: panelTree(), widget: widgetTrees() };
  },
  event(name, payload) {
    if (name === "lifecycle" && payload && payload.type === "expand" && baseURL && !inflight && Date.now() - loadedAt > 15000) {
      launchRefresh();
    }
  },
};

  ]]></script>
</bar>
