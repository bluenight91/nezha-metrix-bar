<bar protocol-version="0"
     widget="true"
     category="monitoring"
     version="1.3.0"
     icon="data:image/svg+xml;base64,"
     description="Monitor Nezha servers, service probes, and attention items from your menu bar."
     license="AGPL-3.0-only"
     homepage="https://nezha.wiki/"
     id="nezha"
     title="Nezha"
     refresh="5s"
     material="solid">

  <permissions>
    <network origin="{{ inputs.baseURL }}" />
  </permissions>

  <inputs>
    <input name="baseURL" type="string" label="Nezha Dashboard URL" placeholder="https://nezha.example.com" required="true"
           help="Origin of your Nezha Dashboard (e.g. https://mon.example.com).">
      <locale lang="zh-Hans" label="哪吒 Dashboard 地址" help="你的哪吒监控 Dashboard 地址，例如 https://mon.example.com。" />
    </input>
    <input name="apiToken" type="secret" label="API Token (PAT)"
           help="Optional. Personal Access Token (nzp_…). Recommended scopes: nezha:inventory:read, nezha:server:read, nezha:service:read, and optionally nezha:alertrule:read. Required when force_auth is enabled.">
      <locale lang="zh-Hans" label="API Token（PAT）" help="可选。个人访问令牌（nzp_…）。建议权限：nezha:inventory:read、nezha:server:read、nezha:service:read，可选 nezha:alertrule:read。站点启用 force_auth 时必填。" />
    </input>
    <input name="refreshInterval" type="select" label="Refresh Interval" default="5">
      <locale lang="zh-Hans" label="刷新间隔" />
      <option value="2" label="2s"><locale lang="zh-Hans" label="2 秒" /></option>
      <option value="5" label="5s"><locale lang="zh-Hans" label="5 秒" /></option>
      <option value="10" label="10s"><locale lang="zh-Hans" label="10 秒" /></option>
      <option value="30" label="30s"><locale lang="zh-Hans" label="30 秒" /></option>
      <option value="60" label="60s"><locale lang="zh-Hans" label="60 秒" /></option>
    </input>
    <input name="liveUpdates" type="bool" label="Live WebSocket (Guest Mode)" default="true"
           help="Use WebSocket for guest-accessible sites, with a REST reconciliation every 30s. Disable for REST-only polling. PAT mode always uses REST.">
      <locale lang="zh-Hans" label="实时 WebSocket（游客模式）" help="游客可访问的站点使用 WebSocket，并每 30 秒通过 REST 对账。关闭后仅使用 REST 轮询；PAT 模式始终使用 REST。" />
    </input>
    <input name="trayFormat" type="select" label="Tray Display" default="online_total">
      <locale lang="zh-Hans" label="菜单栏显示格式" />
      <option value="online_total" label="8/10 · 1.1M/s" />
      <option value="total" label="1.1M/s" />
      <option value="online_both" label="8/10 · ↑Up ↓Down"><locale lang="zh-Hans" label="8/10 · ↑上行 ↓下行" /></option>
      <option value="online" label="8/10" />
    </input>
    <input name="widgetMode" type="select" label="Desktop Widget" default="overview"
           help="Content shared by every desktop widget from this dashboard instance. Cards cannot be configured independently. Widget-only polling is limited to one-minute intervals.">
      <locale lang="zh-Hans" label="桌面小组件内容" help="选择此看板实例所有桌面卡片显示的内容。同一实例的多张卡片不能分别设置；添加多张 Nezha 卡片会显示相同内容。小组件独立运行时最快每分钟刷新。" />
      <option value="overview" label="Fleet Overview"><locale lang="zh-Hans" label="全部服务器总览" /></option>
      <option value="server" label="Single Server"><locale lang="zh-Hans" label="单台服务器" /></option>
      <option value="traffic" label="Cycle Traffic"><locale lang="zh-Hans" label="周期流量" /></option>
      <option value="attention" label="Attention Items"><locale lang="zh-Hans" label="关注事项" /></option>
    </input>
    <input name="widgetServer" type="string" label="Widget Server ID or Unique Name"
           help="Single Server mode only. Leave empty to follow the server selected in the panel, or enter an ID / case-insensitive unique full name. Ambiguous names require an ID.">
      <locale lang="zh-Hans" label="小组件服务器（ID 或唯一名称）" help="仅单台服务器模式使用。留空时跟随面板当前选中的服务器；也可输入 ID 或不区分大小写的唯一完整名称，重名时必须使用 ID。" />
    </input>
    <input name="offlineNotify" type="bool" label="Offline Alerts" default="true">
      <locale lang="zh-Hans" label="服务器离线通知" />
    </input>
    <input name="probeNotify" type="bool" label="Probe Down Alerts" default="true">
      <locale lang="zh-Hans" label="服务探测失败通知" />
    </input>
    <input name="trafficNotify" type="bool" label="Cycle Traffic Alerts (80% / 95%)" default="true">
      <locale lang="zh-Hans" label="周期流量提醒（80% / 95%）" />
    </input>
  </inputs>

  <docs><![CDATA[哪吒监控 V2 配置说明

1. 在“哪吒 Dashboard 地址”填写你的实例地址（https://nezha.example.com）。
2. 如果站点启用了 force_auth，或需要读取隐藏节点 / 告警规则，请在管理前端“设置 → API Tokens”创建 PAT，权限包含 nezha:inventory:read、nezha:server:read、nezha:service:read，可选 nezha:alertrule:read。
3. 将 nzp_ 开头的令牌填入“API Token（PAT）”。令牌仅保存在系统凭据库中。

游客模式仅在站点允许未登录读取时可用。本看板只读，不执行终端、文件管理或 MCP 写操作。

实时更新：游客站点开启“实时 WebSocket”后，通过 /api/v1/ws/server 接收实时数据，并每 30 秒通过 REST 对账；关闭后仅使用 REST 轮询。PAT 模式始终使用 REST（Worker 的 WebSocket 无法携带 Authorization 头，将 PAT 放入 URL 会造成泄漏）。

桌面小组件（Metrix.Bar 0.2.0+，macOS 14+）：
1. 先在下方“桌面小组件内容”选择全部服务器总览、单台服务器、周期流量或关注事项。同一个 Nezha 看板实例的所有桌面卡片显示相同内容，不能给每张卡片分别选择模式。
2. 选择“单台服务器”时，可以先在服务器面板点击目标服务器，并将“小组件服务器”留空；也可以手动输入服务器 ID 或不区分大小写的唯一完整名称。重名时必须使用 ID。
3. 在 macOS 通知中心底部点击“编辑小组件”，搜索 Metrix.Bar 并选择 Nezha。支持小、中、大三种尺寸；点击卡片可打开或聚焦看板。
4. 修改内容后会立即通知系统重绘。系统决定数据刷新时机，仅小组件保持活跃时最快每分钟更新一次，不保证秒级实时。

English: Connect to a Nezha Monitoring V2 Dashboard.

1. Set Nezha Dashboard URL to your instance origin (https://nezha.example.com).
2. If the site enables force_auth or you need hidden nodes / alert rules, create a PAT in Settings → API Tokens with scopes: nezha:inventory:read, nezha:server:read, nezha:service:read (optional nezha:alertrule:read).
3. Paste the nzp_ token into API Token (PAT). The token is stored only in the system credential store.

Guest mode only works when the Dashboard allows unauthenticated reads. This dashboard is read-only (no terminal / file / MCP actions).

Live updates: when Live WebSocket is enabled on guest-accessible sites, the dashboard streams /api/v1/ws/server and reconciles with REST every 30s. Disable it for REST-only polling. PAT mode always uses REST (Worker WebSockets cannot send an Authorization header, and a token in the URL would leak).

Desktop widgets (Metrix.Bar 0.2.0+, macOS 14+): choose Fleet Overview, Single Server, Cycle Traffic, or Attention Items in Desktop Widget. Every card from this instance shows the same mode; per-card modes are not supported. In Single Server mode, leave Widget Server empty to follow the server selected in the panel, or enter an ID / unique full name. Add Metrix.Bar through the system widget picker and select Nezha; small, medium, and large cards are supported. Input changes invalidate the view immediately. The system controls data refresh timing and limits widget-only polling to one-minute intervals. Clicking a card opens or focuses the Nezha dashboard window.]]></docs>

  <script apis="app localStorage notification shell websocket"><![CDATA[

const h = (type, props, ...children) => ({
  type,
  props: props || {},
  children: children.flat().filter(c => c !== null && c !== undefined && c !== false),
});
const TX = (text, props) => h("Text", props, String(text));
const K = { muted: "textMuted", up: "success", warn: "warning", down: "danger", accent: "accent", line: "border" };
const W = 460;

function normalizeBaseURL(raw) {
  const s = String(raw || "").trim();
  if (!s) return "";
  let u = s.replace(/\/+$/, "");
  if (!/^https?:\/\//i.test(u)) u = "https://" + u;
  try {
    const url = new URL(u);
    if (!url.hostname) return "";
    return url.origin;
  } catch {
    return "";
  }
}

function unwrapNezha(body) {
  if (!body || typeof body !== "object") throw new Error("Invalid response");
  if (body.error || body.success === false) {
    throw new Error(String(body.error || "Request failed"));
  }
  return body.data;
}

function isServerOnline(server, nowMs = Date.now(), windowMs = 30000) {
  if (!server) return false;
  if (typeof server.online === "boolean") return server.online;
  const la = server.last_active;
  if (!la) return false;
  const t = Date.parse(la);
  if (!Number.isFinite(t)) return false;
  return nowMs - t < windowMs;
}

function mergeServerFrame(prevMap, frame) {
  const next = new Map(prevMap);
  const list = Array.isArray(frame?.servers) ? frame.servers : [];
  const onlineArr = Array.isArray(frame?.online) ? new Set(frame.online) : null;
  for (const s of list) {
    if (!s || s.id == null) continue;
    const id = String(s.id);
    const prev = next.get(id) || {};
    const merged = { ...prev, ...s };
    if (s.public_note === undefined && prev.public_note !== undefined) {
      merged.public_note = prev.public_note;
    }
    if (onlineArr) merged.online = onlineArr.has(s.id) || onlineArr.has(Number(s.id)) || onlineArr.has(id);
    next.set(id, merged);
  }
  return next;
}

function mergeServerList(prevMap, list) {
  const next = new Map();
  for (const s of Array.isArray(list) ? list : []) {
    if (!s || s.id == null) continue;
    const id = String(s.id);
    const prev = prevMap.get(id) || {};
    const merged = { ...prev, ...s };
    if (s.public_note === undefined && prev.public_note !== undefined) {
      merged.public_note = prev.public_note;
    }
    if (s.online === undefined) delete merged.online;
    next.set(id, merged);
  }
  return next;
}

function buildGroupIndex(groupPayload) {
  const byServer = new Map();
  const groups = [];
  const arr = Array.isArray(groupPayload) ? groupPayload : [];
  for (const item of arr) {
    const g = item?.group || item;
    if (!g || g.id == null) continue;
    const id = String(g.id);
    const name = g.name || id;
    const servers = Array.isArray(item.servers) ? item.servers.map(String) : [];
    groups.push({ id, name, servers });
    for (const sid of servers) {
      const key = String(sid);
      const memberships = byServer.get(key) || [];
      if (!memberships.some(group => group.id === id)) memberships.push({ id, name });
      byServer.set(key, memberships);
    }
  }
  groups.sort((a, b) => a.name.localeCompare(b.name));
  return { groups, byServer };
}

function resolveGroupSelection(selectedGroup, groups) {
  if (!selectedGroup || selectedGroup === "all") return "all";
  const list = Array.isArray(groups) ? groups : [];
  return list.some(g => String(g.id) === String(selectedGroup)) ? String(selectedGroup) : "all";
}

function scopedServers({
  servers,
  groupId = "all",
  watchMode = "all",
  watchlist = new Set(),
  byServerGroup = new Map(),
}) {
  let list = Array.from(servers.values());
  if (groupId && groupId !== "all") {
    list = list.filter(s => {
      const memberships = byServerGroup.get(String(s.id)) || [];
      return memberships.some(g => String(g.id) === String(groupId));
    });
  }
  if (watchMode === "starred" && watchlist && watchlist.size > 0) {
    list = list.filter(s => watchlist.has(String(s.id)));
  }
  return list;
}

function summarizeScoped(list, nowMs = Date.now()) {
  let online = 0;
  let netDown = 0;
  let netUp = 0;
  let transferDown = 0;
  let transferUp = 0;
  let cpuSum = 0;
  let cpuN = 0;
  for (const s of list) {
    const on = isServerOnline(s, nowMs);
    const st = s.state || {};
    if (on) {
      online += 1;
      netDown += Number(st.net_in_speed) || 0;
      netUp += Number(st.net_out_speed) || 0;
    }
    transferDown += Number(st.net_in_transfer) || 0;
    transferUp += Number(st.net_out_transfer) || 0;
    if (on && Number.isFinite(Number(st.cpu))) {
      cpuSum += Number(st.cpu);
      cpuN += 1;
    }
  }
  return {
    online,
    total: list.length,
    offline: Math.max(0, list.length - online),
    netDown,
    netUp,
    transferDown,
    transferUp,
    avgCpu: cpuN ? cpuSum / cpuN : 0,
  };
}

function formatRate(bytesPerSec, compact = false) {
  const n = Number(bytesPerSec) || 0;
  const abs = Math.abs(n);
  const units = ["B/s", "K/s", "M/s", "G/s", "T/s"];
  let v = abs;
  let i = 0;
  while (v >= 1024 && i < units.length - 1) {
    v /= 1024;
    i += 1;
  }
  const digits = compact ? (v >= 100 ? 0 : v >= 10 ? 1 : 2) : v >= 100 ? 0 : 1;
  return `${v.toFixed(digits)}${units[i]}`;
}

function formatBytes(bytes, digits = 1, compact = false) {
  const n = Number(bytes) || 0;
  const abs = Math.abs(n);
  const units = compact ? ["B", "K", "M", "G", "T"] : ["B", "KB", "MB", "GB", "TB"];
  let v = abs;
  let i = 0;
  while (v >= 1024 && i < units.length - 1) {
    v /= 1024;
    i += 1;
  }
  const d = compact ? (v >= 100 ? 0 : v >= 10 ? 1 : 2) : digits;
  let text = v.toFixed(d);
  if (compact && d > 0) text = text.replace(/\.?0+$/, "");
  return compact ? `${text}${units[i]}` : `${text} ${units[i]}`;
}

function pct(used, total) {
  const t = Number(total) || 0;
  if (t <= 0) return 0;
  return Math.max(0, Math.min(100, ((Number(used) || 0) / t) * 100));
}

function resourceColor(value) {
  const n = Number(value) || 0;
  if (n >= 90) return "danger";
  if (n >= 80) return "warning";
  return "accent";
}

function formatRelativeTime(iso, nowMs = Date.now(), locale = "zh") {
  if (!iso) return "";
  const time = Date.parse(iso);
  if (!Number.isFinite(time)) return "";
  const seconds = Math.max(0, Math.floor((nowMs - time) / 1000));
  const zh = locale === "zh";
  if (seconds < 60) return zh ? "刚刚" : "now";
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return zh ? `${minutes} 分钟前` : `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return zh ? `${hours} 小时前` : `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return zh ? `${days} 天前` : `${days}d ago`;
}

function serviceTypeLabel(type) {
  const t = Number(type);
  if (t === 1) return "HTTP";
  if (t === 2) return "Ping";
  if (t === 3) return "TCP";
  return "Other";
}

function mergeServiceRows(listPayload, overviewPayload) {
  const list = Array.isArray(listPayload) ? listPayload : [];
  const overview =
    overviewPayload && typeof overviewPayload === "object"
      ? overviewPayload.services || overviewPayload
      : {};
  return list
    .map(item => {
      const ov = overview[String(item.id)] || overview[item.id] || {};
      const up = Number(ov.current_up) || 0;
      const down = Number(ov.current_down) || 0;
      const total = up + down;
      const delayArr = Array.isArray(ov.delay) ? ov.delay : [];
      const lastDelay = delayArr.length ? Number(delayArr[delayArr.length - 1]) : NaN;
      const upPercent = total > 0 ? (up / total) * 100 : 100;
      return {
        id: item.id,
        name: item.name || ov.service_name || String(item.id),
        display_index: item.display_index,
        type: item.type,
        typeLabel: serviceTypeLabel(item.type),
        target: item.target || "",
        currentUp: up,
        currentDown: down,
        upPercent,
        delay: Number.isFinite(lastDelay) ? lastDelay : null,
        failing: down > 0 && up === 0,
      };
    })
    .sort((a, b) => Number(a.display_index || 0) - Number(b.display_index || 0) || String(a.name).localeCompare(String(b.name)));
}

function buildAttention({ servers = [], services = [], alertRules = [], cycleTransfers = [], nowMs = Date.now() }) {
  const items = [];
  for (const s of servers) {
    if (!isServerOnline(s, nowMs)) {
      items.push({ kind: "offline", id: `srv-${s.id}`, serverId: String(s.id), title: s.name || String(s.id), meta: s.last_active || "" });
    }
  }
  for (const svc of services) {
    if (svc.failing || (svc.currentDown > 0 && svc.currentUp === 0)) {
      items.push({
        kind: "probe",
        id: `svc-${svc.id}`,
        serviceId: String(svc.id),
        title: svc.name,
        meta: `${svc.typeLabel} · down`,
      });
    }
  }
  for (const c of cycleTransfers) {
    if (c.pct < 80) continue;
    items.push({
      kind: "traffic",
      id: `traffic-${c.id}`,
      serverId: String(c.serverId),
      title: c.serverName,
      meta: `${c.cycle} · ${c.pct.toFixed(1)}% · ${formatBytes(c.remaining, 1, true)} left`,
      severity: c.pct >= 95 ? "critical" : "warning",
    });
  }
  const rules = Array.isArray(alertRules) ? alertRules : [];
  return { items, rules };
}

function detectTrafficThresholds(previousLevels, cycleTransfers) {
  const nextLevels = new Map();
  const crossed = [];
  for (const c of Array.isArray(cycleTransfers) ? cycleTransfers : []) {
    const level = c.pct >= 95 ? 2 : c.pct >= 80 ? 1 : 0;
    const previous = Number(previousLevels.get(c.id)) || 0;
    nextLevels.set(c.id, level);
    if (level > previous) crossed.push({ ...c, level });
  }
  return { nextLevels, crossed };
}

function filterServers(list, query) {
  const q = String(query || "").trim().toLowerCase();
  if (!q) return list;
  return list.filter(s => `${s.name || s.id || ""}\n${s.public_note || ""}`.toLowerCase().includes(q));
}

function resolveWidgetServer(servers, selector) {
  const list = Array.from((servers && typeof servers.values === "function" ? servers.values() : servers) || []);
  const query = String(selector || "").trim();
  if (!query) return { status: "empty" };
  const byId = list.find(server => String(server && server.id) === query);
  if (byId) return { status: "ok", server: byId };
  const normalized = query.toLowerCase();
  const matches = list.filter(server => String(server && server.name || "").toLowerCase() === normalized);
  if (matches.length === 1) return { status: "ok", server: matches[0] };
  return { status: matches.length > 1 ? "ambiguous" : "missing" };
}

function trayTitle(format, summary) {
  const on = `${summary.online}/${summary.total}`;
  const total = formatRate(summary.netDown + summary.netUp, true);
  const down = formatRate(summary.netDown, true);
  const up = formatRate(summary.netUp, true);
  switch (format) {
    case "total":
      return total;
    case "online":
      return on;
    case "online_both":
      return `${on} · ↑${up} ↓${down}`;
    case "online_total":
    default:
      return `${on} · ${total}`;
  }
}

function buildCycleTransfers(payload) {
  const stats = (payload && payload.cycle_transfer_stats) || {};
  const out = [];
  for (const [cycleId, item] of Object.entries(stats)) {
    if (!item || typeof item !== "object") continue;
    const max = Number(item.max) || 0;
    if (max <= 0) continue;
    const names = item.server_name || {};
    const transfer = item.transfer || {};
    const nextUpdate = item.next_update || {};
    for (const serverId of Object.keys(names)) {
      const used = Number(transfer[serverId]) || 0;
      out.push({
        id: `${cycleId}:${serverId}`,
        cycle: String(item.name || cycleId),
        serverId: String(serverId),
        serverName: String(names[serverId] || serverId),
        from: String(item.from || ""),
        to: String(item.to || ""),
        nextUpdate: String(nextUpdate[serverId] || ""),
        max,
        used,
        remaining: Math.max(0, max - used),
        pct: Math.max(0, Math.min(100, (used / max) * 100)),
      });
    }
  }
  out.sort((a, b) => b.pct - a.pct || a.serverName.localeCompare(b.serverName));
  return out;
}

function formatMonthDay(iso) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear()}`;
}

function formatMonthDayTime(iso) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  const pad = n => String(n).padStart(2, "0");
  return `${d.getMonth() + 1}/${d.getDate()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function formatDuration(seconds) {
  const s = Math.max(0, Math.round(Number(seconds) || 0));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  if (h >= 24) {
    const d = Math.floor(h / 24);
    return `${d}d ${h % 24}h`;
  }
  return `${h}h ${m}m`;
}

function buildMonitorRows(monitors) {
  const list = Array.isArray(monitors) ? monitors : [];
  const out = [];
  for (const m of list) {
    if (!m || typeof m !== "object") continue;
    const ts = Array.isArray(m.created_at) ? m.created_at : [];
    const delays = Array.isArray(m.avg_delay) ? m.avg_delay : [];
    const total = delays.length;
    let up = 0;
    let lastDelay = null;
    const points = [];
    for (let i = 0; i < delays.length; i++) {
      const v = delays[i];
      if (v == null || !Number.isFinite(Number(v))) continue;
      up += 1;
      lastDelay = Number(v);
      if (i < ts.length) points.push({ ts: Number(ts[i]), value: Number(v) });
    }
    const down = Math.max(0, total - up);
    out.push({
      id: String(m.monitor_id ?? m.id ?? m.monitor_name ?? ""),
      name: String(m.monitor_name || m.monitor_id || "?"),
      displayIndex: Number(m.display_index) || 0,
      total,
      up,
      down,
      lossPct: total > 0 ? (down / total) * 100 : 0,
      delay: lastDelay,
      points,
    });
  }
  out.sort((a, b) => (a.delay ?? Infinity) - (b.delay ?? Infinity) || a.name.localeCompare(b.name));
  return out;
}

function buildOnlineSummary(online, windowSeconds) {
  const o = online && typeof online === "object" ? online : {};
  const onlineSeconds = Number(o.total_online_seconds) || 0;
  const win = Number(windowSeconds) > 0 ? Number(windowSeconds) : Math.max(1, onlineSeconds);
  const rate = Number(o.online_rate);
  return {
    currentlyOnline: !!o.currently_online,
    lastActive: String(o.last_active || ""),
    windowStart: String(o.window_start || ""),
    windowEnd: String(o.window_end || ""),
    onlineSeconds,
    offlineSeconds: Math.max(0, win - onlineSeconds),
    ratePct: Number.isFinite(rate) ? rate : (onlineSeconds / win) * 100,
    daily: Array.isArray(o.daily)
      ? o.daily.map(d => ({ date: String(d.date || ""), onlineSeconds: Number(d.online_seconds) || 0 }))
      : [],
  };
}

function buildDailyOnlineRows(daily, nowMs = Date.now(), window = null) {
  const list = Array.isArray(daily) ? daily : [];
  const now = new Date(nowMs);
  const pad = n => String(n).padStart(2, "0");
  const todayKey = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  const winStart = window && window.start ? new Date(window.start).getTime() : NaN;
  const winEnd = window && window.end ? new Date(window.end).getTime() : NaN;
  return list.map(d => {
    const onlineSeconds = Math.max(0, Number(d.onlineSeconds ?? d.online_seconds) || 0);
    const parts = String(d.date || "").split("-").map(Number);
    let expected = 86400;
    if (parts.length === 3 && parts.every(Number.isFinite)) {
      const dayStart = new Date(parts[0], parts[1] - 1, parts[2]).getTime();
      const dayEnd = dayStart + 86400 * 1000;
      const from = Number.isFinite(winStart) ? Math.max(dayStart, winStart) : dayStart;
      const to = Math.min(Number.isFinite(winEnd) ? winEnd : dayEnd, dayEnd, nowMs);
      expected = Math.max(1, Math.round((to - from) / 1000));
    }
    const pct = Math.max(0, Math.min(100, (onlineSeconds / expected) * 100));
    const color = pct >= 99 ? "success" : pct >= 95 ? "warning" : "danger";
    return { date: String(d.date || ""), onlineSeconds, expected, pct, color, isToday: d.date === todayKey };
  });
}

function formatDailyDuration(seconds) {
  const s = Math.max(0, Math.round(Number(seconds) || 0));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  return `${h}h ${m}m`;
}

function detectTransitions(prevOnlineIds, nextOnlineIds) {
  const wentOffline = [];
  for (const id of prevOnlineIds) {
    if (!nextOnlineIds.has(id)) wentOffline.push(id);
  }
  return { wentOffline };
}


const svg = paths => `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const BRAND = "<svg xmlns=\"http://www.w3.org/2000/svg\" xml:space=\"preserve\" viewBox=\"0 0 512 512\"><path d=\"M21.1 0v186.2L152.4 268 463.8 78.6 441.7 77V0z\" style=\"opacity:.75;fill-rule:evenodd;clip-rule:evenodd\"/><path d=\"M163.9 370 21.1 279.9v128.3L230.7 512l209.6-103.8V175.8L491 93.3z\" style=\"fill-rule:evenodd;clip-rule:evenodd\"/></svg>";

