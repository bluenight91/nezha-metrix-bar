<bar protocol-version="0"
     min-app-version="0.3.0"
     widget="true"
     notch="true"
     category="monitoring"
     version="2.0.0"
     icon="data:image/svg+xml;base64,"
     description="Monitor Nezha servers, service probes, cycle traffic, and live alerts from your menu bar, notch, and desktop widgets."
     license="AGPL-3.0-only"
     homepage="https://nezha.wiki/"
     id="nezha"
     title="Nezha"
     refresh="5s"
     material="solid"
     window-style="standard">

  <permissions>
    <network origin="{{ inputs.baseURL }}" from-url="true" />
    <inbox access="manage" />
  </permissions>

  <inputs>
    <input name="baseURL" type="string" label="Nezha Dashboard URL" placeholder="https://nezha.example.com" required="true"
           help="URL of your Nezha Dashboard (e.g. https://mon.example.com). Paths or trailing slashes are normalized automatically.">
      <locale lang="zh-Hans" label="哪吒 Dashboard 地址" help="你的哪吒监控 Dashboard 地址，例如 https://mon.example.com。末尾斜杠或子路径会自动规范化。" />
    </input>
    <input name="apiToken" type="secret" label="API Token (PAT)"
           help="Optional. Personal Access Token (nzp_…). Recommended scopes: nezha:inventory:read, nezha:server:read, nezha:service:read, and optionally nezha:alertrule:read. Required when force_auth is enabled.">
      <locale lang="zh-Hans" label="API Token（PAT）" help="可选。个人访问令牌（nzp_…）。建议权限：nezha:inventory:read、nezha:server:read、nezha:service:read，可选 nezha:alertrule:read。站点启用 force_auth 时必填。" />
    </input>
    <input name="refreshInterval" type="select" label="Refresh Interval" default="5">
      <locale lang="zh-Hans" label="刷新间隔" />
      <option value="2" label="2s"><locale lang="zh-Hans" label="2 秒" /></option>
      <option value="5" label="5s"><locale lang="zh-Hans" label="5 秒" /></option>
      <option value="10" label="10s"><locale lang="zh-Hans" label="10 秒" /></option>
      <option value="30" label="30s"><locale lang="zh-Hans" label="30 秒" /></option>
      <option value="60" label="60s"><locale lang="zh-Hans" label="60 秒" /></option>
    </input>
    <input name="liveUpdates" type="bool" label="Live WebSocket (Guest Mode)" default="true"
           help="Use WebSocket for guest-accessible sites, with a REST reconciliation every 30s. Disable for REST-only polling. PAT mode always uses REST.">
      <locale lang="zh-Hans" label="实时 WebSocket（游客模式）" help="游客可访问的站点使用 WebSocket，并每 30 秒通过 REST 对账。关闭后仅使用 REST 轮询；PAT 模式始终使用 REST。" />
    </input>
    <input name="trayFormat" type="select" label="Tray Display" default="online_total">
      <locale lang="zh-Hans" label="菜单栏显示格式" />
      <option value="online_total" label="8/10 · 1.1M/s" />
      <option value="total" label="1.1M/s" />
      <option value="online_both" label="8/10 · ↑Up ↓Down"><locale lang="zh-Hans" label="8/10 · ↑上行 ↓下行" /></option>
      <option value="online" label="8/10" />
      <option value="stacked_rate" label="Stacked ↑↓ Rate (macOS)"><locale lang="zh-Hans" label="双行紧凑速率（macOS）" /></option>
      <option value="rate_spark" label="Rate + Sparkline (macOS)"><locale lang="zh-Hans" label="双行速率 + 迷你流量图（macOS）" /></option>
      <option value="cpu_spark" label="CPU + Sparkline (macOS)"><locale lang="zh-Hans" label="集群 CPU + 迷你趋势图（macOS）" /></option>
    </input>
    <input name="notchMetric" type="select" label="Notch Compact Metric" default="rate"
           help="Metric shown on the right wing of the notch (Metrix.Bar Plus on macOS / Windows).">
      <locale lang="zh-Hans" label="刘海屏紧凑指标" help="刘海屏右侧显示的紧凑数值（需 Metrix.Bar Plus，支持 macOS / Windows）。" />
      <option value="rate" label="Aggregate Rate (340K)"><locale lang="zh-Hans" label="聚合网速（如 340K）" /></option>
      <option value="cpu" label="Average CPU (18%)"><locale lang="zh-Hans" label="平均 CPU（如 18%）" /></option>
      <option value="online" label="Online Count (21/21)"><locale lang="zh-Hans" label="在线数（如 21/21）" /></option>
    </input>
    <input name="notchActivity" type="bool" label="Notch Alert Island" default="true"
           help="Temporarily bring Nezha into the notch island when a server goes offline, a probe fails, cycle traffic crosses a threshold, or an Inbox alert arrives.">
      <locale lang="zh-Hans" label="刘海屏告警动态岛" help="节点离线、探针异常、周期流量超限或收到 Inbox Webhook/邮件告警时，在刘海屏限时高亮提醒。" />
    </input>
    <input name="serverView" type="select" label="Server List Layout" default="auto"
           help="Choose cards, compact sortable table, or automatic (cards in compact flyout, sortable table with side-by-side detail in wide windows / standalone app).">
      <locale lang="zh-Hans" label="服务器列表布局" help="选择卡片网格、紧凑可排序表格或自动切换（弹窗使用卡片，宽窗口或独立 App 自动切为表格 + 右侧详情双栏）。" />
      <option value="auto" label="Auto (Cards / Wide Table)"><locale lang="zh-Hans" label="自动（弹窗卡片 / 宽窗表格）" /></option>
      <option value="cards" label="Cards Grid"><locale lang="zh-Hans" label="精炼卡片网格" /></option>
      <option value="table" label="Sortable Table"><locale lang="zh-Hans" label="紧凑可排序表格" /></option>
    </input>
    <input name="widgetMode" type="select" label="Desktop Widget" default="overview"
           help="Content shown by desktop widgets from this instance. Install multiple Nezha instances in Metrix.Bar 0.3+ if you want different widget modes side by side.">
      <locale lang="zh-Hans" label="桌面小组件内容" help="选择此实例桌面小组件展示的内容。Metrix.Bar 0.3+ 支持安装多个 Nezha 实例，分别绑定不同小组件模式或不同哪吒面板。" />
      <option value="overview" label="Fleet Overview"><locale lang="zh-Hans" label="全部服务器总览" /></option>
      <option value="server" label="Single Server"><locale lang="zh-Hans" label="单台服务器" /></option>
      <option value="traffic" label="Cycle Traffic"><locale lang="zh-Hans" label="周期流量" /></option>
      <option value="attention" label="Attention Items"><locale lang="zh-Hans" label="关注事项" /></option>
    </input>
    <input name="widgetServer" type="string" label="Widget Server ID or Unique Name"
           help="Single Server mode only. Leave empty to follow the server selected in the panel, or enter an ID / case-insensitive unique full name. Ambiguous names require an ID.">
      <locale lang="zh-Hans" label="小组件服务器（ID 或唯一名称）" help="仅在“单台服务器”模式下生效。留空则跟随面板当前选中的服务器，或填写服务器 ID / 不区分大小写的唯一完整名称；重名时请填写 ID。" />
    </input>
    <input name="offlineNotify" type="bool" label="Notify on Server Offline" default="true">
      <locale lang="zh-Hans" label="服务器离线通知" />
    </input>
    <input name="probeNotify" type="bool" label="Notify on Probe Failure" default="true">
      <locale lang="zh-Hans" label="服务探测失败通知" />
    </input>
    <input name="trafficNotify" type="bool" label="Notify on Cycle Traffic Warning" default="true"
           help="Notify when a cycle traffic quota crosses 80% or 95%.">
      <locale lang="zh-Hans" label="周期流量预警通知" help="周期流量使用率首次达到 80% 或 95% 时发送提醒。" />
    </input>
  </inputs>

  <docs><![CDATA[Connects to a Nezha Dashboard v1 instance (guest-accessible or PAT-authenticated).

Quick Setup
1. Set Nezha Dashboard URL to your dashboard address (e.g. https://mon.example.com).
2. If your site enables force_auth or you want Alert Rules, create a read-only Personal Access Token (nzp_…) in Nezha with nezha:inventory:read, nezha:server:read, nezha:service:read (and optionally nezha:alertrule:read), then paste it into API Token (PAT).

What's New in v2.0
- Rich macOS Menu Bar: Choose Stacked ↑↓ Rate, Rate + Sparkline, or CPU + Sparkline in Tray Display.
- Notch & Alert Island (Plus): Compact live telemetry on the notch wings, hover/click expanded overview, and timed alert island pop-ins.
- Native Nezha Webhook / Email Alerts (Plus Inbox): Create a Webhook or Email Inbox in Metrix.Bar, bind it to this Nezha instance, and point Nezha's notification channel at that endpoint to receive full server rule alerts inside the Alerts tab (even alerts fired while your Mac slept).
- Wide Window & Standalone App: Open in a wide window or Standalone App (width >= 860) for a sortable multi-column server table paired with a live side-by-side detail pane.
- Multi-Instance Widgets: Install additional Nezha instances in Metrix.Bar 0.3+ to place multiple widgets with different modes or monitor multiple Nezha clusters simultaneously.]]></docs>

  <script apis="app localStorage notification shell websocket clipboard match-media"><![CDATA[
const h = (type, props, ...children) => ({
  type,
  props: props || {},
  children: children.flat().filter(c => c !== null && c !== undefined && c !== false),
});

const TX = (text, props) => h("Text", { text: String(text), ...(props || {}) });
const K = { up: "[#10b981]", down: "[#ef4444]", warn: "[#f59e0b]", accent: "[#0a94f2]", muted: "textMuted" };
const PAL = {
  brand: "#0a94f2",
  blue: "#3b82f6",
  sky: "#0ea5e9",
  emerald: "#10b981",
  indigo: "#6366f1",
  amber: "#f59e0b",
  red: "#ef4444",
  slate: "#64748b",
};

function isDarkTheme() {
  try {
    return !!(globalThis.matchMedia && globalThis.matchMedia("(prefers-color-scheme: dark)").matches);
  } catch {
    return false;
  }
}

function cardBorder() {
  return isDarkTheme() ? "[#ffffff14]" : "[#00000010]";
}

function Line() {
  return h("Box", { tw: `w-full h-px bg-${cardBorder()} shrink-0` });
}

function barHex(value, normalHex = PAL.blue) {
  const n = Number(value) || 0;
  if (n >= 90) return PAL.red;
  if (n >= 80) return PAL.amber;
  return normalHex;
}

function metricValueTw(value, online = true) {
  if (!online) return "text-textMuted";
  const n = Number(value) || 0;
  if (n >= 90) return "text-[#ef4444]";
  if (n >= 80) return "text-[#f59e0b]";
  return "text-text";
}

function normalizeBaseURL(raw) {
  let u = String(raw || "").trim();
  if (!u) return "";
  if (!/^https?:\/\//i.test(u)) u = "https://" + u;
  try {
    const url = new URL(u);
    if (!url.hostname) return "";
    return url.origin;
  } catch {
    return "";
  }
}

function unwrapNezha(body) {
  if (!body || typeof body !== "object") throw new Error("Invalid response");
  if (body.error || body.success === false) {
    throw new Error(String(body.error || "Request failed"));
  }
  return body.data;
}

function isServerOnline(server, nowMs = Date.now(), windowMs = 30000) {
  if (!server) return false;
  if (typeof server.online === "boolean") return server.online;
  const la = server.last_active;
  if (!la) return false;
  const t = Date.parse(la);
  if (!Number.isFinite(t)) return false;
  return nowMs - t < windowMs;
}

function mergeServerFrame(prevMap, frame) {
  const next = new Map(prevMap);
  const list = Array.isArray(frame?.servers) ? frame.servers : [];
  const onlineArr = Array.isArray(frame?.online) ? new Set(frame.online) : null;
  for (const s of list) {
    if (!s || s.id == null) continue;
    const id = String(s.id);
    const prev = next.get(id) || {};
    const merged = { ...prev, ...s };
    if (s.public_note === undefined && prev.public_note !== undefined) {
      merged.public_note = prev.public_note;
    }
    if (onlineArr) merged.online = onlineArr.has(s.id) || onlineArr.has(Number(s.id)) || onlineArr.has(id);
    next.set(id, merged);
  }
  return next;
}

function mergeServerList(prevMap, list) {
  const next = new Map();
  for (const s of Array.isArray(list) ? list : []) {
    if (!s || s.id == null) continue;
    const id = String(s.id);
    const prev = prevMap.get(id) || {};
    const merged = { ...prev, ...s };
    if (s.public_note === undefined && prev.public_note !== undefined) {
      merged.public_note = prev.public_note;
    }
    if (s.online === undefined) delete merged.online;
    next.set(id, merged);
  }
  return next;
}

function buildGroupIndex(groupPayload) {
  const byServer = new Map();
  const groups = [];
  const arr = Array.isArray(groupPayload) ? groupPayload : [];
  for (const item of arr) {
    const g = item?.group || item;
    if (!g || g.id == null) continue;
    const id = String(g.id);
    const name = g.name || id;
    const servers = Array.isArray(item.servers) ? item.servers.map(String) : [];
    groups.push({ id, name, servers });
    for (const sid of servers) {
      const key = String(sid);
      const memberships = byServer.get(key) || [];
      if (!memberships.some(group => group.id === id)) memberships.push({ id, name });
      byServer.set(key, memberships);
    }
  }
  groups.sort((a, b) => a.name.localeCompare(b.name));
  return { groups, byServer };
}

function resolveGroupSelection(selectedGroup, groups) {
  if (!selectedGroup || selectedGroup === "all") return "all";
  const list = Array.isArray(groups) ? groups : [];
  return list.some(g => String(g.id) === String(selectedGroup)) ? String(selectedGroup) : "all";
}

function scopedServers({
  servers,
  groupId = "all",
  watchMode = "all",
  watchlist = new Set(),
  byServerGroup = new Map(),
}) {
  let list = Array.from(servers.values());
  if (groupId && groupId !== "all") {
    list = list.filter(s => {
      const memberships = byServerGroup.get(String(s.id)) || [];
      return memberships.some(g => String(g.id) === String(groupId));
    });
  }
  if (watchMode === "starred" && watchlist && watchlist.size > 0) {
    list = list.filter(s => watchlist.has(String(s.id)));
  }
  return list;
}

function summarizeScoped(list, nowMs = Date.now()) {
  let online = 0;
  let netDown = 0;
  let netUp = 0;
  let transferDown = 0;
  let transferUp = 0;
  let cpuSum = 0;
  let cpuN = 0;
  for (const s of list) {
    const on = isServerOnline(s, nowMs);
    const st = s.state || {};
    if (on) {
      online += 1;
      netDown += Number(st.net_in_speed) || 0;
      netUp += Number(st.net_out_speed) || 0;
    }
    transferDown += Number(st.net_in_transfer) || 0;
    transferUp += Number(st.net_out_transfer) || 0;
    if (on && Number.isFinite(Number(st.cpu))) {
      cpuSum += Number(st.cpu);
      cpuN += 1;
    }
  }
  return {
    online,
    total: list.length,
    offline: Math.max(0, list.length - online),
    netDown,
    netUp,
    transferDown,
    transferUp,
    avgCpu: cpuN ? cpuSum / cpuN : 0,
  };
}

function formatRate(bytesPerSec, compact = false) {
  const n = Number(bytesPerSec) || 0;
  const abs = Math.abs(n);
  const units = ["B/s", "K/s", "M/s", "G/s", "T/s"];
  let v = abs;
  let i = 0;
  while (v >= 1024 && i < units.length - 1) {
    v /= 1024;
    i += 1;
  }
  const digits = compact ? (v >= 100 ? 0 : v >= 10 ? 1 : 2) : v >= 100 ? 0 : 1;
  return `${v.toFixed(digits)}${units[i]}`;
}

function formatBytes(bytes, digits = 1, compact = false) {
  const n = Number(bytes) || 0;
  const abs = Math.abs(n);
  const units = compact ? ["B", "K", "M", "G", "T"] : ["B", "KB", "MB", "GB", "TB"];
  let v = abs;
  let i = 0;
  while (v >= 1024 && i < units.length - 1) {
    v /= 1024;
    i += 1;
  }
  const d = compact ? (v >= 100 ? 0 : v >= 10 ? 1 : 2) : digits;
  let text = v.toFixed(d);
  if (compact && d > 0) text = text.replace(/\.?0+$/, "");
  return compact ? `${text}${units[i]}` : `${text} ${units[i]}`;
}

function pct(used, total) {
  const t = Number(total) || 0;
  if (t <= 0) return 0;
  return Math.max(0, Math.min(100, ((Number(used) || 0) / t) * 100));
}

function serviceTypeLabel(type) {
  const t = Number(type);
  if (t === 1) return "HTTP";
  if (t === 2) return "Ping";
  if (t === 3) return "TCP";
  return "Other";
}

function mergeServiceRows(listPayload, overviewPayload) {
  const list = Array.isArray(listPayload) ? listPayload : [];
  const overview =
    overviewPayload && typeof overviewPayload === "object"
      ? overviewPayload.services || overviewPayload
      : {};
  return list
    .map(item => {
      const ov = overview[String(item.id)] || overview[item.id] || {};
      const up = Number(ov.current_up) || 0;
      const down = Number(ov.current_down) || 0;
      const total = up + down;
      const delayArr = Array.isArray(ov.delay) ? ov.delay : [];
      const lastDelay = delayArr.length ? Number(delayArr[delayArr.length - 1]) : NaN;
      const upPercent = total > 0 ? (up / total) * 100 : 100;
      return {
        id: item.id,
        name: item.name || ov.service_name || String(item.id),
        display_index: item.display_index,
        type: item.type,
        typeLabel: serviceTypeLabel(item.type),
        target: item.target || "",
        currentUp: up,
        currentDown: down,
        upPercent,
        delay: Number.isFinite(lastDelay) ? lastDelay : null,
        failing: down > 0 && up === 0,
      };
    })
    .sort((a, b) => Number(a.display_index || 0) - Number(b.display_index || 0) || String(a.name).localeCompare(String(b.name)));
}

function buildAttention({ servers = [], services = [], alertRules = [], cycleTransfers = [], nowMs = Date.now() }) {
  const items = [];
  for (const s of servers) {
    if (!isServerOnline(s, nowMs)) {
      items.push({ kind: "offline", id: `srv-${s.id}`, serverId: String(s.id), title: s.name || String(s.id), meta: s.last_active || "" });
    }
  }
  for (const svc of services) {
    if (svc.failing || (svc.currentDown > 0 && svc.currentUp === 0)) {
      items.push({
        kind: "probe",
        id: `svc-${svc.id}`,
        serviceId: String(svc.id),
        title: svc.name,
        meta: `${svc.typeLabel} · down`,
      });
    }
  }
  for (const c of cycleTransfers) {
    if (c.pct < 80) continue;
    items.push({
      kind: "traffic",
      id: `traffic-${c.id}`,
      serverId: String(c.serverId),
      title: c.serverName,
      meta: `${c.cycle} · ${c.pct.toFixed(1)}% · ${formatBytes(c.remaining, 1, true)} left`,
      severity: c.pct >= 95 ? "critical" : "warning",
    });
  }
  const rules = Array.isArray(alertRules) ? alertRules : [];
  return { items, rules };
}

function detectTrafficThresholds(previousLevels, cycleTransfers) {
  const nextLevels = new Map();
  const crossed = [];
  for (const c of Array.isArray(cycleTransfers) ? cycleTransfers : []) {
    const level = c.pct >= 95 ? 2 : c.pct >= 80 ? 1 : 0;
    const previous = Number(previousLevels.get(c.id)) || 0;
    nextLevels.set(c.id, level);
    if (level > previous) crossed.push({ ...c, level });
  }
  return { nextLevels, crossed };
}

function filterServers(list, query) {
  const q = String(query || "").trim().toLowerCase();
  if (!q) return list;
  return list.filter(s => `${s.name || s.id || ""}\n${s.public_note || ""}`.toLowerCase().includes(q));
}

function trayTitle(format, summary) {
  const on = `${summary.online}/${summary.total}`;
  const total = formatRate(summary.netDown + summary.netUp, true);
  const down = formatRate(summary.netDown, true);
  const up = formatRate(summary.netUp, true);
  switch (format) {
    case "total":
      return total;
    case "online":
      return on;
    case "online_both":
    case "stacked_rate":
    case "rate_spark":
      return `${on} · ↑${up} ↓${down}`;
    case "cpu_spark":
      return `${on} · ${Math.round(Number(summary.avgCpu) || 0)}%`;
    case "online_total":
    default:
      return `${on} · ${total}`;
  }
}

function buildCycleTransfers(payload) {
  const stats = (payload && payload.cycle_transfer_stats) || {};
  const out = [];
  for (const [cycleId, item] of Object.entries(stats)) {
    if (!item || typeof item !== "object") continue;
    const max = Number(item.max) || 0;
    if (max <= 0) continue;
    const names = item.server_name || {};
    const transfer = item.transfer || {};
    const nextUpdate = item.next_update || {};
    for (const serverId of Object.keys(names)) {
      const used = Number(transfer[serverId]) || 0;
      out.push({
        id: `${cycleId}:${serverId}`,
        cycle: String(item.name || cycleId),
        serverId: String(serverId),
        serverName: String(names[serverId] || serverId),
        from: String(item.from || ""),
        to: String(item.to || ""),
        nextUpdate: String(nextUpdate[serverId] || ""),
        max,
        used,
        remaining: Math.max(0, max - used),
        pct: Math.max(0, Math.min(100, (used / max) * 100)),
      });
    }
  }
  out.sort((a, b) => b.pct - a.pct || a.serverName.localeCompare(b.serverName));
  return out;
}

function formatMonthDay(iso) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear()}`;
}

function formatMonthDayTime(iso) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  const pad = n => String(n).padStart(2, "0");
  return `${d.getMonth() + 1}/${d.getDate()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function formatClockTime(ts) {
  const d = new Date(ts);
  if (Number.isNaN(d.getTime())) return "";
  const pad = n => String(n).padStart(2, "0");
  return `${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function formatDuration(seconds) {
  const s = Math.max(0, Math.round(Number(seconds) || 0));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  if (h >= 24) {
    const d = Math.floor(h / 24);
    return `${d}d ${h % 24}h`;
  }
  return `${h}h ${m}m`;
}

function buildMonitorRows(monitors) {
  const list = Array.isArray(monitors) ? monitors : [];
  const out = [];
  for (const m of list) {
    if (!m || typeof m !== "object") continue;
    const ts = Array.isArray(m.created_at) ? m.created_at : [];
    const delays = Array.isArray(m.avg_delay) ? m.avg_delay : [];
    const total = delays.length;
    let up = 0;
    let lastDelay = null;
    const points = [];
    for (let i = 0; i < delays.length; i++) {
      const v = delays[i];
      if (v == null || !Number.isFinite(Number(v))) continue;
      up += 1;
      lastDelay = Number(v);
      if (i < ts.length) points.push({ ts: Number(ts[i]), value: Number(v) });
    }
    const down = Math.max(0, total - up);
    out.push({
      id: String(m.monitor_id ?? m.id ?? m.monitor_name ?? ""),
      name: String(m.monitor_name || m.monitor_id || "?"),
      displayIndex: Number(m.display_index) || 0,
      total,
      up,
      down,
      lossPct: total > 0 ? (down / total) * 100 : 0,
      delay: lastDelay,
      points,
    });
  }
  out.sort((a, b) => (a.delay ?? Infinity) - (b.delay ?? Infinity) || a.name.localeCompare(b.name));
  return out;
}

function buildOnlineSummary(online, windowSeconds) {
  const o = online && typeof online === "object" ? online : {};
  const onlineSeconds = Number(o.total_online_seconds) || 0;
  const win = Number(windowSeconds) > 0 ? Number(windowSeconds) : Math.max(1, onlineSeconds);
  const rate = Number(o.online_rate);
  return {
    currentlyOnline: !!o.currently_online,
    lastActive: String(o.last_active || ""),
    windowStart: String(o.window_start || ""),
    windowEnd: String(o.window_end || ""),
    onlineSeconds,
    offlineSeconds: Math.max(0, win - onlineSeconds),
    ratePct: Number.isFinite(rate) ? rate : (onlineSeconds / win) * 100,
    daily: Array.isArray(o.daily)
      ? o.daily.map(d => ({ date: String(d.date || ""), onlineSeconds: Number(d.online_seconds) || 0 }))
      : [],
  };
}

function buildDailyOnlineRows(daily, nowMs = Date.now(), window = null) {
  const list = Array.isArray(daily) ? daily : [];
  const now = new Date(nowMs);
  const pad = n => String(n).padStart(2, "0");
  const todayKey = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  const winStart = window && window.start ? new Date(window.start).getTime() : NaN;
  const winEnd = window && window.end ? new Date(window.end).getTime() : NaN;
  return list.map(d => {
    const onlineSeconds = Math.max(0, Number(d.onlineSeconds ?? d.online_seconds) || 0);
    const parts = String(d.date || "").split("-").map(Number);
    let expected = 86400;
    if (parts.length === 3 && parts.every(Number.isFinite)) {
      const dayStart = new Date(parts[0], parts[1] - 1, parts[2]).getTime();
      const dayEnd = dayStart + 86400 * 1000;
      const from = Number.isFinite(winStart) ? Math.max(dayStart, winStart) : dayStart;
      const to = Math.min(Number.isFinite(winEnd) ? winEnd : dayEnd, dayEnd, nowMs);
      expected = Math.max(1, Math.round((to - from) / 1000));
    }
    const pctVal = Math.max(0, Math.min(100, (onlineSeconds / expected) * 100));
    const color = pctVal >= 99 ? "success" : pctVal >= 95 ? "warning" : "danger";
    return { date: String(d.date || ""), onlineSeconds, expected, pct: pctVal, color, isToday: d.date === todayKey };
  });
}

function formatDailyDuration(seconds) {
  const s = Math.max(0, Math.round(Number(seconds) || 0));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  return `${h}h ${m}m`;
}

function detectTransitions(prevOnlineIds, nextOnlineIds) {
  const wentOffline = [];
  for (const id of prevOnlineIds) {
    if (!nextOnlineIds.has(id)) wentOffline.push(id);
  }
  return { wentOffline };
}

function resourceColor(value) {
  const n = Number(value) || 0;
  if (n >= 90) return "danger";
  if (n >= 80) return "warning";
  return "accent";
}

function formatRelativeTime(iso, nowMs = Date.now(), loc = "zh") {
  if (!iso) return "";
  const time = typeof iso === "number" ? iso : Date.parse(iso);
  if (!Number.isFinite(time)) return "";
  const seconds = Math.max(0, Math.floor((nowMs - time) / 1000));
  const zh = loc === "zh";
  if (seconds < 60) return zh ? "刚刚" : "now";
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return zh ? `${minutes} 分钟前` : `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return zh ? `${hours} 小时前` : `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return zh ? `${days} 天前` : `${days}d ago`;
}

function resolveWidgetServer(serversMap, selector) {
  const list = Array.from((serversMap && typeof serversMap.values === "function" ? serversMap.values() : serversMap) || []);
  const query = String(selector || "").trim();
  if (!query) return { status: "empty" };
  const byId = list.find(server => String(server && server.id) === query);
  if (byId) return { status: "ok", server: byId };
  const normalized = query.toLowerCase();
  const matches = list.filter(server => String(server && server.name || "").toLowerCase() === normalized);
  if (matches.length === 1) return { status: "ok", server: matches[0] };
  return { status: matches.length > 1 ? "ambiguous" : "missing" };
}

function pushFleetSample(history, summary, ts = Date.now(), maxLen = 60) {
  const prev = Array.isArray(history) ? history : [];
  const down = Number.isFinite(Number(summary?.netDown)) ? Math.max(0, Number(summary.netDown)) : 0;
  const up = Number.isFinite(Number(summary?.netUp)) ? Math.max(0, Number(summary.netUp)) : 0;
  const cpu = Number.isFinite(Number(summary?.avgCpu)) ? Math.max(0, Math.min(100, Number(summary.avgCpu))) : 0;
  const sample = {
    ts: Number.isFinite(Number(ts)) ? Number(ts) : Date.now(),
    cpu,
    down,
    up,
    totalRate: down + up,
    online: Number(summary?.online) || 0,
    total: Number(summary?.total) || 0,
  };
  const next = prev.length >= maxLen ? prev.slice(prev.length - maxLen + 1) : prev.slice();
  next.push(sample);
  return next;
}

function buildSparkPoints(history, key, maxPoints = 36) {
  const list = Array.isArray(history) ? history.slice(-maxPoints) : [];
  const out = [];
  for (let i = 0; i < list.length; i += 1) {
    const val = Number(list[i]?.[key]);
    if (!Number.isFinite(val)) continue;
    out.push({ x: i, y: val });
  }
  return out;
}

function formatShortRate(bytesPerSec) {
  const abs = Math.abs(Number(bytesPerSec) || 0);
  const units = ["B", "K", "M", "G", "T"];
  let v = abs;
  let i = 0;
  while (v >= 1024 && i < units.length - 1) {
    v /= 1024;
    i += 1;
  }
  const digits = v >= 10 ? 0 : i === 0 ? 0 : 1;
  return `${v.toFixed(digits)}${units[i]}`;
}

function formatCompactNotchValue(metric, summary) {
  if (!summary || !summary.total) return "—";
  if (metric === "cpu") return `${Math.round(Number(summary.avgCpu) || 0)}%`;
  if (metric === "online") return `${summary.online}/${summary.total}`;
  return formatShortRate((Number(summary.netDown) || 0) + (Number(summary.netUp) || 0));
}

function buildTrayContent({ format, summary, history = [], canIcon = false, brandSvg = "" }) {
  if (!["stacked_rate", "rate_spark", "cpu_spark"].includes(format)) return null;
  const iconNode = canIcon && brandSvg
    ? { type: "Icon", props: { svg: brandSvg, width: 14, height: 14, fontSize: 14 }, children: [] }
    : null;
  if (format === "cpu_spark") {
    const pts = buildSparkPoints(history, "cpu", 32);
    const chart = pts.length > 1
      ? { type: "Chart", props: { type: "area", width: 38, height: 18, strokeWidth: 1.2, series: [{ name: "cpu", points: pts }] }, children: [] }
      : null;
    const label = `${Math.round(Number(summary?.avgCpu) || 0)}%`;
    const width = (iconNode ? 18 : 0) + 34 + (chart ? 42 : 0);
    return {
      type: "Row",
      props: { width: Math.max(16, Math.min(240, width)), height: 22, gap: 4, alignItems: "center" },
      children: [iconNode, { type: "Text", props: { text: label, fontSize: 12, fontWeight: 600 }, children: [] }, chart].filter(Boolean),
    };
  }
  const upText = `↑${formatShortRate(summary?.netUp)}`;
  const downText = `↓${formatShortRate(summary?.netDown)}`;
  const stacked = {
    type: "Column",
    props: { width: 48, height: 22, justify: "space-between", alignItems: "end" },
    children: [
      { type: "Text", props: { text: upText, fontSize: 9.5, fontWeight: 500 }, children: [] },
      { type: "Text", props: { text: downText, fontSize: 9.5, fontWeight: 500 }, children: [] },
    ],
  };
  const pts = format === "rate_spark" ? buildSparkPoints(history, "totalRate", 32) : [];
  const chart = pts.length > 1
    ? { type: "Chart", props: { type: "area", width: 36, height: 18, strokeWidth: 1.2, series: [{ name: "net", points: pts }] }, children: [] }
    : null;
  const width = (iconNode ? 18 : 0) + 50 + (chart ? 40 : 0);
  return {
    type: "Row",
    props: { width: Math.max(16, Math.min(240, width)), height: 22, gap: 4, alignItems: "center" },
    children: [iconNode, stacked, chart].filter(Boolean),
  };
}

function sortServerList(list, sortKey = "cpu", sortDir = "desc", nowMs = Date.now()) {
  const dir = sortDir === "asc" ? 1 : -1;
  const arr = (Array.isArray(list) ? list : []).slice();
  const metric = s => {
    const st = s?.state || {};
    const host = s?.host || {};
    switch (sortKey) {
      case "name": return String(s?.name || s?.id || "");
      case "mem": return pct(st.mem_used, host.mem_total);
      case "disk": return pct(st.disk_used, host.disk_total);
      case "down": return Number(st.net_in_speed) || 0;
      case "up": return Number(st.net_out_speed) || 0;
      case "net": return (Number(st.net_in_speed) || 0) + (Number(st.net_out_speed) || 0);
      case "load": return Number(st.load_1) || 0;
      case "cpu":
      default: return Number(st.cpu) || 0;
    }
  };
  arr.sort((a, b) => {
    const onlineDiff = Number(isServerOnline(b, nowMs)) - Number(isServerOnline(a, nowMs));
    if (onlineDiff !== 0) return onlineDiff;
    if (sortKey === "name") {
      return dir * metric(a).localeCompare(metric(b));
    }
    const diff = metric(a) - metric(b);
    if (diff !== 0) return dir * diff;
    return String(a?.name || a?.id || "").localeCompare(String(b?.name || b?.id || ""));
  });
  return arr;
}

function resolveOutputDemand(raw) {
  if (!raw || typeof raw !== "object") {
    return {
      known: false,
      tray: true,
      panel: true,
      notch: null,
      widgetKnown: false,
      widgetFamilies: ["small", "medium", "large"],
    };
  }
  const w = raw.widget && typeof raw.widget === "object" ? raw.widget : {};
  const widgetKnown = Boolean(w.known);
  const validFamilies = ["small", "medium", "large"];
  const families = widgetKnown && Array.isArray(w.families)
    ? validFamilies.filter(f => w.families.includes(f))
    : validFamilies;
  return {
    known: true,
    tray: raw.tray !== false,
    panel: Boolean(raw.panel),
    notch: typeof raw.notch === "string" ? raw.notch : null,
    widgetKnown,
    widgetFamilies: families,
  };
}

function parseNotificationTarget(tag) {
  const s = String(tag || "");
  if (s.startsWith("nezha-off-")) return { tab: "servers", serverId: s.slice(10) };
  if (s.startsWith("nezha-probe-")) return { tab: "services", serviceId: s.slice(12) };
  if (s.startsWith("nezha-traffic-")) {
    const rest = s.slice(14);
    const serverId = rest.split(":")[0] || "";
    return { tab: serverId ? "servers" : "traffic", serverId: serverId || null };
  }
  if (s.startsWith("nezha-inbox-")) return { tab: "alerts", inboxKey: s.slice(12) };
  return { tab: "alerts" };
}

function inferAlertSeverity(text) {
  const s = String(text || "").toLowerCase();
  if (/(恢复|已恢复|online|recovered|resolved|ok\b)/.test(s)) return "info";
  if (/(离线|宕机|故障|失败|严重|offline|down|critical|error|fatal|unreachable|alert)/.test(s)) return "critical";
  if (/(警告|预警|过高|超限|阈值|warn|high|exceed|limit|80%|90%|95%)/.test(s)) return "warning";
  return "warning";
}

function parseInboxAlert(entry, payload = null) {
  const src = String(entry?.source || "webhook");
  const baseTitle = String(entry?.subject || "").trim();
  const sender = String(entry?.sender || "").trim();
  let title = baseTitle;
  let body = "";
  let serverName = "";

  if (payload && typeof payload === "object" && !Array.isArray(payload)) {
    if (typeof payload.text === "string" && payload.subject !== undefined) {
      title = String(payload.subject || baseTitle || "(No subject)").trim();
      body = payload.text.trim();
    } else {
      title = String(payload.title || payload.rule || payload.event || payload.alert || baseTitle || "Webhook Alert").trim();
      serverName = String(payload.server?.name || payload.server_name || payload.host || payload.node || "").trim();
      body = String(payload.content || payload.message || payload.text || payload.description || payload.detail || "").trim();
      if (!body) {
        const parts = Object.entries(payload)
          .filter(([, v]) => v !== null && v !== undefined && typeof v !== "object")
          .slice(0, 6)
          .map(([k, v]) => `${k}: ${v}`);
        body = parts.join(" · ");
      }
    }
  } else if (typeof payload === "string" && payload.trim()) {
    const raw = payload.trim();
    if (src === "webhook" && raw.startsWith("{")) {
      try {
        const parsed = JSON.parse(raw);
        if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
          return parseInboxAlert(entry, parsed);
        }
      } catch {}
    }
    const lines = raw.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
    if (!title && lines.length) title = lines[0].slice(0, 120);
    body = lines.join("\n");
  }

  if (!title) title = src === "webhook" ? "Webhook Alert" : "(No subject)";
  const combined = `${title}\n${body}`;
  return {
    key: `${entry?.inbox_id || ""}:${entry?.seq ?? 0}`,
    inboxId: String(entry?.inbox_id || ""),
    seq: Number(entry?.seq) || 0,
    source: src,
    receivedAt: Number(entry?.received_at) || 0,
    sender,
    serverName,
    title: title.slice(0, 140),
    body: body.slice(0, 1200),
    severity: inferAlertSeverity(combined),
  };
}

const INBOX_READ_LIMIT = 500;

function trackInboxArrival(storeBoxes, inboxId, latest) {
  const boxes = storeBoxes && typeof storeBoxes === "object" ? storeBoxes : {};
  const list = Array.isArray(latest) ? latest : [];
  const top = list.reduce((max, m) => Math.max(max, Number(m?.seq) || 0), 0);
  const existing = boxes[inboxId];
  if (!existing) {
    boxes[inboxId] = { base: top, top, read: [], unread: [] };
    return [];
  }
  if (!Array.isArray(existing.read)) existing.read = [];
  if (!Array.isArray(existing.unread)) existing.unread = [];
  const arrived = list.filter(m => (Number(m?.seq) || 0) > existing.top);
  if (top > existing.top) existing.top = top;
  return arrived;
}

function isInboxUnread(storeBoxes, inboxId, seq) {
  const e = storeBoxes?.[inboxId];
  if (!e) return false;
  const n = Number(seq) || 0;
  return n > e.base ? !e.read.includes(n) : e.unread.includes(n);
}

function setInboxRead(storeBoxes, inboxId, seq, read) {
  const e = storeBoxes?.[inboxId];
  if (!e) return false;
  const n = Number(seq) || 0;
  if (isInboxUnread(storeBoxes, inboxId, n) === !read) return false;
  const list = n > e.base ? e.read : e.unread;
  if (read === (n > e.base)) list.push(n);
  else {
    const idx = list.indexOf(n);
    if (idx >= 0) list.splice(idx, 1);
  }
  e.read.sort((a, b) => a - b);
  while (e.read.length > INBOX_READ_LIMIT) e.base = Math.max(e.base, e.read.shift());
  e.unread = e.unread.filter(s => s <= e.base).slice(-INBOX_READ_LIMIT);
  return true;
}

const svgIcon = (paths, strokeWidth = 1.9) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${strokeWidth}" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

